{{- if eq .chezmoi.os "darwin" }}
## ---- New .zshrc config ---- ##

# On macOS: use chezmoi to add local config if available
#  if command -v chezmoi >/dev/null 2>&1; then
#    chezmoi add ~/.localrc 2>/dev/null || true
#  fi

  if [[ -a ~/.localrc ]]; then
    source ~/.localrc
  fi

  # all of our zsh files
  typeset -U config_files
  config_files=($ZSH/**/*.zsh)

  # load the path files
  for file in ${(M)config_files:#*/path.zsh}; do
    source $file
  done

  # load everything but the path and completion files
  for file in ${${config_files:#*/path.zsh}:#*/completion.zsh}; do
    source $file
  done

  # initialize autocomplete here, otherwise functions won't be loaded
  autoload -U compinit
  compinit

  # load every completion after autocomplete loads
  for file in ${(M)config_files:#*/completion.zsh}; do
    source $file
  done

  unset config_files

  # Make sure PATH is set correctly for mpm tool
  export PATH="$HOME/.local/share/mise/installs/python/latest/bin/python3:$PATH"

{{- end }}

