{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "pytest*": "allow",
      "python3 -m pytest*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "chezmoi diff*": "allow",
      "chezmoi status*": "allow",
      "chezmoi managed*": "allow",
      "chezmoi verify*": "allow",
      "cat *": "allow",
      "head *": "allow",
      "wc *": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "find *-delete*": "deny",
      "find *-exec*": "deny",
      "find *-execdir*": "deny",
      "mise *": "allow",

      "chezmoi apply*": "ask",
      "chezmoi init*": "ask",
      "chezmoi re-add*": "ask",
      "chezmoi purge*": "ask",
      "git commit*": "ask",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "git clean*": "ask",
      "git rm --cached*": "ask",
      "git rebase*": "ask",
      "git filter-repo*": "ask",
      "git bundle*": "ask",
      "rm *": "ask",
      "rm -rf*": "ask",
      "curl*": "ask",
      "wget*": "ask",
      "ssh*": "ask",
      "brew*": "ask",
      "mise install*": "ask",
      "mise run setup*": "ask",
      "uv publish*": "ask",
      "gh pr*": "ask",
      "gh release*": "ask",

      "uv run python*": "ask",
      "python*": "ask",
      "python3*": "ask",

      "pytest*": "allow",
      "python3 -m pytest*": "allow"
    }
  }
}
