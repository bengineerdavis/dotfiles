{
  // Project-scoped opencode config for sessions run in this repo. Versioned,
  // deploy-ignored (it is repo tooling, not a home-directory file).
  //
  // Deep-merged over the global config (dot_config/opencode/opencode.jsonc);
  // this file's rules win. Last matching rule wins WITHIN a map, so the
  // catch-all "*" sits first and the narrowest rules (denies) sit last.
  //
  // read/edit/glob/grep/list stay allowed and webfetch/websearch stay ask,
  // all inherited from the global config. external_directory stays
  // deny-first/allow-last from the global config. This file sets the bash
  // tier plus the opt-in autonomous agent.
  "$schema": "https://opencode.ai/config.json",

  // Language servers feed diagnostics to the agent. pyrefly is the house
  // typechecker ([tool.pyrefly] in pyproject.toml); ruff adds lint and
  // format diagnostics from the same rules the pre-commit hooks enforce,
  // so the agent sees violations before committing. pyright is explicitly
  // disabled - the pyrefly-only decision, made deterministic. Built-ins
  // stay enabled where their requirements are met (bash auto-installs its
  // server; pyright would need the pyright package, which is absent).
  // Both servers are mise-managed and resolve from PATH at spawn.
  "lsp": {
    "pyrefly": { "command": ["pyrefly", "lsp"], "extensions": [".py", ".pyi"] },
    "ruff": { "command": ["ruff", "server"], "extensions": [".py", ".pyi"] },
    "pyright": { "disabled": true }
  },

  "permission": {
    "bash": {
      "*": "ask",

      // --- read-only inspection and local git: the workhorse allow tier ---
      "git status": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show *": "allow",
      // Branch mutations ask; allow only these unambiguous listing forms.
      "git branch *": "ask",
      "git branch": "allow",
      "git branch --show-current": "allow",
      "git branch --list": "allow",
      "git branch -a": "allow",
      "git branch -r": "allow",
      "git branch -v": "allow",
      "git branch -vv": "allow",
      "git branch -av": "allow",
      "git branch -avv": "allow",
      "git branch -rv": "allow",
      "git branch -rvv": "allow",
      "git rev-parse": "allow",
      "git rev-parse *": "allow",
      "git rev-list *": "allow",
      "git ls-files *": "allow",
      "git fetch *": "allow",
      "git remote *": "allow",
      "git blame *": "allow",
      "git shortlog *": "allow",
      "git describe *": "allow",
      // Creating a worktree is additive; remove/prune/move/lock still ask.
      "git worktree": "ask",
      "git worktree *": "ask",
      "git worktree list": "allow",
      "git worktree list *": "allow",
      "git worktree add *": "allow",
      "git stash list *": "allow",
      "git stash *": "allow",
      "git notes *": "allow",
      "git config --get *": "allow",
      "git add *": "allow",
      "git checkout *": "allow",
      "git switch *": "allow",
      "git restore *": "allow",
      "git mv *": "allow",
      "git cherry-pick *": "allow",
      "git merge *": "allow",
      "git check-ignore *": "allow",

      // chezmoi read/verify; add moves deployed content into git, kept allow
      // per docs/PERMISSIONS.md § allow
      "chezmoi status *": "allow",
      "chezmoi diff *": "allow",
      "chezmoi managed *": "allow",
      "chezmoi ignored *": "allow",
      "chezmoi unmanaged *": "allow",
      "chezmoi source-path *": "allow",
      "chezmoi data *": "allow",
      "chezmoi cat *": "allow",
      "chezmoi add *": "allow",
      "chezmoi verify *": "allow",

      // test + lint + validation toolchain (AGENTS.md § Commands)
      "pytest *": "allow",
      "python3 -m pytest *": "allow",
      "uv run --with pytest *": "allow",
      "uv run *": "allow",
      "bats *": "allow",
      "skillet *": "allow",
      "shellcheck *": "allow",
      "ruff *": "allow",
      "prek *": "allow",
      "pre-commit *": "allow",

      // interpreters — deliberately allowed (docs/PERMISSIONS.md § Interpreters
      // are allowed: they cannot be denied while `uv run --with … pytest` is
      // the test command, and every ask rule is bypassable from one anyway)
      "python3 *": "allow",
      "python *": "allow",

      // read-only model + runtime inspection (AGENTS.md § Verification)
      "ollama ps *": "allow",
      "ollama list *": "allow",
      "ollama show *": "allow",
      "mise ls *": "allow",
      "mise list *": "allow",

      // read-only shell utilities
      "pwd": "allow",
      "pwd *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "diff *": "allow",
      "sed *": "allow",
      "awk *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "tr *": "allow",
      "cut *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "readlink *": "allow",
      "which *": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "date *": "allow",
      "env *": "allow",
      "mkdir *": "allow",
      "touch *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "chmod *": "allow",

      // --- outward-facing or irreversible: ask. The prompt is the point ---
      "git commit *": "ask",
      "git push *": "ask",
      "git rebase *": "ask",
      "git reset --hard *": "ask",
      "git reset *": "ask",
      "git clean *": "ask",
      "git rm --cached *": "ask",
      "git bundle *": "ask",
      // History rewriting asks rather than denies: the approval prompt shows
      // the full command, so the human sees the cwd/context and applies the
      // spec.md ceremony (backup branch + git notes) at the moment of use.
      "git filter-branch *": "ask",
      "git filter-repo *": "ask",
      "rm *": "ask",
      "rm -r *": "ask",
      "rm -rf *": "ask",
      "curl *": "ask",
      "wget *": "ask",
      "ssh *": "ask",
      "brew *": "ask",
      "mise install *": "ask",
      "mise use *": "ask",
      "mise run setup *": "ask",
      "pip install *": "ask",
      "npm install *": "ask",
      "gh *": "ask",
      "ollama pull *": "ask",
      "ollama rm *": "ask",
      "uv publish *": "ask",

      // Read-only PR commands override the broader gh ask rule.
      "gh pr": "allow",
      "gh pr *": "ask",
      "gh pr list": "allow",
      "gh pr list *": "allow",
      "gh pr status": "allow",
      "gh pr status *": "allow",
      "gh pr view": "allow",
      "gh pr view *": "allow",
      "gh pr checks": "allow",
      "gh pr checks *": "allow",
      "gh pr diff": "allow",
      "gh pr diff *": "allow",
      // Other read-only gh subcommands. Anything unlisted stays at `gh *` ask,
      // including `gh auth`, which can print a token.
      "gh issue list": "allow",
      "gh issue list *": "allow",
      "gh issue view *": "allow",
      "gh issue status": "allow",
      "gh issue status *": "allow",
      "gh repo view": "allow",
      "gh repo view *": "allow",
      "gh repo list": "allow",
      "gh repo list *": "allow",
      "gh run list": "allow",
      "gh run list *": "allow",
      "gh run view *": "allow",
      "gh workflow list": "allow",
      "gh workflow list *": "allow",
      "gh workflow view *": "allow",
      "gh release list": "allow",
      "gh release list *": "allow",
      "gh release view": "allow",
      "gh release view *": "allow",
      "gh label list": "allow",
      "gh label list *": "allow",
      "gh search *": "allow",
      "gh status": "allow",
      "gh status *": "allow",
      // gh api sends GET unless given a method, a field or a body — those
      // make it write, so they ask. graphql can mutate, so it asks too.
      "gh api *": "allow",
      "gh api* -X*": "ask",
      "gh api*--method*": "ask",
      "gh api* -f*": "ask",
      "gh api* -F*": "ask",
      "gh api*--field*": "ask",
      "gh api*--raw-field*": "ask",
      "gh api*--input*": "ask",
      "gh api graphql*": "ask",
      // git log can also write a file or invoke an external diff helper.
      "git log *--output*": "ask",
      "git log *--ext-diff*": "ask",
      "git log *--textconv*": "ask",

      // --- deny: never, matching docs/PERMISSIONS.md § deny. chezmoi apply is
      // main-only (AGENTS.md § Applying is main-only) — denied, not asked ---
      "chezmoi apply *": "deny",
      "chezmoi init *": "deny",
      "chezmoi re-add *": "deny",
      "chezmoi purge *": "deny",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git push --force-with-lease *": "deny",
      // The `=` form has no space after the flag, so the rule above misses it.
      "git push --force-with-lease=*": "deny"
    }
  },

  "agent": {
    "autonomous": {
      "description": "Same toolset as build, with frequent-but-reversible operations auto-approved: commit/push (never force), network fetches, package installs, model pulls, webfetch. PR reads are allowed; PR, branch and worktree mutations still ask. Deny tier is unchanged. Select it when you want the agent to work unattended.",
      "mode": "primary",
      "permission": {
        "bash": {
          "*": "ask",

          // read-only inspection and local git (same as top level)
          "git status": "allow",
          "git status *": "allow",
          "git diff *": "allow",
          "git log": "allow",
          "git log *": "allow",
          "git show *": "allow",
          "git branch *": "ask",
          "git branch": "allow",
          "git branch --show-current": "allow",
          "git branch --list": "allow",
          "git branch -a": "allow",
          "git branch -r": "allow",
          "git branch -v": "allow",
          "git branch -vv": "allow",
          "git branch -av": "allow",
          "git branch -avv": "allow",
          "git branch -rv": "allow",
          "git branch -rvv": "allow",
          "git rev-parse": "allow",
          "git rev-parse *": "allow",
          "git rev-list *": "allow",
          "git ls-files *": "allow",
          "git fetch *": "allow",
          "git remote *": "allow",
          "git blame *": "allow",
          "git shortlog *": "allow",
          "git describe *": "allow",
          "git worktree": "ask",
          "git worktree *": "ask",
          "git worktree list": "allow",
          "git worktree list *": "allow",
          "git worktree add *": "allow",
          "git stash list *": "allow",
          "git stash *": "allow",
          "git notes *": "allow",
          "git config --get *": "allow",
          "git add *": "allow",
          "git checkout *": "allow",
          "git switch *": "allow",
          "git restore *": "allow",
          "git mv *": "allow",
          "git cherry-pick *": "allow",
          "git merge *": "allow",
          "git check-ignore *": "allow",

          "chezmoi status *": "allow",
          "chezmoi diff *": "allow",
          "chezmoi managed *": "allow",
          "chezmoi ignored *": "allow",
          "chezmoi unmanaged *": "allow",
          "chezmoi source-path *": "allow",
          "chezmoi data *": "allow",
          "chezmoi cat *": "allow",
          "chezmoi add *": "allow",
          "chezmoi verify *": "allow",

          "pytest *": "allow",
          "python3 -m pytest *": "allow",
          "uv run --with pytest *": "allow",
          "uv run *": "allow",
          "bats *": "allow",
          "skillet *": "allow",
          "shellcheck *": "allow",
          "ruff *": "allow",
          "prek *": "allow",
          "pre-commit *": "allow",

          "python3 *": "allow",
          "python *": "allow",

          "ollama ps *": "allow",
          "ollama list *": "allow",
          "ollama show *": "allow",
          "mise ls *": "allow",
          "mise list *": "allow",

          "pwd": "allow",
          "pwd *": "allow",
          "ls *": "allow",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "wc *": "allow",
          "file *": "allow",
          "stat *": "allow",
          "grep *": "allow",
          "rg *": "allow",
          "diff *": "allow",
          "sed *": "allow",
          "awk *": "allow",
          "sort *": "allow",
          "uniq *": "allow",
          "tr *": "allow",
          "cut *": "allow",
          "basename *": "allow",
          "dirname *": "allow",
          "readlink *": "allow",
          "which *": "allow",
          "echo *": "allow",
          "printf *": "allow",
          "date *": "allow",
          "env *": "allow",
          "mkdir *": "allow",
          "touch *": "allow",
          "cp *": "allow",
          "mv *": "allow",
          "chmod *": "allow",

          // --- widened vs top level: these become allow instead of ask ---
          "git commit *": "allow",
          "git push *": "allow",
          "gh *": "allow",
          "curl *": "allow",
          "wget *": "allow",
          "brew *": "allow",
          "mise install *": "allow",
          "mise use *": "allow",
          "mise run setup *": "allow",
          "pip install *": "allow",
          "npm install *": "allow",
          "ollama pull *": "allow",

          // --- still ask, even here ---
          "git rebase *": "ask",
          "git reset --hard *": "ask",
          "git reset *": "ask",
          "git clean *": "ask",
          "git rm --cached *": "ask",
          "git bundle *": "ask",
          "git filter-branch *": "ask",
          "git filter-repo *": "ask",
          "rm *": "ask",
          "rm -r *": "ask",
          "rm -rf *": "ask",
          "ssh *": "ask",
          "ollama rm *": "ask",
          "uv publish *": "ask",

          // Keep PR mutations at ask even in this agent; reads are free.
          "gh pr": "allow",
          "gh pr *": "ask",
          "gh pr list": "allow",
          "gh pr list *": "allow",
          "gh pr status": "allow",
          "gh pr status *": "allow",
          "gh pr view": "allow",
          "gh pr view *": "allow",
          "gh pr checks": "allow",
          "gh pr checks *": "allow",
          "gh pr diff": "allow",
          "gh pr diff *": "allow",
          "git log *--output*": "ask",
          "git log *--ext-diff*": "ask",
          "git log *--textconv*": "ask",

          // --- deny tier, unchanged ---
          "chezmoi apply *": "deny",
          "chezmoi init *": "deny",
          "chezmoi re-add *": "deny",
          "chezmoi purge *": "deny",
          "git push --force *": "deny",
          "git push -f *": "deny",
          "git push --force-with-lease *": "deny",
          "git push --force-with-lease=*": "deny"
        },
        "webfetch": "allow",
        "websearch": "allow"
      }
    }
  }
}
