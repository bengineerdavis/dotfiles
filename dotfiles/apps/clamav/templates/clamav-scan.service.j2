[Unit]
# {{ ansible_managed }}
# Rendered from apps/clamav/templates/clamav-scan.service.j2 — edits are overwritten.
#
# The Linux counterpart to com.user.clamscan.plist. A oneshot service running the
# same daily_scan.sh; clamav-scan.timer owns when it fires.
Description=Daily ClamAV scan of user files
Documentation=https://docs.clamav.net/

[Service]
Type=oneshot
ExecStart=/bin/bash {{ clamav_scan_script }}

# The script starts clamd, scans, then shuts it down to release ~1.3 GB of
# resident signature data. That teardown is the script's own step 5, so systemd
# must not kill the process group early and leave the daemon orphaned.
TimeoutStartSec=0
KillMode=mixed

# Matches the launchd agent's Background/LowPriorityIO/Nice settings; the scan
# is explicitly not meant to compete with interactive work.
Nice=20
IOSchedulingClass=idle
CPUSchedulingPolicy=batch

# A systemd unit inherits almost nothing. Every binary the script calls is
# referenced absolutely, so this only covers what those in turn shell out to —
# `nc` for the socket handshake in particular.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME={{ ansible_facts['env']['HOME'] }}

# The script keeps its own run.log and scan.log; the journal only catches what
# escapes it, such as a bash failure before logging starts.
StandardOutput=journal
StandardError=journal
