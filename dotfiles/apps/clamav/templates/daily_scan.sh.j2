#!/bin/bash
# {{ ansible_managed }}
# Rendered from apps/clamav/templates/daily_scan.sh.j2 — edits here are overwritten.
#
# Daily ClamAV maintenance, run by the {{ clamav_agent_label }} launchd agent:
#   1. start clamd if it is not already up
#   2. refresh official (Cisco Talos) signatures
#   3. refresh third-party feeds via fangfrisch
#   4. scan the paths in clamav_scan_paths at the lowest priority
#   5. stop clamd, handing back the ~1.3 GB of resident signature data
#
# Two bugs in the hand-rolled predecessor are fixed here, both of which failed silently:
#
#   * The socket. clamd.conf declares {{ clamav_socket }}, but the old script waited on
#     and shut down via /tmp/clamd.socket, which never exists. Every run burned the full
#     30-second wait, and the shutdown never fired — clamd stayed resident for 18 days
#     holding 1.3 GB. Both files now render the path from one Ansible variable.
#
#   * fangfrisch resolution. launchd gives a job a minimal PATH and no shell profile, so
#     a bare `fangfrisch` was never found and third-party feeds silently stopped updating
#     while official ones kept working. Every binary below is absolute.
#
# Nothing is written to /dev/null: failures land in run.log so they are visible.

set -uo pipefail

SOCKET="{{ clamav_socket }}"
SCAN_LOG="{{ clamav_scan_log }}"
RUN_LOG="{{ clamav_run_log }}"
CLAMD="{{ clamav_brew_prefix }}/sbin/clamd"
CLAMDSCAN="{{ clamav_brew_prefix }}/bin/clamdscan"
FRESHCLAM="{{ clamav_brew_prefix }}/bin/freshclam"

# Passed explicitly to every binary rather than relying on the compiled-in default
# location. Same class of bug as the socket mismatch above: an implicit lookup is
# fine until something else writes a config to that path.
CLAMD_CONF="{{ clamav_clamd_conf_path }}"
FRESHCLAM_CONF="{{ clamav_freshclam_conf_path }}"
FANGFRISCH="{{ clamav_fangfrisch_bin }}"
FANGFRISCH_CONF="{{ clamav_fangfrisch_conf }}"
MAX_LOG_BYTES={{ clamav_log_max_bytes }}

# Scan targets come from clamav_scan_paths, chosen by where untrusted files land and
# where code can execute rather than by size. Scanning all of $HOME took over 8 hours
# and spent 99.9% of that on machine-generated trees. See defaults/main.yaml.
#
# Note for editors: never use a bash array-length expansion (dollar, brace, hash) in this
# template. That character pair opens a Jinja comment, and rendering dies with "Missing
# end of comment tag" — including if you write it inside a comment like this one.
# The explicit counter below sidesteps it.
SCAN_PATHS=()
scan_path_count=0
{% for path in clamav_scan_paths %}
if [ -e "{{ path }}" ]; then
	SCAN_PATHS+=("{{ path }}")
	scan_path_count=$((scan_path_count + 1))
fi
{% endfor %}

log() {
	printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*" >>"$RUN_LOG"
}

# Keep run.log and scan.log bounded. The unmanaged setup let scan.log reach 5.4 MB.
#
# `wc -c` rather than `stat`, on purpose. This machine has GNU coreutils ahead of the BSD
# tools interactively, where `stat -f %z` means "filesystem status" and returns junk, while
# under launchd the same script gets BSD /usr/bin/stat where it means "format". A script
# that rotates logs only when run one way is worse than one that never rotates them, so
# use the form that behaves identically everywhere.
for f in "$SCAN_LOG" "$RUN_LOG"; do
	if [ -f "$f" ] && [ "$(wc -c <"$f" 2>/dev/null || echo 0)" -gt "$MAX_LOG_BYTES" ]; then
		mv -f "$f" "$f.1"
	fi
done

log "=== maintenance run starting ==="

# ── 1. clamd ──────────────────────────────────────────────────────────────────
# Liveness is decided by asking the daemon, not by `pgrep`. A clamd that is shutting down
# still matches pgrep for a moment while its socket is already gone, and treating that as
# "already running" meant the script never started its own daemon and then aborted after
# waiting the full 30 seconds — doing no scan at all. Reproduced by running twice in quick
# succession, which is exactly what a manual run next to the scheduled one looks like.
clamd_responds() {
	[ -S "$SOCKET" ] || return 1
	[ "$(printf 'PING\n' | nc -U "$SOCKET" 2>/dev/null | tr -d '\r\n')" = "PONG" ]
}

we_started_clamd=0
if clamd_responds; then
	log "clamd already running and answering on its socket"
else
	# A process may exist but be mid-shutdown or wedged. Let it finish rather than racing it.
	if pgrep -x clamd >/dev/null 2>&1; then
		log "a clamd process exists but is not answering; waiting for it to exit"
		waited=0
		while pgrep -x clamd >/dev/null 2>&1 && [ "$waited" -lt 15 ]; do
			sleep 1
			waited=$((waited + 1))
		done
	fi
	log "starting clamd"
	if ! "$CLAMD" --config-file="$CLAMD_CONF" --foreground=no; then
		log "ERROR: clamd failed to start; aborting"
		exit 1
	fi
	we_started_clamd=1
fi

# Wait until it actually answers, not merely until a socket file exists — a stale socket
# from a crashed daemon would otherwise look like success.
counter=0
while ! clamd_responds && [ "$counter" -lt 30 ]; do
	sleep 1
	counter=$((counter + 1))
done
if ! clamd_responds; then
	log "ERROR: clamd not answering on $SOCKET after ${counter}s; aborting"
	exit 1
fi
log "clamd ready after ${counter}s"

# ── 2. official signatures ────────────────────────────────────────────────────
if "$FRESHCLAM" --config-file="$FRESHCLAM_CONF" --quiet >>"$RUN_LOG" 2>&1; then
	log "official signatures refreshed"
else
	log "WARNING: freshclam exited $? — official signatures may be stale"
fi

# ── 3. third-party signatures ─────────────────────────────────────────────────
if [ -x "$FANGFRISCH" ]; then
	if "$FANGFRISCH" --conf "$FANGFRISCH_CONF" refresh >>"$RUN_LOG" 2>&1; then
		log "third-party signatures refreshed"
	else
		log "WARNING: fangfrisch exited $? — third-party feeds may be stale"
	fi
else
	log "ERROR: fangfrisch not executable at $FANGFRISCH; third-party feeds NOT refreshed"
fi

# ── 4. scan ───────────────────────────────────────────────────────────────────
if [ "$scan_path_count" -eq 0 ]; then
	log "ERROR: none of the configured scan paths exist; nothing to scan"
	printf 'SHUTDOWN\n' | nc -U "$SOCKET" >/dev/null 2>&1
	exit 1
fi
log "scanning $scan_path_count path(s)"

# No --fdpass. clamd runs as this same user, so it can open the files itself; passing
# descriptors would only force clamdscan to walk the tree and hand over every file
# individually, instead of sending one path and letting clamd walk it. On a tree the
# size of $HOME that is a large amount of extra IPC for no access benefit.
# Scan into a per-run log, not straight into scan.log. scan.log is cumulative, and mixing
# runs in one file makes it impossible to tell which findings belong to which scan — a
# killed run leaves FOUND lines with no summary, so its findings look like the next run's.
# The per-run file is what gets diffed; it is appended to scan.log afterwards for history.
# Explicit XXXXXX template: GNU mktemp (ahead of BSD on this machine's interactive PATH)
# rejects `-t prefix` with "too few X's in template", while BSD mktemp accepts it. This
# form works with both.
RUN_SCAN_LOG=$(mktemp "${TMPDIR:-/tmp}/clamav-run-scan.XXXXXX")
trap 'rm -f "$RUN_SCAN_LOG"' EXIT

{% if clamav_multiscan %}
# --multiscan is enabled. It was measured to exhaust memory and crash clamd on this
# machine; see the note in defaults/main.yaml before leaving it on.
nice -n 20 "$CLAMDSCAN" --config-file="$CLAMD_CONF" --infected --multiscan "${SCAN_PATHS[@]}" --log="$RUN_SCAN_LOG"
{% else %}
nice -n 20 "$CLAMDSCAN" --config-file="$CLAMD_CONF" --infected "${SCAN_PATHS[@]}" --log="$RUN_SCAN_LOG"
{% endif %}
scan_rc=$?
cat "$RUN_SCAN_LOG" >>"$SCAN_LOG"

# ── 4b. baseline diff ─────────────────────────────────────────────────────────
# A scan that reports the same adjudicated false positives every day trains you to ignore
# it. Compare against reviewed-and-accepted findings so a non-zero exit means "something
# NEW appeared" — which is actionable — while keeping every file in scope.
#
# Matching is sha256 + signature. If an accepted file's contents change, the hash changes
# and it alerts again, so acceptance cannot be inherited by modified content.
BASELINE="{{ clamav_baseline }}"
NEW_FINDINGS="{{ clamav_new_findings }}"
: >"$NEW_FINDINGS"
known_count=0
new_count=0
unreadable_count=0

while IFS= read -r found_line; do
	# clamdscan writes "<path>: <SIGNATURE> FOUND". Signatures never contain spaces, so
	# taking the last ": " keeps paths that contain colons intact.
	rest="${found_line% FOUND}"
	signature="${rest##*: }"
	found_path="${rest%": $signature"}"

	file_hash=$(shasum -a 256 "$found_path" 2>/dev/null | awk '{print $1}')
	if [ -z "$file_hash" ]; then
		# Cannot hash it, so cannot prove it is the accepted file. Treat as new: failing
		# toward alerting is the safe direction.
		unreadable_count=$((unreadable_count + 1))
		new_count=$((new_count + 1))
		printf 'UNREADABLE\t%s\t%s\n' "$signature" "$found_path" >>"$NEW_FINDINGS"
		continue
	fi

	if grep -qF "$(printf '%s\t%s' "$file_hash" "$signature")" "$BASELINE" 2>/dev/null; then
		known_count=$((known_count + 1))
	else
		new_count=$((new_count + 1))
		printf '%s\t%s\t%s\n' "$file_hash" "$signature" "$found_path" >>"$NEW_FINDINGS"
	fi
done < <(grep 'FOUND$' "$RUN_SCAN_LOG" 2>/dev/null || true)

baseline_size=$(grep -cvE '^[[:space:]]*(#|$)' "$BASELINE" 2>/dev/null || true)
log "findings: $new_count new, $known_count previously accepted (baseline holds $baseline_size)"
if [ "$unreadable_count" -gt 0 ]; then
	log "WARNING: $unreadable_count flagged file(s) could not be hashed; counted as new"
fi

case "$scan_rc" in
0) log "scan clean" ;;
1)
	if [ "$new_count" -gt 0 ]; then
		log "ALERT: $new_count NEW finding(s) — review $NEW_FINDINGS"
	else
		log "all findings already accepted; nothing new"
	fi
	;;
*) log "WARNING: clamdscan exited $scan_rc" ;;
esac

# Only surface a failure for findings nobody has adjudicated. A clamdscan error (rc >= 2)
# still fails, because that means the scan itself did not do its job.
if [ "$scan_rc" -eq 1 ] && [ "$new_count" -eq 0 ]; then
	scan_rc=0
fi

# ── 5. hand the memory back ───────────────────────────────────────────────────
# Unconditional by design: ephemeral clamd is the point of this schedule. If a daemon
# was already up when we arrived, it was almost certainly left behind by an earlier run.
if printf 'SHUTDOWN\n' | nc -U "$SOCKET" >/dev/null 2>&1; then
	log "clamd shut down (started by this run: $we_started_clamd); resident memory released"
else
	log "WARNING: graceful shutdown via $SOCKET failed; clamd left running"
fi

log "=== maintenance run finished (scan rc=$scan_rc) ==="
exit "$scan_rc"
