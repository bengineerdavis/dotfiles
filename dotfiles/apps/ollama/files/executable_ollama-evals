#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["pyyaml", "pillow"]
# ///
"""ollama-evals — run the eval cases in ../evals/cases against candidate models.

The other half of `ollama-bench`. That tool measures SPEED and deliberately
refuses to score quality ("rating output is the part a benchmark cannot do for
you"). This one scores the part that *can* be judged mechanically: does the
model obey a stated output shape, and does it stay inside the context it was
given. Every case's `check` is a plain python expression over `response`, so a
verdict here is a fact about the output, not an opinion about it.

It runs LOCAL ollama tags and REMOTE `openrouter/…` tags through one interface,
because the question the cases exist to answer — "is this model fit for this
role?" — is the same question for both, and the manifest prices nine remote
models it has never evaluated (`ollama_remote_cost`, "Unevaluated on quality").

  ollama-evals run qwen3.8:27b-mlx                      all cases, one model
  ollama-evals run a b --role chat                      just the chat row
  ollama-evals run a --property faithfulness            just that column
  ollama-evals run openrouter/z-ai/glm-5.2              remote candidate
  ollama-evals run a b --sweep                          climb difficulty levels;
                                                        report where each breaks
  ollama-evals run a --repeat 5                         n samples per case
  ollama-evals cases                                    list what exists
  ollama-evals show [--diff a.json b.json]              last run, or two runs

Like `ollama-bench`, this NEVER edits the manifest. It produces evidence;
promoting a model to a role stays a human call — see apps/ollama/README.md.

Remote calls cost money and are never made unless you name an `openrouter/…`
model explicitly. The key is read from `llm keys get openrouter` (the same
source ollama-usage uses), or $OPENROUTER_API_KEY.

Cases live at $OLLAMA_EVALS_CASES, else --cases, else ../evals/cases relative
to this script.
"""
from __future__ import annotations

import argparse
import base64
import copy
import io
import json
import os
import random
import subprocess
import sys
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

import yaml
from PIL import Image, ImageDraw, ImageFont

API = os.environ.get("OLLAMA_HOST", "http://localhost:11434").rstrip("/")
if not API.startswith("http"):
    API = f"http://{API}"

OR_URL = "https://openrouter.ai/api/v1/chat/completions"
REMOTE_PREFIX = "openrouter/"


def default_cases() -> Path:
    return Path(__file__).resolve().parent.parent / "evals" / "cases"


def results_dir() -> Path:
    base = os.environ.get("XDG_DATA_HOME")
    root = Path(base) if base else Path.home() / ".local" / "share"
    return root / "ollama-evals"


# ── cases ────────────────────────────────────────────────────────────────────
# A case is data, not code, with one exception: `check` is python source, exec'd
# with `response` in scope. These files are repo-local and hand-written, so that
# is a readability choice rather than a trust boundary — do not point --cases at
# anything you did not write.
def load_cases(d: Path) -> list[dict]:
    if not d.is_dir():
        sys.exit(f"error: cases directory not found: {d}")
    out = []
    for f in sorted(d.glob("*.yaml")):
        c = yaml.safe_load(f.read_text()) or {}
        missing = [k for k in ("role", "property", "prompt", "check") if not c.get(k)]
        if missing:
            sys.exit(f"error: {f.name} is missing: {', '.join(missing)}")
        c["name"] = f.stem
        c["file"] = str(f)
        out.append(c)
    if not out:
        sys.exit(f"error: no *.yaml cases in {d}")
    return out


def select(cases: list[dict], role: str | None, prop: str | None,
           names: list[str] | None) -> list[dict]:
    sel = cases
    if role:
        sel = [c for c in sel if c["role"] == role]
    if prop:
        sel = [c for c in sel if c["property"] == prop]
    if names:
        want = {n.removesuffix(".yaml") for n in names}
        sel = [c for c in sel if c["name"] in want]
    if not sel:
        sys.exit("no cases match that selection — try `ollama-evals cases`")
    return sel


# ── difficulty sweeps ────────────────────────────────────────────────────────
# A pass/fail case answers "does this model clear the floor". Every local model
# cleared every floor (2026-08-30, 8 models), so the floors stopped being a
# comparison instrument. A sweep restores one: run the case at rising difficulty
# and report WHERE each model breaks. A break-point orders models that a floor
# ties.
#
# Two forms:
#   sweep: {param: "filler.words", values: [...], labels: [...]}   vary one path
#   sweep: {levels: [{label: .., <case overrides>}, ...]}          vary anything
# `levels` is needed whenever difficulty changes more than one thing at once —
# a bigger haystack also needs a bigger num_ctx, or it measures truncation.
#
# `ordered: true` (default) means difficulty rises monotonically, so climbing
# stops at the first failure. Set it false for sweeps that are NOT monotonic —
# needle position is the standing example, since middle positions are harder
# than late ones ("lost in the middle"), and early-exit would misreport those.
def deep_merge(base: dict, over: dict) -> dict:
    out = dict(base)
    for k, v in over.items():
        out[k] = deep_merge(out[k], v) if (isinstance(v, dict)
                                           and isinstance(out.get(k), dict)) else v
    return out


def set_path(d: dict, path: str, value) -> None:
    parts = path.split(".")
    for p in parts[:-1]:
        d = d.setdefault(p, {})
    d[parts[-1]] = value


def expand_sweep(c: dict, enabled: bool) -> list[dict]:
    """Case -> one variant per difficulty level (each carrying a `label`).

    With sweeps off, or on a case that declares none, this is the base case
    alone — so a plain run costs exactly what it did before."""
    s = c.get("sweep")
    if not s or not enabled:
        base = {k: v for k, v in c.items() if k != "sweep"}
        return [dict(base, label=None)]
    out = []
    if s.get("levels"):
        for i, lv in enumerate(s["levels"]):
            lv = dict(lv)
            label = str(lv.pop("label", i))
            v = deep_merge({k: x for k, x in c.items() if k != "sweep"}, lv)
            out.append(dict(v, label=label))
    else:
        values = s["values"]
        labels = s.get("labels") or [str(v) for v in values]
        varsets = s.get("vars") or [{}] * len(values)
        for val, label, extra in zip(values, labels, varsets):
            v = copy.deepcopy({k: x for k, x in c.items() if k != "sweep"})
            set_path(v, s["param"], val)
            if extra:
                v["vars"] = deep_merge(v.get("vars") or {}, extra)
            out.append(dict(v, label=label))
    return out


# ── building a case's input ──────────────────────────────────────────────────
# Two case kinds need more than a prompt string, and both are built here rather
# than checked into the repo: a haystack and a PNG are reviewable as text only
# while they are still a spec.

# Deliberately drab and domain-neutral. Filler must not read as a document with
# content, or the model starts answering the filler instead of the needle.
FILLER_VOCAB = (
    "archive batch cluster deferred entry fragment handler index journal ledger "
    "manifest node offset partition queue record segment threshold upstream "
    "vector window checkpoint retention schedule snapshot tier boundary cursor"
).split()


def build_filler(n_words: int, seed: int) -> str:
    """Synthesised haystack: fixed vocabulary + fixed seed, so it is identical
    on every host and every run. Nothing here derives from real material."""
    rnd = random.Random(seed)
    sentences, used = [], 0
    while used < n_words:
        ln = rnd.randint(8, 18)
        sentences.append(" ".join(rnd.choice(FILLER_VOCAB)
                                  for _ in range(ln)).capitalize() + ".")
        used += ln
    return "\n\n".join(" ".join(sentences[i:i + 6])
                       for i in range(0, len(sentences), 6))


# Font lookup for `text` shapes. A diagram without labels cannot pose a question
# about a named component, so text is what makes multimodal REASONING cases
# possible at all — as opposed to counting coloured blobs.
_FONT_PATHS = ("/System/Library/Fonts/Supplemental/Arial.ttf",
               "/Library/Fonts/Arial Unicode.ttf",
               "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf")


def _font(size: int):
    for p in _FONT_PATHS:
        if Path(p).is_file():
            try:
                return ImageFont.truetype(p, size)
            except OSError:
                continue
    # last resort: bitmap default. Legible but fixed-size, so diagrams built
    # against it will look different — prefer keeping a truetype path working.
    return ImageFont.load_default()


def render_image(spec: dict) -> str:
    """Render a case's declarative image spec to a base64 PNG.

    Shapes: circle {center, r} · rect {at, size} · line {from, to, width}
            text {at, text, size}   — all take an optional `color`.
    `rect` takes optional `outline` + `fill: none` for box-and-arrow diagrams.
    """
    w, h = spec.get("size", [320, 240])
    img = Image.new("RGB", (int(w), int(h)), spec.get("background", "white"))
    d = ImageDraw.Draw(img)
    for s in spec.get("shapes") or []:
        kind, color = s.get("kind"), s.get("color", "black")
        if kind == "circle":
            cx, cy = s["center"]
            r = s["r"]
            d.ellipse([cx - r, cy - r, cx + r, cy + r], fill=color)
        elif kind == "rect":
            x, y = s["at"]
            bw, bh = s["size"]
            fill = None if s.get("fill") == "none" else s.get("fill", color)
            d.rectangle([x, y, x + bw, y + bh], fill=fill,
                        outline=s.get("outline"), width=int(s.get("width", 1)))
        elif kind == "line":
            d.line([tuple(s["from"]), tuple(s["to"])], fill=color,
                   width=int(s.get("width", 2)))
        elif kind == "text":
            d.text(tuple(s["at"]), str(s["text"]), fill=color,
                   font=_font(int(s.get("size", 14))))
        else:
            sys.exit(f"error: unknown shape kind {kind!r} in an image spec")
    buf = io.BytesIO()
    img.save(buf, format="PNG")
    return base64.b64encode(buf.getvalue()).decode()


# A model that hits the generation cap has told us nothing about the task — it
# may be incapable, or merely brittle. Measured 2026-09-10: glm-4.7-flash:q4_k_m
# loops to the cap 5/5 when context and prompt are joined by ONE blank line, and
# answers correctly in ~700-1100 tokens with TWO. Deterministic both ways. The
# harness's own convention (strip, join with "\n\n") happens to be the
# pathological one for that model.
#
# We do NOT normalise to whichever shape makes models pass — that tunes the
# instrument to flatter the subject. Instead, on a cap hit we retry ONCE with the
# seam nudged, and if the model then converges we report the cell as
# whitespace-sensitive rather than failed. Brittleness about formatting is a real
# property of a model you would put behind a role; it is just a different fact
# from "cannot do the task", and the results table used to show them identically.
def nudge_whitespace(text: str, seam: int) -> str:
    """Add one blank line at the context/prompt seam.

    The seam is passed in rather than searched for: rfind("\n\n") lands on the
    LAST blank line, which is usually inside the prompt itself, so the nudge
    perturbed the wrong place and the retry proved nothing.
    """
    return text[:seam] + "\n" + text[seam:] if 0 < seam < len(text) else text


def build_input(c: dict) -> tuple[str, list[str], int]:
    """(prompt text, [base64 png], seam index) for one case."""
    ctx = (c.get("context") or "").strip()
    f = c.get("filler")
    if f:
        total = int(f.get("words", 8000))
        at = min(max(float(f.get("needle_at", 0.5)), 0.0), 1.0)
        head = int(total * at)
        # distinct seeds so the two halves are not the same text twice
        ctx = (f"{build_filler(head, seed=1)}\n\n{ctx}\n\n"
               f"{build_filler(total - head, seed=2)}")
    text = f"{ctx}\n\n{c['prompt']}" if ctx else c["prompt"]
    seam = len(ctx) if ctx else 0        # where the prompt begins
    return text, ([render_image(c["image"])] if c.get("image") else []), seam


# ── model backends ───────────────────────────────────────────────────────────
def openrouter_key() -> str:
    key = os.environ.get("OPENROUTER_API_KEY", "").strip()
    if key:
        return key
    try:
        return subprocess.run(["llm", "keys", "get", "openrouter"],
                              capture_output=True, text=True, check=True
                              ).stdout.strip().splitlines()[-1]
    except (subprocess.CalledProcessError, FileNotFoundError, IndexError):
        sys.exit("error: no openrouter key — set $OPENROUTER_API_KEY or run "
                 "`llm keys set openrouter`")


# A text-only model handed a vision case returns HTTP 400, which the table showed
# as an ERROR — indistinguishable from a broken harness or a dead server. It is
# neither: the case simply does not apply. `ollama-role` already gates on
# capabilities (`requires:` checked against `ollama show`, not against the tag
# name); the eval harness did not, so gpt-oss:20b collected three "errors" for
# lacking a modality nobody claimed it had.
#
# A case declares `requires: [vision]`, or is inferred to need vision when it
# carries an `image`. Remote models report nothing here, so they are never
# skipped — an openrouter tag is assumed capable and allowed to fail honestly.
def model_caps(model: str, timeout: int = 30) -> set[str] | None:
    """Capabilities ollama reports, or None when they cannot be determined."""
    if model.startswith(REMOTE_PREFIX):
        return None
    try:
        req = urllib.request.Request(
            f"{API}/api/show", data=json.dumps({"model": model}).encode(),
            headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return set(json.load(r).get("capabilities") or [])
    except (urllib.error.URLError, OSError, json.JSONDecodeError):
        return None


def case_requires(c: dict) -> set[str]:
    need = set(c.get("requires") or [])
    if c.get("image"):
        need.add("vision")
    return need


def unmet_capabilities(caps: set[str] | None, need: set[str]) -> list[str] | None:
    """Capabilities the model lacks, or None meaning RUN THE CASE.

    Extracted from eval_one so both directions are testable without a server.
    That matters more than it looks: a gate that skips everything and a gate that
    skips correctly both produce a clean-looking run, and only the RELENTING
    direction tells them apart. If model_caps() ever returned an empty set where
    it means "could not determine", every case carrying a requirement would be
    silently marked n/a and the suite would report success having tested nothing.

    None is returned when nothing is required, when the model has what is needed,
    or when capabilities are undeterminable — remote models report none, and an
    unreachable local one gets the benefit of the doubt and is allowed to fail
    honestly rather than vanish from the results.
    """
    if caps is None or not need or need <= caps:
        return None
    return sorted(need - caps)


def gen_local(model: str, text: str, images: list[str], num_ctx: int,
              timeout: int, max_tokens: int = 8192) -> tuple[str, dict]:
    payload = {
        "model": model, "prompt": text, "stream": False,
        # temperature 0: a case that only passes on a lucky sample has not
        # told us anything about the model. Use --repeat to probe variance.
        # num_predict caps runaway generation: glm-4.7-flash:q4_k_m does not
        # TERMINATE on the 12-step reasoning case — it loops re-litigating its
        # own interpretation and emitted 20k characters of thinking with an
        # empty answer (2026-09-08). Uncapped that costs a full timeout; capped
        # it is a fast, honest "did not converge".
        "options": {"num_ctx": num_ctx, "temperature": 0,
                    "num_predict": max_tokens},
        "keep_alive": "120s"}
    if images:
        payload["images"] = images
    req = urllib.request.Request(
        f"{API}/api/generate", data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        d = json.load(r)
    # NOTE: eval_count includes THINKING tokens, which never appear in
    # `response`. gemma4:12b-mlx spends 1-2k of them on a 90-character answer.
    # So output cost is not what you can see — which is the whole reason to
    # measure it rather than eyeball the reply.
    return d.get("response", ""), {"in": d.get("prompt_eval_count") or 0,
                                   "out": d.get("eval_count") or 0,
                                   "done_reason": d.get("done_reason")}


def gen_remote(model: str, text: str, images: list[str], timeout: int) -> str:
    # OpenAI-shaped content parts; a bare string when there is no image, since
    # not every remote model accepts the list form.
    content = text if not images else (
        [{"type": "text", "text": text}]
        + [{"type": "image_url",
            "image_url": {"url": f"data:image/png;base64,{b}"}} for b in images])
    req = urllib.request.Request(
        OR_URL,
        data=json.dumps({
            "model": model.removeprefix(REMOTE_PREFIX),
            "messages": [{"role": "user", "content": content}],
            "temperature": 0}).encode(),
        headers={"Content-Type": "application/json",
                 "Authorization": f"Bearer {openrouter_key()}"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        d = json.load(r)
    choices = d.get("choices") or []
    if not choices:
        raise RuntimeError(f"no choices in response: {str(d)[:200]}")
    u = d.get("usage") or {}
    return (choices[0].get("message", {}).get("content", "") or "",
            {"in": u.get("prompt_tokens") or 0, "out": u.get("completion_tokens") or 0})


def generate(model: str, text: str, images: list[str], num_ctx: int,
             timeout: int, max_tokens: int = 8192) -> tuple[str, dict]:
    if model.startswith(REMOTE_PREFIX):
        return gen_remote(model, text, images, timeout)
    return gen_local(model, text, images, num_ctx, timeout, max_tokens)


# ── scoring ──────────────────────────────────────────────────────────────────
# A check passes by not raising. AssertionError carries the case author's own
# message; anything else (json.JSONDecodeError, SyntaxError from ast.parse) is a
# failure too, and its type is the useful part of the reason.
def run_check(src: str, response: str, variables: dict | None = None) -> tuple[bool, str]:
    try:
        ns = {"response": response}
        # a swept level can rebind what "correct" means (e.g. the expected count
        # rises with the shape count), so `vars` land in the check's namespace
        ns.update(variables or {})
        exec(compile(src, "<check>", "exec"), ns)
        return True, ""
    except AssertionError as e:
        return False, str(e) or "assertion failed"
    except Exception as e:  # noqa: BLE001 — any raise is a failed check
        return False, f"{type(e).__name__}: {e}"


def eval_one(model: str, cases: list[dict], num_ctx: int, repeat: int,
             timeout: int, sweep: bool = False, max_tokens: int = 8192,
             no_ws_retry: bool = False) -> dict:
    results = []
    caps = model_caps(model)
    for c in cases:
        missing = unmet_capabilities(caps, case_requires(c))
        if missing is not None:
            # not a failure and not an error — the case does not apply
            results.append({
                "case": c["name"], "role": c["role"], "property": c["property"],
                "skipped": missing, "passed": 0, "graded": 0,
                "errors": 0, "swept": False, "reached": None, "broke_at": None,
                "errored_at": None, "ws_sensitive": False, "levels": []})
            continue
        levels, ordered = [], (c.get("sweep") or {}).get("ordered", True)
        for lv in expand_sweep(c, sweep):
            text, images, seam = build_input(lv)
            # A level may demand more context than the CLI default — a long-role
            # case run at 8192 measures truncation, not the model.
            nctx = int(lv.get("num_ctx") or num_ctx)
            samples = []
            for _ in range(repeat):
                try:
                    resp, usage = generate(model, text, images, nctx, timeout,
                                           max_tokens)
                except (urllib.error.URLError, OSError, RuntimeError) as e:
                    samples.append({"error": str(e)[:300]})
                    continue
                ok, why = run_check(lv["check"], resp, lv.get("vars"))
                # Hitting the cap is its own diagnosis: the model never reached
                # an answer, as distinct from reaching a wrong one.
                ws = None
                if not ok and usage.get("done_reason") == "length":
                    why = f"DID NOT TERMINATE within {max_tokens} tokens — {why}"
                    alt = text if no_ws_retry else nudge_whitespace(text, seam)
                    if alt != text:
                        try:
                            r2, u2 = generate(model, alt, images, nctx, timeout,
                                              max_tokens)
                        except (urllib.error.URLError, OSError, RuntimeError):
                            r2, u2 = None, {}
                        if r2 is not None and u2.get("done_reason") != "length":
                            ok2, why2 = run_check(lv["check"], r2, lv.get("vars"))
                            ws = {"converged": True, "passed": ok2,
                                  "reason": why2, "usage": u2,
                                  "response": r2[:4000]}
                samples.append({"passed": ok, "reason": why, "usage": usage,
                                "whitespace_retry": ws,
                                # keep the whole answer: a failure is only
                                # auditable if you can read what it said
                                "response": resp[:4000]})
            graded = [s for s in samples if "passed" in s]
            cleared = bool(graded) and all(s["passed"] for s in graded)
            levels.append({
                "label": lv.get("label"), "cleared": cleared,
                # A level that produced NO gradable sample did not defeat the
                # model — the harness defeated itself. Reporting a timeout as a
                # capability break is the same error as trusting a bad check.
                "errored_out": not graded and bool(samples),
                # a cap hit that converged once the seam was nudged
                "ws_sensitive": any((sm.get("whitespace_retry") or {}).get("passed")
                                    for sm in samples),
                "passed": sum(s["passed"] for s in graded),
                "graded": len(graded), "errors": len(samples) - len(graded),
                "samples": samples})
            # climbing stops at the first failure only when difficulty is
            # declared monotonic; otherwise every level is probed
            if ordered and not cleared:
                break
        done = [x for x in levels if x["label"]]
        results.append({
            "case": c["name"], "role": c["role"], "property": c["property"],
            "passed": sum(x["passed"] for x in levels),
            "graded": sum(x["graded"] for x in levels),
            "errors": sum(x["errors"] for x in levels),
            "swept": bool(done),
            "ws_sensitive": any(x.get("ws_sensitive") for x in levels),
            # highest level cleared, and what stopped the climb — a genuine
            # wrong answer and a run that never produced one are different facts
            "reached": next((x["label"] for x in reversed(levels) if x["cleared"]), None),
            "broke_at": next((x["label"] for x in levels
                              if not x["cleared"] and not x["errored_out"]), None),
            "errored_at": next((x["label"] for x in levels if x["errored_out"]), None),
            "levels": levels,
        })
    return {"model": model, "cases": results}


# ── output ───────────────────────────────────────────────────────────────────
def mark(r: dict) -> str:
    if r.get("skipped"):
        return "n/a (no " + ",".join(r["skipped"]) + ")"
    ws = "*" if r.get("ws_sensitive") else ""     # * = converged once the seam moved
    if r.get("swept"):
        # the break-point IS the result; pass/fail is not informative here
        stop = (f"broke {r['broke_at']}" if r.get("broke_at")
                else f"ERR @{r['errored_at']}" if r.get("errored_at") else "")
        if not r["reached"]:
            return ((f"FAIL@{r['broke_at']}" if r.get("broke_at")
                     else f"ERR@{r['errored_at']}") + ws)
        return f"{r['reached']} ({stop}){ws}" if stop else f"all ≥{r['reached']}"
    if not r["graded"]:
        return "err" + ws
    if r["passed"] == r["graded"]:
        return "pass"
    if r["passed"] == 0:
        return "FAIL" + ws
    return f"{r['passed']}/{r['graded']}{ws}"


def cell_mark(cs: list[dict]) -> str:
    """One cell may hold several cases; report them together without hiding a
    failure behind a neighbour that passed."""
    if len(cs) == 1:
        return mark(cs[0])
    cs = [c for c in cs if not c.get("skipped")] or cs
    if all(c.get("skipped") for c in cs):
        return mark(cs[0])
    def clean(c):
        return (c["graded"] and c["passed"] == c["graded"]
                and not c.get("broke_at") and not c.get("errored_at"))
    good = sum(1 for c in cs if clean(c))
    if good == len(cs):
        return f"pass ({len(cs)})"
    worst = next(c for c in cs if not clean(c))
    return f"{good}/{len(cs)} · {mark(worst)}"


def table(results: list[dict], cases: list[dict]) -> None:
    # Printed as the role x property grid the cases are organised around, one
    # per model — a single wide row stops being readable past a 2x2.
    roles = list(dict.fromkeys(c["role"] for c in cases))
    props = list(dict.fromkeys(c["property"] for c in cases))
    # width follows the widest CELL too — break-point labels outgrow "pass"
    _groups = {}
    for r in results:
        for c in r["cases"]:
            _groups.setdefault((r["model"], c["role"], c["property"]), []).append(c)
    cells_w = [len(cell_mark(g)) for g in _groups.values()]
    w = max(14, *(len(p) + 2 for p in props), *(cw + 2 for cw in cells_w or [0]))
    for r in results:
        # A cell can hold SEVERAL cases — "support x faithfulness" is covered by
        # more than one scenario. Keyed as a dict it silently kept the last one.
        by = {}
        for c in r["cases"]:
            by.setdefault((c["role"], c["property"]), []).append(c)
        print(f"\n{r['model']}")
        print(f"  {'':<10}" + "".join(f"{p:<{w}}" for p in props))
        for role in roles:
            cells = "".join(
                f"{cell_mark(by[(role, p)]):<{w}}" if (role, p) in by else f"{'—':<{w}}"
                for p in props)
            print(f"  {role:<10}{cells}")
        # Token cost, both directions. Reported per CALL because that is the
        # unit you pay in — a model can be cheap per token and expensive per
        # task by generating far more of them.
        calls = [s for c in r["cases"] for lv in c["levels"]
                 for s in lv["samples"] if s.get("usage")]
        if calls:
            ti = sum(s["usage"]["in"] for s in calls)
            to = sum(s["usage"]["out"] for s in calls)
            print(f"  {'':<10}cost  {ti:,} in / {to:,} out over {len(calls)} call(s)"
                  f"  ({ti // len(calls):,} in, {to // len(calls):,} out per call)")
        p_ = sum(c["passed"] for c in r["cases"])
        g_ = sum(c["graded"] for c in r["cases"])
        # Errored samples are ungraded, so they shrink the denominator — without
        # saying so, "1/1" beside an `err` cell reads as a clean sweep.
        e_ = sum(c["errors"] for c in r["cases"])
        note = f"   ({e_} errored, ungraded)" if e_ else ""
        print(f"  {'':<10}score {p_}/{g_}{note}")
    print("\n  pass = every sample passed · FAIL = none did · n/m = flaky "
          "(sampling variance at temperature 0) · — = no case in that cell")
    if any(c.get("ws_sensitive") for r in results for c in r["cases"]):
        print("  * = hit the cap as written, but CONVERGED when one blank line was "
              "added at the\n      context/prompt seam — brittle about formatting, "
              "not unable to do the task")
    if any(c.get("swept") for r in results for c in r["cases"]):
        print("  swept cells show the hardest level CLEARED, and where the "
              "climb stopped — compare break-points, not pass/fail")


def failures(results: list[dict]) -> None:
    shown = False
    for r in results:
        for c in r["cases"]:
            for lv in c["levels"]:
                bad = [s for s in lv["samples"] if s.get("passed") is False]
                errs = [s for s in lv["samples"] if "error" in s]
                if not (bad or errs):
                    continue
                if not shown:
                    print("\n── why ──")
                    shown = True
                at = f" @{lv['label']}" if lv.get("label") else ""
                for s in errs:
                    print(f"  {r['model']}  {c['case']}{at}: ERROR {s['error']}")
                for s in bad[:1]:  # one exemplar is enough to see the shape
                    print(f"  {r['model']}  {c['case']}{at}: {s['reason']}")
                    head = " ".join(s["response"].split())[:160]
                    print(f"      said: {head!r}")


# ── commands ─────────────────────────────────────────────────────────────────
def cmd_run(args):
    cases = select(load_cases(args.cases), args.role, args.property, args.case)
    remote = [m for m in args.models if m.startswith(REMOTE_PREFIX)]
    if remote and not args.yes:
        # count LEVELS, not cases — a sweep multiplies the bill, and an
        # early-exit only ever makes the real total smaller than this estimate
        per_model = sum(len(expand_sweep(c, args.sweep)) for c in cases)
        n = len(remote) * per_model * args.repeat
        ans = input(f"{len(remote)} remote model(s) x {per_model} level(s) x "
                    f"{args.repeat} = up to {n} billed call(s). continue? [y/N] ")
        if ans.strip().lower() != "y":
            sys.exit("aborted")
    results = []
    for m in args.models:
        results.append(eval_one(m, cases, args.num_ctx, args.repeat,
                                args.timeout, args.sweep, args.max_tokens,
                                args.no_ws_retry))
        # Free the weights before the next candidate loads. Verdicts are
        # pass/fail so contention cannot skew one, but a 19GB model still
        # resident while the next loads can push the box into swap and time the
        # run out — indistinguishable from a model that could not answer.
        if not m.startswith(REMOTE_PREFIX):
            subprocess.run(["ollama", "stop", m], capture_output=True)
    table(results, cases)
    failures(results)
    d = results_dir()
    d.mkdir(parents=True, exist_ok=True)
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    out = d / f"{stamp}.json"
    out.write_text(json.dumps(
        {"at": stamp, "num_ctx": args.num_ctx, "repeat": args.repeat,
         "sweep": args.sweep, "cases": [c["name"] for c in cases],
         "results": results}, indent=2))
    print(f"\nsaved {out}")


def cmd_cases(args):
    cases = load_cases(args.cases)
    roles = sorted({c["role"] for c in cases})
    props = sorted({c["property"] for c in cases})
    print(f"{len(cases)} case(s) — {len(roles)} role(s) x {len(props)} propert"
          f"{'y' if len(props) == 1 else 'ies'}\n")
    for c in cases:
        kind = []
        if c.get("context"):
            kind.append("+context")
        if c.get("filler"):
            kind.append(f"+filler({c['filler'].get('words', 8000)}w)")
        if c.get("image"):
            kind.append("+image")
        if c.get("num_ctx"):
            kind.append(f"num_ctx={c['num_ctx']}")
        if c.get("sweep"):
            lv = expand_sweep(c, True)
            kind.append(f"+sweep[{'/'.join(str(x['label']) for x in lv)}]")
        print(f"  {c['name']:<34}{c['role']}/{c['property']:<24}"
              f"{' '.join(kind)}")
    have = {(c["role"], c["property"]) for c in cases}
    gaps = [(r, p) for r in roles for p in props if (r, p) not in have]
    if gaps:
        print("\n  uncovered cells: " + ", ".join(f"{r}/{p}" for r, p in gaps))


def cmd_show(args):
    d = results_dir()
    if args.diff:
        a, b = (json.loads(Path(f).read_text()) for f in args.diff)
        for run in (a, b):
            print(f"\n{run['at']}  repeat={run.get('repeat', 1)}")
            for r in run["results"]:
                p = sum(c["passed"] for c in r["cases"])
                g = sum(c["graded"] for c in r["cases"])
                print(f"  {r['model']:<40}{p}/{g}")
        return
    runs = sorted(d.glob("*.json")) if d.is_dir() else []
    if not runs:
        sys.exit(f"no saved runs in {d}")
    run = json.loads(runs[-1].read_text())
    print(f"{runs[-1].name}  repeat={run.get('repeat', 1)}"
          f"{'  swept' if run.get('sweep') else ''}")
    for r in run["results"]:
        for c in r["cases"]:
            print(f"  {r['model']:<38}{c['case']:<34}{mark(c)}")


# ── coverage ─────────────────────────────────────────────────────────────────
# "Which task types do I actually do, and which have no eval case at all?"
#
# PRIVACY CONTRACT, and it is the whole design:
#   * real prompts are read, embedded, classified, and DISCARDED in-process
#   * nothing derived from them is written to disk or printed except COUNTS per
#     hand-authored category
#   * the category vocabulary is closed (evals/taxonomy.yaml) and never derived
#     from the corpus, so the output cannot carry private content
# Emitting centroids, exemplars, or corpus-derived labels would turn this into
# Private Evolution without DP accounting — see the header of taxonomy.yaml.
def default_taxonomy() -> Path:
    return Path(__file__).resolve().parent.parent / "evals" / "taxonomy.yaml"


def llm_log() -> Path | None:
    if sys.platform == "darwin":
        p = Path.home() / "Library/Application Support/io.datasette.llm/logs.db"
    else:
        base = os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))
        p = Path(base) / "io.datasette.llm/logs.db"
    return p if p.is_file() else None


def embed(texts: list[str], model: str, timeout: int = 300) -> list[list[float]]:
    req = urllib.request.Request(
        f"{API}/api/embed",
        data=json.dumps({"model": model, "input": texts}).encode(),
        headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r).get("embeddings") or []


# Embedding-similarity classification was tried first and DOES NOT WORK for this
# taxonomy (measured 2026-09-09). Raw cosine: every description is "do a
# technical thing with text", so a shared direction dominates and 97% of
# assignments beat the runner-up by <0.05 — coin flips. After removing the
# category centroid the margins improve, but `vision-describe` becomes an
# attractor and swallows 65% of the corpus, including 68 prompts sent to
# deepseek-r1:32b, a model with no vision capability. That impossibility is what
# exposed it. Kept behind --method embed as a reproducible negative result.
#
# A small instruct model choosing from the closed list is far more discriminating
# and still fully local. Output is capped to a few tokens, so cost is dominated
# by prompt ingestion, not generation.
def classify_llm(text: str, tax: list[dict], model: str, timeout: int) -> str | None:
    cats = "\n".join(f"- {t['name']}: {' '.join(t['description'].split())}"
                     for t in tax)
    names = {t["name"] for t in tax}
    prompt = (
        "Classify the request below into exactly ONE category.\n"
        f"Reply with ONLY the category name, nothing else.\n\nCATEGORIES:\n{cats}\n\n"
        f"REQUEST:\n{text}\n\nCATEGORY:")
    try:
        resp, _ = gen_local(model, prompt, [], 8192, timeout, max_tokens=16)
    except (urllib.error.URLError, OSError) as e:
        raise RuntimeError(f"classifier call failed: {e}") from e
    said = resp.strip().lower()
    # exact first, then containment — a model that adds a stray word still counts
    for n in names:
        if said == n:
            return n
    hits = [n for n in names if n in said]
    return hits[0] if len(hits) == 1 else None


def cosine(a: list[float], b: list[float]) -> float:
    num = sum(x * y for x, y in zip(a, b))
    na = sum(x * x for x in a) ** 0.5
    nb = sum(y * y for y in b) ** 0.5
    return num / (na * nb) if na and nb else 0.0


def cmd_coverage(args):
    import sqlite3
    tax = (yaml.safe_load(args.taxonomy.read_text()) or {}).get("taxonomy") or []
    if not tax:
        sys.exit(f"error: no taxonomy in {args.taxonomy}")
    db = llm_log()
    if not db:
        sys.exit("no llm log found — nothing routed through `llm` yet")
    cases = load_cases(args.cases)
    have = {c["name"] for c in cases}

    con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)   # read-only, always
    try:
        rows = con.execute(
            "SELECT prompt, COALESCE(resolved_model, model, '?') FROM responses "
            "WHERE prompt IS NOT NULL AND prompt != ''").fetchall()
    finally:
        con.close()
    models = [r[1] for r in rows]
    # Truncated for classification only: the task TYPE is evident from the
    # opening of a request, and long prompts exceed the embedder's window.
    prompts = [r[0][:args.truncate] for r in rows]
    if not prompts:
        sys.exit("llm log has no usable prompts")

    if args.method == "llm":
        counts = {c["name"]: 0 for c in tax}
        per_model, unclassified = {}, 0
        for text, mdl in zip(prompts, models):
            name = classify_llm(text, tax, args.llm_model, args.timeout)
            if not name:
                unclassified += 1
                continue
            counts[name] += 1
            per_model.setdefault(mdl, {}).setdefault(name, 0)
            per_model[mdl][name] += 1
        del prompts, rows
        report_coverage(tax, counts, unclassified, len(models), have,
                        per_model, args, f"{args.llm_model} (local classifier)")
        return

    cat_vecs = embed([c["description"] for c in tax], args.embed_model)
    if len(cat_vecs) != len(tax):
        sys.exit(f"error: embedder returned {len(cat_vecs)} vectors for {len(tax)} categories")
    # CENTERING. Every category description is "do a technical thing with text",
    # so a large shared direction dominates raw cosine and every prompt scores
    # ~equally against all of them. Measured before this: mean margin over the
    # runner-up was 0.019, i.e. the assignment was a coin flip 97% of the time.
    # Subtracting the category centroid from both sides removes the common
    # component and leaves what actually distinguishes the categories.
    centroid = [sum(v[i] for v in cat_vecs) / len(cat_vecs) for i in range(len(cat_vecs[0]))]

    def center(v):
        return [x - c for x, c in zip(v, centroid)] if args.center else v

    cat_vecs = [center(v) for v in cat_vecs]
    counts = {c["name"]: 0 for c in tax}
    per_model = {}
    unclassified = 0
    sims = []
    idx = 0
    for i in range(0, len(prompts), args.batch):
        for raw in embed(prompts[i:i + args.batch], args.embed_model):
            vec = center(raw)
            scored = sorted(((cosine(vec, cv), t["name"])
                             for cv, t in zip(cat_vecs, tax)), reverse=True)
            best, name = scored[0]
            # margin over the runner-up: a confident assignment beats the second
            # category clearly. A tiny margin means the taxonomy is not
            # discriminating, which looks identical to a real count in the table.
            margin = best - (scored[1][0] if len(scored) > 1 else 0.0)
            sims.append((best, margin))
            # MARGIN is the gate, not absolute similarity. After centering, the
            # absolute cosine is small by construction, so an absolute floor
            # throws away good assignments; what makes a count meaningful is
            # that the winning category beat the runner-up by a real distance.
            if margin < args.min_margin or best < args.threshold:
                unclassified += 1
            else:
                counts[name] += 1
                per_model.setdefault(models[idx], {}).setdefault(name, 0)
                per_model[models[idx]][name] += 1
            idx += 1
    del prompts, rows          # explicit: content does not outlive classification

    report_coverage(tax, counts, unclassified, len(sims), have, per_model, args,
                    f"{args.embed_model} (embedding similarity)", sims)


def report_coverage(tax, counts, unclassified, total, have, per_model, args,
                    method: str, sims=None) -> None:
    print(f"{total} real prompt(s) classified locally with {method}\n"
          f"(counts only — no prompt content is printed, written, or retained)\n")
    print(f"{'task type':<24}{'real':>6}{'share':>8}   {'eval cases':<38}")
    for t in tax:
        n = counts[t["name"]]
        named = list(t.get("cases") or [])
        missing = [c for c in named if c not in have]
        label = ", ".join(named) if named else "— NONE —"
        if missing:
            label += f"  (!! not found: {', '.join(missing)})"
        print(f"  {t['name']:<22}{n:>6}{n / total * 100:>7.1f}%   {label:<38}")
    if unclassified:
        print(f"  {'(unclassified)':<22}{unclassified:>6}"
              f"{unclassified / total * 100:>7.1f}%")
    if sims:
        mean_sim = sum(s for s, _ in sims) / len(sims)
        mean_margin = sum(m for _, m in sims) / len(sims)
        weak = sum(1 for _, m in sims if m < 0.05)
        print(f"\n  mean best-match similarity {mean_sim:.3f} · mean margin over "
              f"runner-up {mean_margin:.3f}")
        if weak:
            print(f"  ! {weak} of {total} assignments ({weak / total * 100:.0f}%) beat "
                  f"the runner-up by <0.05 — those counts are near coin-flips")

    if args.by_model:
        print("\n── which model gets which task type (counts only) ──")
        for m in sorted(per_model, key=lambda x: -sum(per_model[x].values()))[:args.top]:
            tot = sum(per_model[m].values())
            top = sorted(per_model[m].items(), key=lambda kv: -kv[1])[:3]
            spread = "  ".join(f"{k} {v}" for k, v in top)
            print(f"  {m:<34}{tot:>5} call(s)   {spread}")

    # The finding this command exists for.
    gaps = [t["name"] for t in tax if counts[t["name"]] and not (t.get("cases") or [])]
    if gaps:
        share = sum(counts[g] for g in gaps) / total * 100
        print(f"\n! {len(gaps)} task type(s) you DO have no eval case at all — "
              f"{share:.0f}% of real prompts:")
        for g in sorted(gaps, key=lambda x: -counts[x]):
            print(f"    {g:<22}{counts[g]:>5} prompt(s)")
    else:
        print("\n  every task type with real traffic has at least one eval case")


def main():
    p = argparse.ArgumentParser(prog="ollama-evals", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--cases", type=Path,
                   default=Path(os.environ.get("OLLAMA_EVALS_CASES", default_cases())))
    sub = p.add_subparsers(dest="cmd", required=True)

    r = sub.add_parser("run", help="run cases against one or more models")
    r.add_argument("models", nargs="+")
    r.add_argument("--role", help="only cases for this role")
    r.add_argument("--property", help="only cases for this property")
    r.add_argument("--case", action="append", help="run a named case (repeatable)")
    r.add_argument("--sweep", action="store_true",
                   help="climb each case's difficulty levels and report where "
                        "the model breaks (costs one call per level)")
    r.add_argument("--repeat", type=int, default=1, help="samples per case")
    r.add_argument("--num-ctx", dest="num_ctx", type=int, default=8192)
    r.add_argument("--timeout", type=int, default=600)
    r.add_argument("--no-ws-retry", dest="no_ws_retry", action="store_true",
                   help="skip the whitespace retry on a cap hit (saves one call "
                        "per failure, but conflates brittleness with inability)")
    r.add_argument("--max-tokens", dest="max_tokens", type=int, default=8192,
                   help="cap generation; a model that hits it is reported as "
                        "not terminating rather than stalling the run")
    r.add_argument("--yes", action="store_true", help="skip the billed-call prompt")
    r.set_defaults(func=cmd_run)

    sub.add_parser("cases", help="list cases and coverage").set_defaults(func=cmd_cases)

    s = sub.add_parser("show", help="show the last run, or diff two saved runs")
    s.add_argument("--diff", nargs=2, metavar="FILE")
    s.set_defaults(func=cmd_show)

    cv = sub.add_parser("coverage", help="which real task types have no eval case")
    cv.add_argument("--taxonomy", type=Path, default=default_taxonomy())
    cv.add_argument("--method", choices=["llm", "embed"], default="llm",
                    help="llm: a small local model picks from the closed list "
                         "(default). embed: cosine to descriptions — kept as a "
                         "reproducible negative result, it does not discriminate")
    cv.add_argument("--llm-model", dest="llm_model",
                    default="granite4.1:8b-q8_0",
                    help="small local instruct model used to classify. Screened "
                         "on 8 hand-labelled probes: granite4.1:8b 8/8, "
                         "ministral-3:3b 6/8, granite4.1:3b 3/5 — 3B-class is "
                         "too weak for this, so do not shrink it for speed")
    cv.add_argument("--timeout", type=int, default=120)
    cv.add_argument("--embed-model", dest="embed_model", default="bge-m3:567m-fp16",
                    help="local embedding model used to classify (never leaves the host)")
    cv.add_argument("--min-margin", dest="min_margin", type=float, default=0.03,
                    help="how far the winning category must beat the runner-up "
                         "for the assignment to count (the real confidence gate)")
    cv.add_argument("--threshold", type=float, default=0.0,
                    help="absolute similarity floor; after centering this is "
                         "near-meaningless, so it defaults off")
    cv.add_argument("--truncate", type=int, default=2000,
                    help="chars of each prompt used for classification")
    cv.add_argument("--batch", type=int, default=32)
    cv.add_argument("--no-center", dest="center", action="store_false",
                    help="skip centroid removal — diagnostic only, shows the "
                         "raw near-tied scores that make counts meaningless")
    cv.add_argument("--by-model", dest="by_model", action="store_true",
                    help="cross-tab model against task type (counts only) — the "
                         "check for whether a role is being used as intended")
    cv.add_argument("--top", type=int, default=8, help="models to show with --by-model")
    cv.set_defaults(func=cmd_coverage)

    args = p.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
