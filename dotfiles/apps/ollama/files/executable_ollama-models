#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["pyyaml"]
# ///
"""ollama-models — manage the Ollama model set declared in the topic manifest.

Run as a uv single-file script: the shebang invokes `uv run --script`, which
resolves the `pyyaml` dependency above into a cached ephemeral venv. uv is
provided by mise (apps/mise/files/config.toml -> [tools] uv). Nothing is
installed into a global Python.

The manifest (apps/ollama/defaults/main.yaml) is the single source of truth:
families → members, each member carrying one tag per os/hardware key plus
`size_gb`. Keys are tried most-specific-first — on Linux `linux_nvidia` or
`linux_amd` (auto-detected) before the universal `linux` — so a family with no
hardware-specific build just declares `darwin` + `linux` as before. This tool
resolves the manifest for the current host, gates each entry against a RAM/VRAM
budget (total − ollama_ram_reserve_pct), and drives ollama accordingly.

Subcommands:
  sync [--refresh] [--dry-run]   pull manifest models for this OS within budget
                                 (default: only missing ones; --refresh re-pulls all)
  status                          show installed / missing / skipped (oversized)
  check [--next-gen]              diff each family's upstream tags vs the manifest;
                                 flag unknown precision/format keywords; with
                                 --next-gen, probe for newer family generations
  prune [--remove]                list installed models not in the manifest;
                                 --remove deletes them (with confirmation).
                                 Tags listed under `ollama_prune_keep` (bare
                                 :latest aliases, pinned experiments) are never
                                 listed. Tags for OTHER hosts' hardware keys are
                                 kept too, so pruning on a mac cannot delete the
                                 nvfp4 builds a Linux box pulled.

Manifest location: $OLLAMA_MODELS_MANIFEST, else --manifest, else the
defaults/main.yaml two dirs up from this script.
"""
from __future__ import annotations

import argparse
import hashlib
import os
import platform
import re
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path

try:
    import yaml
except ImportError:
    sys.exit(
        "error: PyYAML not available.\n"
        "  this script is meant to run via uv (`uv run --script`); ensure uv is\n"
        "  installed (provided by mise), or run: uv run --script "
        + str(Path(__file__).name)
    )

OLLAMA_COM = "https://ollama.com"
REGISTRY = "https://registry.ollama.ai"
UA = "ollama-models/1.0 (+dotfiles)"

# Tokens that may appear after the size in a tag and are already understood.
# Anything else is surfaced by `check` as a possible NEW precision/feature.
KNOWN_TOKENS = {
    # precision / quantization
    "mlx", "bf16", "fp16", "fp8", "fp4", "mxfp8", "mxfp4", "nvfp4", "qat",
    "int4", "int8", "q2_k", "q3_k_s", "q3_k_m", "q3_k_l", "q4_0", "q4_1",
    "q4_k_s", "q4_k_m", "q5_0", "q5_1", "q5_k_s", "q5_k_m", "q6_k", "q8_0",
    # role / variant
    "it", "instruct", "think", "thinking", "coding", "code", "base", "chat",
    "mtp", "cloud", "latest", "distill", "qwen", "vl", "embedding", "reranker",
    "moe", "h", "micro", "tiny", "small", "reasoning", "vision",
}
SIZE_RE = re.compile(r"^(?:a|e)?\d+(?:\.\d+)?[bm]$|^\d+x\d+b$|^\d+$", re.I)


# ── manifest ────────────────────────────────────────────────────────────────
def default_manifest() -> Path:
    return Path(__file__).resolve().parent.parent / "defaults" / "main.yaml"


def load_manifest(path: Path):
    if not path.exists():
        sys.exit(f"error: manifest not found: {path}")
    data = yaml.safe_load(path.read_text()) or {}
    reserve = int(data.get("ollama_ram_reserve_pct", 33))
    families = data.get("ollama_models") or {}
    if not isinstance(families, dict):
        sys.exit("error: ollama_models must be a mapping of family -> [members]")
    # Tags that are legitimately installed but deliberately not manifest members
    # (bare `:latest` aliases, hand-pinned experiments). `prune` never lists
    # them; `sync` never pulls them.
    keep = fold(data.get("ollama_prune_keep") or [])
    # Context headroom: how much KV cache to budget for on top of the weights.
    ctx = {
        "tokens": int(data.get("ollama_target_ctx_tokens", 32768)),
        "kv_default": float(data.get("ollama_kv_kb_per_token_default", 70)),
    }
    return reserve, families, keep, ctx


# ── host facts ──────────────────────────────────────────────────────────────
# Every per-OS/hardware key a manifest member may carry. `resolve()` walks the
# host's priority list (see os_keys) and uses the FIRST key the member defines,
# so `linux` alone still works for families with no hardware-specific build.
OS_KEYS = ("darwin", "linux_nvidia", "linux_amd", "linux")


def gpu_vendor() -> str:
    """'nvidia' | 'amd' | '' for this Linux host (a box may have both; NVIDIA
    wins because nvfp4 is the fastest build we ship)."""
    if nvidia_vram_gb() > 0:
        return "nvidia"
    if amd_vram_gb() > 0:
        return "amd"
    # No vendor tool: fall back to the same /sys PCI probe the ansible topic uses.
    for path in Path("/sys/bus/pci/devices").glob("*/vendor"):
        try:
            vid = path.read_text().strip().lower()
        except OSError:
            continue
        if vid == "0x10de":
            return "nvidia"
        if vid == "0x1002":
            return "amd"
    return ""


# Native FP4 tensor cores arrive with Blackwell — compute capability 10.0 on the
# datacenter B-series, 12.0 on consumer RTX 50xx. On Ampere (8.6) and Ada (8.9)
# NVFP4 is *emulated* through higher-precision kernels with no latency advantage
# over BF16, so an RTX 3090 running an nvfp4 build is strictly worse off than the
# same model as GGUF. `linux_nvidia` therefore means "has real FP4 silicon", not
# merely "is an NVIDIA card"; everything older falls through to `linux`.
BLACKWELL_CC = 10.0


def nvidia_compute_cap() -> float:
    """Highest CUDA compute capability present, or 0.0 if none/unavailable."""
    try:
        out = subprocess.run(
            ["nvidia-smi", "--query-gpu=compute_cap", "--format=csv,noheader"],
            capture_output=True, text=True, check=True,
        ).stdout
    except (subprocess.CalledProcessError, FileNotFoundError):
        return 0.0
    caps = []
    for tok in out.split():
        try:
            caps.append(float(tok))
        except ValueError:
            pass
    return max(caps) if caps else 0.0


def os_keys() -> list[str]:
    """Manifest keys to try, most specific first."""
    if platform.system() == "Darwin":
        return ["darwin"]
    vendor = gpu_vendor()
    if vendor == "nvidia" and nvidia_compute_cap() < BLACKWELL_CC:
        return ["linux"]        # pre-Blackwell: native GGUF beats emulated FP4
    if vendor:
        return [f"linux_{vendor}", "linux"]
    return ["linux"]


def nvidia_vram_gb() -> float:
    """Total VRAM of the largest NVIDIA GPU, or 0 if none / nvidia-smi absent."""
    try:
        out = subprocess.run(
            ["nvidia-smi", "--query-gpu=memory.total", "--format=csv,noheader,nounits"],
            capture_output=True, text=True, check=True,
        ).stdout
    except (subprocess.CalledProcessError, FileNotFoundError):
        return 0.0
    vals = [float(x) for x in out.split() if x.strip().replace(".", "").isdigit()]
    return max(vals) / 1024 if vals else 0.0  # MiB → GiB


def amd_vram_gb() -> float:
    """Total VRAM of the largest AMD GPU, or 0 if none / rocm-smi absent."""
    try:
        out = subprocess.run(
            ["rocm-smi", "--showmeminfo", "vram", "--csv"],
            capture_output=True, text=True, check=True,
        ).stdout
    except (subprocess.CalledProcessError, FileNotFoundError):
        return 0.0
    # CSV rows carry a bytes total; take the largest plausible value.
    vals = [float(x) for x in re.findall(r"\b(\d{9,})\b", out)]
    return max(vals) / 1024**3 if vals else 0.0


def system_ram_gb() -> float:
    if platform.system() == "Darwin":
        out = subprocess.check_output(["sysctl", "-n", "hw.memsize"])
        return int(out) / 1024**3
    try:
        for line in Path("/proc/meminfo").read_text().splitlines():
            if line.startswith("MemTotal"):
                return int(line.split()[1]) / 1024**2  # kB → GiB
    except OSError:
        pass
    return 0.0


def total_ram_gb() -> tuple[float, str]:
    """Budget basis + a label for it. On Mac, unified memory == system RAM. On
    Linux with a discrete GPU, the real inference constraint is VRAM (the linux
    tags are GPU quants); fall back to system RAM for CPU inference otherwise."""
    if platform.system() != "Darwin":
        vram = nvidia_vram_gb() or amd_vram_gb()
        if vram > 0:
            return vram, "vram"
    return system_ram_gb(), "ram"


# ── resolution ──────────────────────────────────────────────────────────────
def member_tag(m: dict, keys: list[str]) -> tuple[str, str] | None:
    """(tag, key_used) for the most specific key this member defines."""
    for k in keys:
        if m.get(k):
            return m[k], k
    return None


def member_size(m: dict, key: str) -> float:
    """`size_gb` is either a scalar (same footprint everywhere) or a mapping of
    OS key -> GB, for members whose per-hardware builds differ materially in
    size (e.g. a 20GB nvfp4 vs the 31GB mxfp8 that AMD/CPU has to fall back to).
    A mapping missing this key falls back to its largest entry, so the budget
    gate stays conservative rather than silently over-committing memory."""
    raw = m.get("size_gb", 0)
    if isinstance(raw, dict):
        if key in raw:
            return float(raw[key])
        return float(max(raw.values())) if raw else 0.0
    return float(raw)


def kv_gb(m: dict, ctx: dict) -> float:
    """GB of KV cache this member needs at the target context length.

    Weights alone are a misleading gate: `ministral-3:3b` is 4.5GB of weights
    but needs ~33GB at its full 262K window, so it clears a 24GB budget and then
    cannot run. KV cost is per-token and tracks ARCHITECTURE, not parameter
    count — measured here, granite4's hybrid layers cost ~19 KB/token while the
    much smaller ministral-3 costs ~107 KB/token. Members carry a measured
    `kv_kb_per_token` where one exists; the rest fall back to a mid-range
    default. See SIZING.md for the measurements.
    """
    kb = float(m.get("kv_kb_per_token", ctx["kv_default"]))
    return ctx["tokens"] * kb / 1e6


def resolve(families: dict, keys: list[str], budget: float, ram_budget: float = 0.0,
            ctx: dict | None = None):
    """Yield (family, tag, size_gb, kv, fits) for this host, in manifest order.

    `fits` gates on weights + KV at the target context, not on weights alone.

    A member may set `basis: ram` to opt out of the default budget. On a Linux
    host with a discrete GPU the budget is VRAM, which is the right gate for
    anything meant to run *on* the GPU — but wrong for large MoE models that are
    deliberately run on CPU or split across CPU+GPU, where the real limit is
    system RAM. Without this, an 81GB MoE would be gated out by a 24GB card on a
    128GB host. Ignored where no separate RAM budget applies (e.g. macOS unified
    memory, where the two are the same number).
    """
    for family, members in families.items():
        for m in members or []:
            hit = member_tag(m, keys)
            if not hit:
                continue
            tag, key = hit
            size = member_size(m, key)
            limit = ram_budget if (m.get("basis") == "ram" and ram_budget) else budget
            kv = kv_gb(m, ctx) if ctx else 0.0
            yield family, tag, size, kv, size + kv <= limit


def installed_models() -> set[str]:
    try:
        out = subprocess.run(
            ["ollama", "list"], capture_output=True, text=True, check=True
        ).stdout
    except (subprocess.CalledProcessError, FileNotFoundError):
        return set()
    names = set()
    for line in out.splitlines()[1:]:
        line = line.strip()
        if line:
            names.add(line.split()[0])
    return names


# Ollama lowercases the tag when it writes a local manifest, so pulling the
# upstream tag `glm-4.7-flash:q4_K_M` lands on disk as `glm-4.7-flash:q4_k_m`.
# Comparing raw strings therefore reports a manifest model as both MISSING and
# an orphan at once — and `prune --remove` would delete a model we want. All
# installed-vs-manifest comparisons go through casefolded names.
def fold(names):
    return {n.lower() for n in names}


# Cloud tags — `:cloud`, `:20b-cloud`, `:0731-cloud` — are HOSTED-ONLY: ollama
# routes them to Ollama's servers and stores no weights on disk. They can never
# satisfy this manifest, whose entire point is a local, reproducible model set
# that works offline and is gated against a RAM/VRAM budget.
#
# They are easy to pick by mistake: they sit in the same tags list as real
# builds and look like ordinary variants. So they are refused at every surface
# rather than silently sitting at MISSING forever — `check` never suggests one,
# and `sync`/`status` name the reason out loud.
def is_cloud_tag(tag: str) -> bool:
    ref = tag.partition(":")[2]
    return ref == "cloud" or ref.endswith("-cloud")


CLOUD_WHY = ("cloud-only: hosted on ollama.com, no local weights — "
             "replace with a local tag (e.g. a -q4_K_M / -mlx / -nvfp4 build)")


def http_get(url: str) -> str:
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=20) as resp:
        return resp.read().decode("utf-8", "replace")


def upstream_tags(family: str) -> set[str]:
    """Scrape the public tags page for a family's available tags."""
    path = family if "/" in family else f"library/{family}"
    html = http_get(f"{OLLAMA_COM}/{path}/tags")
    variants = re.findall(re.escape(family) + r":([A-Za-z0-9][A-Za-z0-9._-]*)", html)
    return {f"{family}:{v}" for v in variants}


# ── digest diff (cheap "has upstream changed?" check for --refresh) ───────────
# Ollama models are content-addressed: a tag points to a small manifest of
# sha256-digested layers, and `ollama pull` only fetches blobs it lacks. So a
# refresh of an unchanged model already transfers ~0 bytes — but it still spawns
# a pull per model. These helpers let --refresh skip that entirely: compare the
# local manifest file's sha256 to the upstream manifest's, and only pull on a
# real difference. registry.ollama.ai serves the manifest as a plain body (no
# Docker-Content-Digest header), so we hash the body ourselves; the header is
# added too when present, and any fetch/parse failure falls back to pulling.
def _registry_ref(tag: str) -> tuple[str, str]:
    """'qwen3.6:27b-mlx' -> ('library/qwen3.6', '27b-mlx'); namespaced tags kept."""
    name, _, ref = tag.partition(":")
    repo = name if "/" in name else f"library/{name}"
    return repo, ref or "latest"


def _ollama_models_root() -> Path:
    root = os.environ.get("OLLAMA_MODELS")
    return Path(root) if root else Path.home() / ".ollama" / "models"


def local_manifest_digest(tag: str) -> str | None:
    repo, ref = _registry_ref(tag)
    p = _ollama_models_root() / "manifests" / "registry.ollama.ai" / repo / ref
    if not p.is_file():
        return None
    return "sha256:" + hashlib.sha256(p.read_bytes()).hexdigest()


def remote_manifest_digests(tag: str) -> set[str] | None:
    """Acceptable upstream digests (body hash + any header), or None on error."""
    repo, ref = _registry_ref(tag)
    url = f"{REGISTRY}/v2/{repo}/manifests/{ref}"
    req = urllib.request.Request(url, headers={
        "User-Agent": UA,
        "Accept": "application/vnd.docker.distribution.manifest.v2+json",
    })
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            digs = {"sha256:" + hashlib.sha256(resp.read()).hexdigest()}
    except (urllib.error.URLError, OSError):
        return None
    hdr = (resp.headers.get("Docker-Content-Digest") or "").strip()
    if hdr:
        digs.add(hdr)
    return digs


def changed_state(tag: str) -> bool | None:
    """True = upstream differs, False = identical, None = couldn't determine."""
    local = local_manifest_digest(tag)
    if not local:
        return None
    remote = remote_manifest_digests(tag)
    if not remote:
        return None
    return local not in remote


# ── commands ────────────────────────────────────────────────────────────────
def cmd_sync(args, reserve, families, keep, ctx):
    mem, basis = total_ram_gb()
    budget = mem * (100 - reserve) / 100
    # Separate system-RAM budget for members marked `basis: ram` (CPU/split MoE).
    # On macOS the basis is already system RAM, so this is the same number.
    ram_budget = system_ram_gb() * (100 - reserve) / 100
    keys = os_keys()
    have = fold(installed_models())
    print(f"os={'+'.join(keys)}  {basis}={mem:.0f}GB  budget={budget:.0f}GB  "
          f"reserve={reserve}%  mode={'refresh' if args.refresh else 'install-missing'}")
    pulled = skipped = present = unchanged = cloud = 0
    for family, tag, size, kv, fits in resolve(families, keys, budget, ram_budget, ctx):
        if is_cloud_tag(tag):
            print(f"  CLOUD  {tag:<42} NOT PULLED — {CLOUD_WHY}")
            cloud += 1
            continue
        if not fits:
            print(f"  skip   {tag:<42} ({size:.0f}GB weights + {kv:.0f}GB ctx > budget)")
            skipped += 1
            continue
        if tag.lower() in have:
            if not args.refresh:
                present += 1
                continue
            # refresh: only re-pull when the upstream manifest actually differs.
            state = changed_state(tag)
            if state is False:
                print(f"  keep   {tag:<42} (unchanged)")
                unchanged += 1
                continue
            note = "" if state is True else "  (digest unknown → pulling to be safe)"
            print(f"  {'would' if args.dry_run else 'pull '} {tag}{note}")
        else:
            print(f"  {'would' if args.dry_run else 'pull '} {tag}")
        if not args.dry_run:
            rc = subprocess.run(["ollama", "pull", tag]).returncode
            if rc != 0:
                print(f"    ! pull failed (rc={rc})", file=sys.stderr)
            else:
                pulled += 1
    print(f"done: pulled={pulled} unchanged={unchanged} "
          f"already-present={present} skipped-oversized={skipped} "
          f"refused-cloud={cloud}")
    if cloud:
        one = cloud == 1
        print(f"\n  ! {cloud} manifest {'entry references' if one else 'entries reference'} "
              f"a cloud tag and {'was' if one else 'were'} NOT installed.\n"
              f"    This is why {'it does' if one else 'they do'} not show up in "
              f"`ollama list`. Edit defaults/main.yaml to use a local build.")


def cmd_status(args, reserve, families, keep, ctx):
    mem, basis = total_ram_gb()
    budget = mem * (100 - reserve) / 100
    # Separate system-RAM budget for members marked `basis: ram` (CPU/split MoE).
    # On macOS the basis is already system RAM, so this is the same number.
    ram_budget = system_ram_gb() * (100 - reserve) / 100
    keys = os_keys()
    have = fold(installed_models())
    print(f"os={'+'.join(keys)}  {basis}={mem:.0f}GB  budget={budget:.0f}GB  "
          f"reserve={reserve}%  ctx={ctx['tokens']}tok\n"
          f"(sizes are weights + KV cache at the target context; "
          f"the budget gates their SUM)\n")
    n_cloud = 0
    for fam in families:
        print(f"{fam}:")
        for family, tag, size, kv, fits in resolve({fam: families[fam]}, keys, budget, ram_budget, ctx):
            if is_cloud_tag(tag):
                state = "CLOUD(never)"
                n_cloud += 1
            elif not fits:
                state = "skip(oversized)"
            elif tag.lower() in have:
                state = "installed"
            else:
                state = "MISSING"
            print(f"  {state:<16} {tag} "
                  f"({size:.0f}+{kv:.1f}={size + kv:.1f}GB)")
    if n_cloud:
        print(f"\n! {n_cloud} entr{'y' if n_cloud == 1 else 'ies'} marked "
              f"CLOUD(never) will NEVER install — {CLOUD_WHY}.")


def cmd_check(args, reserve, families, keep, ctx):
    manifest_by_family = {}
    for family, members in families.items():
        tags = set()
        for m in members or []:
            for k in OS_KEYS:
                if m.get(k):
                    tags.add(m[k])
        manifest_by_family[family] = tags

    for family, have_tags in manifest_by_family.items():
        print(f"\n{family}")
        try:
            up = upstream_tags(family)
        except urllib.error.HTTPError as e:
            print(f"  ! upstream fetch failed: HTTP {e.code}")
            continue
        except (urllib.error.URLError, OSError) as e:
            print(f"  ! upstream fetch failed: {e}")
            continue
        up_lc = fold(up)
        have_lc = fold(have_tags)
        new = sorted(t for t in up if t.lower() not in have_lc and not is_cloud_tag(t))
        gone = sorted(t for t in have_tags if t.lower() not in up_lc)
        # unknown precision/format keywords across all upstream tags
        unknown = set()
        for t in up:
            variant = t.split(":", 1)[1] if ":" in t else ""
            for tok in variant.split("-"):
                if not tok or SIZE_RE.match(tok):
                    continue
                if tok.lower() not in KNOWN_TOKENS:
                    unknown.add(tok)
        if gone:
            print(f"  ⚠ in manifest but gone upstream: {', '.join(gone)}")
        if unknown:
            print(f"  ★ NEW/unknown keyword(s) (possible new feature): "
                  f"{', '.join(sorted(unknown))}")
        if new:
            print(f"  + {len(new)} upstream tag(s) not in manifest:")
            for t in new:
                print(f"      {t}")
        if not (gone or unknown or new):
            print("  ✓ manifest matches upstream")
        if args.next_gen:
            for cand in next_gen_candidates(family):
                try:
                    html = http_get(f"{OLLAMA_COM}/library/{cand}/tags")
                except urllib.error.HTTPError:
                    continue
                except (urllib.error.URLError, OSError):
                    continue
                # A hosted-only family (every tag ends in `-cloud`) cannot
                # replace a local one at any price — say so, so it is not
                # mistaken for an actionable upgrade.
                tags = re.findall(re.escape(cand) + r":([A-Za-z0-9][A-Za-z0-9._-]*)", html)
                local = [t for t in tags if not t.endswith("cloud")]
                note = "" if local else "  (cloud-only — no local weights)"
                print(f"  ⬆ newer generation may exist: {cand}{note}")


# Version-like number anywhere in the name, with an optional trailing word.
# The old heuristic anchored digits to the END of the family, which silently
# returned NO candidates for 4 of 18 families (glm-4.7-flash, gpt-oss, qwen3-vl,
# embeddinggemma) — that is why glm-5.x was missed — and never probed `X.1`
# when the family had no minor, which is how lfm2 -> lfm2.5 stayed invisible.
_VERSION_RE = re.compile(r"^(?P<head>.*?)(?P<major>\d+)(?:\.(?P<minor>\d+))?(?P<tail>\D*)$")


def next_gen_candidates(family: str) -> list[str]:
    """Plausible newer generations of `family`, most-likely first.

      qwen3.6        -> qwen3.7 … qwen3.9, qwen4, qwen4.1 … qwen4.5
      lfm2           -> lfm2.1 … lfm2.9, lfm3, …          (finds lfm2.5)
      glm-4.7-flash  -> glm-4.8-flash …, glm-5-flash …, and the bare
                        glm-4.8 / glm-5 / glm-5.2 forms   (finds glm-5.2)
      qwen3-vl       -> qwen3.1-vl …, qwen4-vl …, plus bare qwen4
      gpt-oss        -> gpt-oss2, gpt-oss-2, gpt-oss-v2   (no version to bump)

    Renames are out of reach by construction: nothing derives deepseek-v4 from
    deepseek-r1. Those still need a manual look at the library index.
    """
    m = _VERSION_RE.match(family)
    if not m:
        return [f"{family}2", f"{family}-2", f"{family}-v2"]
    head, tail = m.group("head"), m.group("tail") or ""
    major, minor = int(m.group("major")), m.group("minor")

    stems = [f"{head}{major}.{n}"
             for n in range(int(minor) + 1 if minor is not None else 1, 10)]
    stems.append(f"{head}{major + 1}")
    # A new major usually lands with minors soon after (glm-5 -> glm-5.2), but
    # probing 1-9 on both majors doubles the request count for little gain.
    stems += [f"{head}{major + 1}.{n}" for n in range(1, 6)]

    out = []
    for s in stems:
        out.append(f"{s}{tail}")   # keep the trailing word: glm-5-flash
        if tail:
            out.append(s)          # …and drop it: glm-5 (how glm-5.2 is named)
    seen = set()
    return [c for c in out if not (c in seen or seen.add(c))]


def cmd_prune(args, reserve, families, keep, ctx):
    # Treat EVERY os/hardware key as "wanted", not just this host's: a mac
    # checkout must not delete the nvfp4 build a Linux box pulled (and vice
    # versa) just because it resolves to a different tag here.
    wanted = set()
    for members in families.values():
        for m in members or []:
            for k in OS_KEYS:
                if m.get(k):
                    wanted.add(m[k].lower())
    wanted |= keep
    orphans = sorted(t for t in installed_models() if t.lower() not in wanted)
    if not orphans:
        print("no orphans: every installed model is in the manifest")
        return
    print(f"{len(orphans)} installed model(s) not in the manifest:")
    for t in orphans:
        print(f"  {t}")
    if not args.remove:
        print("\n(use `ollama-models prune --remove` to delete these)")
        return
    ans = input(f"\nremove all {len(orphans)} model(s)? this frees disk but is "
                f"irreversible [y/N] ")
    if ans.strip().lower() != "y":
        print("aborted")
        return
    for t in orphans:
        print(f"  rm {t}")
        subprocess.run(["ollama", "rm", t])


# ── entrypoint ──────────────────────────────────────────────────────────────
def main():
    p = argparse.ArgumentParser(prog="ollama-models", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--manifest", type=Path,
                   default=Path(os.environ.get("OLLAMA_MODELS_MANIFEST", default_manifest())))
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("sync", help="pull manifest models for this OS")
    s.add_argument("--refresh", action="store_true", help="re-pull all (update), not just missing")
    s.add_argument("--dry-run", action="store_true", help="print what would be pulled")
    s.set_defaults(func=cmd_sync)

    sub.add_parser("status", help="show installed/missing/skipped").set_defaults(func=cmd_status)

    c = sub.add_parser("check", help="diff manifest vs upstream tags")
    c.add_argument("--next-gen", action="store_true", help="probe for newer family generations")
    c.set_defaults(func=cmd_check)

    pr = sub.add_parser("prune", help="find installed models not in the manifest")
    pr.add_argument("--remove", action="store_true", help="delete the orphans (confirmed)")
    pr.set_defaults(func=cmd_prune)

    args = p.parse_args()
    reserve, families, keep, ctx = load_manifest(args.manifest)
    args.func(args, reserve, families, keep, ctx)


if __name__ == "__main__":
    main()
