#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["pyyaml"]
# ///
"""browser-ext — manage and audit a browser topic's extension manifest.

Run as a uv single-file script: the shebang invokes `uv run --script`, which
resolves the `pyyaml` dependency above into a cached ephemeral venv. uv is
provided by mise (apps/mise/files/config.toml -> [tools] uv). Nothing is
installed into a global Python.

The manifest (apps/<topic>/defaults/main.yaml) is the single source of truth.
Every extension is one entry in `<topic>_extensions`, discriminated by `source`:

  source: store   installed from the browser's marketplace, seeded by Ansible
  source: git     cloned from a repo, optionally built, loaded by hand once

Subcommands:
  status [--profile NAME]   manifest vs reality: which store extensions are
                            installed per profile, whether each git extension is
                            cloned / at its pinned ref / built / loaded, and
                            whether seeds are in place
  drift  [--strict]         extensions installed but claimed by nothing in the
                            manifest. `review`-verdict entries are listed too,
                            since an unresolved decision is a standing question.
                            --strict exits 1 on unreviewed drift, for CI.
  seeds                     what is in the External Extensions directory
  add store <id> | add git <repo-url>
                            append a new entry to the manifest, preserving its
                            comments. Resolves the name from an already-installed
                            copy (store) or the repo (git), and picks the latest
                            tag when --ref is omitted.
  sync   [--slug S]         fetch + check out + build git extensions without a
                            full Ansible run. Same operations as --tags upgrade.

── Why this tool never touches Chrome's own state ───────────────────────────
It cannot install, enable, disable, or remove an extension, and that is
deliberate rather than unfinished. Chrome stores extension state in
`Secure Preferences` under per-entry HMACs plus a `super_mac` over the whole
block, specifically so that software other than Chrome cannot edit it. Writing
there does not give you a configured extension; it gives you a profile Chrome
resets on next launch. Seeding is Ansible's job via External Extensions JSON;
every other transition is a click in chrome://extensions.

Manifest location: $BROWSER_EXT_MANIFEST, else --manifest, else the
defaults/main.yaml two directories up from this script.

TODO: the same manifest schema should drive editor extensions (VS Code, Cursor,
JetBrains). See apps/chrome/TODO-ide-extensions.md — deferred, not overlooked.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

try:
    import yaml
except ImportError:
    sys.exit(
        "error: PyYAML not available.\n"
        "  This script expects to run under `uv run --script` (see the shebang),\n"
        "  which resolves its own dependencies. Run it as ./browser-ext,\n"
        "  not as `python browser-ext`."
    )

HOME = Path.home()
CHROME_DIR = HOME / "Library" / "Application Support" / "Google" / "Chrome"

LOCATION_UNPACKED = 4
LOCATION_NAMES = {
    1: "webstore",
    2: "external-pref",
    3: "external-registry",
    4: "unpacked",
    5: "external-pref-download",
    6: "external-policy-download",
    7: "component",
    8: "external-policy",
    10: "external-component",
}


def require(*cmds: str) -> None:
    """Fail once, naming every missing dependency, before doing any work.

    Per docs/CONVENTIONS.md: a standalone script checks every tool it shells out
    to up front. Exits 127, the conventional "command not found" status.
    """
    missing = [c for c in cmds if shutil.which(c) is None]
    if missing:
        print(
            f"{Path(__file__).name}: missing dependencies: {' '.join(missing)}",
            file=sys.stderr,
        )
        sys.exit(127)


# ── colour ──────────────────────────────────────────────────────────────────
_TTY = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


def _c(code: str, text: str) -> str:
    return f"\033[{code}m{text}\033[0m" if _TTY else text


def ok(t):
    return _c("32", t)


def warn(t):
    return _c("33", t)


def bad(t):
    return _c("31", t)


def dim(t):
    return _c("2", t)


def bold(t):
    return _c("1", t)


def tag(text: str, colour, width: int = 12) -> str:
    """Pad to width BEFORE colouring — ANSI codes count toward str width."""
    return colour(text.ljust(width))


# ── manifest ────────────────────────────────────────────────────────────────
# defaults/main.yaml is written for Ansible, so a few values carry Jinja. Rather
# than pull in Jinja2 for three substitutions, resolve the small set of names
# the file actually uses. Anything unresolved is reported rather than silently
# passed through as a literal `{{ ... }}` path.
_JINJA = re.compile(r"\{\{\s*(.*?)\s*\}\}")
_HOME_EXPRS = {
    "ansible_facts['env']['HOME']",
    'ansible_facts["env"]["HOME"]',
}


def _resolve(value, scope: dict) -> str:
    if not isinstance(value, str):
        return value

    def sub(m: re.Match) -> str:
        expr = m.group(1)
        if expr in _HOME_EXPRS:
            return str(HOME)
        if expr in scope:
            return _resolve(scope[expr], scope)
        raise KeyError(expr)

    for _ in range(4):
        new = _JINJA.sub(sub, value)
        if new == value:
            return new.strip()
        value = new
    return value.strip()


class Manifest:
    """A topic's extension manifest, plus the knowledge of how to append to it."""

    def __init__(self, path: Path, topic: str):
        self.path = path
        self.topic = topic
        if not path.exists():
            sys.exit(f"error: manifest not found: {path}")
        try:
            raw = yaml.safe_load(path.read_text()) or {}
        except yaml.YAMLError as e:
            sys.exit(f"error: manifest is not valid YAML ({path}): {e}")

        scope = {k: v for k, v in raw.items() if isinstance(v, str)}
        try:
            for key in (f"{topic}_external_extensions_dir", f"{topic}_unpacked_root"):
                if key in raw:
                    raw[key] = _resolve(raw[key], scope)
        except KeyError as e:
            sys.exit(
                f"error: manifest uses a Jinja expression this tool cannot resolve: {e}.\n"
                "  Keep paths limited to HOME and plain top-level variables,\n"
                "  or teach _resolve() the new name."
            )
        self.raw = raw

    @property
    def key(self) -> str:
        return f"{self.topic}_extensions"

    @property
    def entries(self) -> list[dict]:
        return self.raw.get(self.key) or []

    def by_source(self, source: str) -> list[dict]:
        return [e for e in self.entries if e.get("source") == source]

    @property
    def ignored(self) -> dict[str, dict]:
        return {e["id"]: e for e in (self.raw.get(f"{self.topic}_extensions_ignored") or [])}

    @property
    def seed_dir(self) -> Path:
        return Path(self.raw.get(f"{self.topic}_external_extensions_dir") or "")

    @property
    def unpacked_root(self) -> str:
        return self.raw.get(f"{self.topic}_unpacked_root") or ""

    def clone_dir(self, entry: dict) -> Path:
        return Path(self.unpacked_root) / entry["slug"]

    def load_dir(self, entry: dict) -> Path:
        return self.clone_dir(entry) / entry.get("load_subdir", ".")

    def append_entry(self, block: str) -> None:
        """Insert a rendered YAML entry at the end of the `<topic>_extensions` list.

        Done as a text edit rather than a yaml.dump round-trip on purpose: this
        file is more comment than data, and every one of those comments explains
        a constraint someone paid to discover. A dump would delete all of them.
        """
        lines = self.path.read_text().splitlines(keepends=True)
        start = next(
            (i for i, ln in enumerate(lines) if ln.startswith(f"{self.key}:")),
            None,
        )
        if start is None:
            sys.exit(f"error: no `{self.key}:` key in {self.path}")

        # The list ends at the next line that starts a new top-level key or a
        # top-level comment block — i.e. the first non-indented, non-blank line.
        end = len(lines)
        for i in range(start + 1, len(lines)):
            ln = lines[i]
            if ln.strip() and not ln.startswith((" ", "\t")):
                end = i
                break

        # Trim trailing blanks inside the block, then re-add exactly one.
        while end > start + 1 and not lines[end - 1].strip():
            end -= 1

        lines[end:end] = ["\n" + block.rstrip() + "\n"]
        self.path.write_text("".join(lines))


def default_manifest_path(topic: str) -> Path:
    env = os.environ.get("BROWSER_EXT_MANIFEST")
    if env:
        return Path(env)
    here = Path(__file__).resolve().parent.parent  # files/ -> apps/<topic>/
    if here.name == topic:
        return here / "defaults" / "main.yaml"
    return here.parent / topic / "defaults" / "main.yaml"


# ── Chrome state ────────────────────────────────────────────────────────────
def profiles() -> list[dict]:
    # Chrome keeps internal profiles alongside the real ones. They hold no user
    # extensions and reporting them just pads every run with empty sections.
    INTERNAL = {"System Profile", "Guest Profile"}

    local_state = CHROME_DIR / "Local State"
    info: dict = {}
    if local_state.exists():
        try:
            info = (
                json.loads(local_state.read_text()).get("profile", {}).get("info_cache", {}) or {}
            )
        except (json.JSONDecodeError, OSError):
            info = {}

    found = []
    for d in sorted(CHROME_DIR.glob("*")):
        if not d.is_dir() or d.name in INTERNAL:
            continue
        if not (d / "Preferences").exists() and not (d / "Secure Preferences").exists():
            continue
        meta = info.get(d.name, {})
        found.append(
            {
                "dir": d.name,
                "path": d,
                "name": meta.get("name") or d.name,
                "email": meta.get("user_name") or "",
            }
        )
    return found


def installed(profile_path: Path) -> dict[str, dict]:
    """Extension settings for one profile, merged across both prefs files.

    Unpacked extensions and most real state live in `Secure Preferences`;
    `Preferences` carries the rest. Reading both avoids a profile looking empty
    just because Chrome happened to file an entry in the other one.
    """
    out: dict[str, dict] = {}
    for fn in ("Preferences", "Secure Preferences"):
        p = profile_path / fn
        if not p.exists():
            continue
        try:
            data = json.loads(p.read_text())
        except (json.JSONDecodeError, OSError):
            continue
        for eid, v in (data.get("extensions", {}).get("settings", {}) or {}).items():
            if isinstance(v, dict):
                out.setdefault(eid, {}).update(v)
    return out


def is_user_extension(entry: dict) -> bool:
    """True for extensions a person chose, false for Chrome's own furniture.

    Chrome files its bundled components (Web Store, PDF Viewer, Hangouts,
    Gemini, the TTS engine) in the same extensions.settings block as real
    extensions, so location alone does not separate them — components and
    Ansible-seeded extensions BOTH land on location 5. The field that does
    separate them is `from_webstore`: true for anything that came from the
    store by any route, false for the furniture. Unpacked extensions never
    touch the store, so they are admitted on location instead.
    """
    return bool(entry.get("from_webstore")) or entry.get("location") == LOCATION_UNPACKED


def display_name(eid: str, entry: dict, profile_path: Path) -> str:
    """Best-effort human name for an extension.

    Store extensions keep their manifest under Extensions/<id>/<version>/, and
    localized ones put __MSG_key__ in `name`, so the real string has to come out
    of _locales. Unpacked ones are read straight from their source path.
    """
    manifest = None
    path = entry.get("path", "")
    if entry.get("location") == LOCATION_UNPACKED and path.startswith("/"):
        mf = Path(path) / "manifest.json"
        if mf.exists():
            try:
                manifest = json.loads(mf.read_text())
            except (json.JSONDecodeError, OSError):
                manifest = None
    if manifest is None:
        if isinstance(entry.get("manifest"), dict):
            manifest = entry["manifest"]
        else:
            versions = sorted((profile_path / "Extensions" / eid).glob("*/manifest.json"))
            if versions:
                try:
                    manifest = json.loads(versions[-1].read_text())
                except (json.JSONDecodeError, OSError):
                    manifest = None
    if not manifest:
        return "?"

    name = manifest.get("name", "?")
    if isinstance(name, str) and name.startswith("__MSG_"):
        key = name[6:-2]
        root = Path(path) if path.startswith("/") else None
        if root is None:
            versions = sorted((profile_path / "Extensions" / eid).glob("*/manifest.json"))
            root = versions[-1].parent if versions else None
        if root:
            for loc in (manifest.get("default_locale", "en"), "en", "en_US"):
                msgs = root / "_locales" / loc / "messages.json"
                if not msgs.exists():
                    continue
                try:
                    table = json.loads(msgs.read_text())
                except (json.JSONDecodeError, OSError):
                    break
                for k, val in table.items():
                    if k.lower() == key.lower():
                        return val.get("message", name)
                break
    return name


def find_name_anywhere(eid: str) -> str | None:
    """Resolve a store extension's name from any profile that already has it."""
    for p in profiles():
        entry = installed(p["path"]).get(eid)
        if entry:
            n = display_name(eid, entry, p["path"])
            if n and n != "?":
                return n
    return None


# ── git helpers ─────────────────────────────────────────────────────────────
def git(*args: str, cwd: Path | None = None, check: bool = True) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["git", *args],
        cwd=str(cwd) if cwd else None,
        capture_output=True,
        text=True,
        check=check,
    )


def head_ref(clone: Path) -> str:
    """What the clone is actually on: a tag if one points at HEAD, else a SHA."""
    try:
        tags = git("tag", "--points-at", "HEAD", cwd=clone, check=False).stdout.split()
        if tags:
            return tags[0]
        return git("rev-parse", "--short", "HEAD", cwd=clone, check=False).stdout.strip() or "?"
    except OSError:
        return "?"


def _semver_key(tag: str):
    nums = [int(n) for n in re.findall(r"\d+", tag)]
    return nums or [0]


def latest_tag(repo: str) -> str | None:
    try:
        out = git("ls-remote", "--tags", "--refs", repo, check=False).stdout
    except OSError:
        return None
    tags = [ln.split("refs/tags/")[-1] for ln in out.splitlines() if "refs/tags/" in ln]
    return max(tags, key=_semver_key) if tags else None


# ── reporting ───────────────────────────────────────────────────────────────
def profile_label(p: dict) -> str:
    tail = f" <{p['email']}>" if p["email"] else ""
    return f"{bold(p['name'])}{tail} {dim('(' + p['dir'] + ')')}"


def short_label(p: dict) -> str:
    """Two profiles here can share a display name; the directory disambiguates."""
    return f"{p['name']} ({p['dir']})"


def cmd_status(m: Manifest, args) -> int:
    store = m.by_source("store")
    gits = m.by_source("git")
    root = m.unpacked_root

    profs = profiles()
    needle = getattr(args, "profile", None)
    if needle:
        low = needle.lower()
        profs = [p for p in profs if low in p["name"].lower() or low in p["dir"].lower()]
        if not profs:
            sys.exit(f"error: no profile matching {needle!r}")

    for p in profs:
        inst = installed(p["path"])
        print(f"\n{profile_label(p)}")

        for e in store:
            here = e["id"] in inst
            print(
                f"  {tag('installed', ok) if here else tag('absent', dim)} "
                f"{e['name']} {dim(e['id'])}"
            )

        # Unpacked extensions are reported as Chrome actually has them, not per
        # manifest entry: the interesting cases are precisely the ones the
        # manifest does NOT name — a stale path, or a copy loaded from somewhere
        # volatile that will fork a new ID the next time it moves.
        for eid, v in sorted(inst.items()):
            if v.get("location") != LOCATION_UNPACKED:
                continue
            raw = v.get("path", "")
            if not raw.startswith("/"):
                continue
            src = Path(raw)
            if not (src / "manifest.json").exists():
                print(f"  {tag('stale', bad)} {src.name} {dim(eid)}")
                print(f"  {'':<12} {src} {dim('— source gone')}")
                continue
            if root and raw.startswith(root):
                state, note = tag("loaded", ok), str(src)
            else:
                state, note = tag("volatile", warn), f"{src} {dim('— not under ' + root)}"
            print(f"  {state} {display_name(eid, v, p['path'])} {dim(eid)}")
            print(f"  {'':<12} {note}")

    # Git extensions are a fact about the machine, not about any one profile.
    if gits:
        print(f"\n{bold('Git sources')} {dim(root)}")
        for e in gits:
            clone, load = m.clone_dir(e), m.load_dir(e)
            if not (clone / ".git").exists():
                print(f"  {tag('missing', bad)} {e['name']}")
                print(f"  {'':<12} {dim('not cloned — run the topic or `browser-ext sync`')}")
                continue
            at = head_ref(clone)
            pinned = e.get("ref", "?")
            ref_state = ok(at) if at == pinned else warn(f"{at} (pinned {pinned})")
            built = (load / "manifest.json").exists()
            print(
                f"  {tag('cloned', ok) if built else tag('unbuilt', warn)} "
                f"{e['name']} {dim('@')} {ref_state}"
            )
            print(f"  {'':<12} {dim('load: ' + str(load))}")
            if not built:
                print(f"  {'':<12} {warn('no manifest.json in load dir — build has not run')}")

    if m.seed_dir:
        print(f"\n{bold('Seeds')} {dim(str(m.seed_dir))}")
        if not m.seed_dir.exists():
            print(f"  {dim('directory does not exist — nothing seeded yet')}")
        else:
            present = {f.stem for f in m.seed_dir.glob("*.json")}
            for e in store:
                seeded = e["id"] in present
                print(f"  {tag('seeded', ok) if seeded else tag('not seeded', warn)} {e['name']}")
            for extra in sorted(present - {e["id"] for e in store}):
                print(f"  {tag('orphan', warn)} {extra} {dim('(no manifest entry)')}")
    return 0


def cmd_drift(m: Manifest, args) -> int:
    wanted = {e["id"] for e in m.by_source("store")}
    ignored = m.ignored

    # Keyed by id, so one extension across four profiles is one finding that
    # names the profiles — not four lines saying the same thing.
    unknown: dict[str, dict] = {}
    review: dict[str, dict] = {}

    for p in profiles():
        for eid, v in installed(p["path"]).items():
            if eid in wanted or not is_user_extension(v):
                continue
            if v.get("location") == LOCATION_UNPACKED:
                continue  # covered by status, which knows about paths
            if eid in ignored:
                entry = ignored[eid]
                if entry.get("verdict") == "review":
                    row = review.setdefault(
                        eid,
                        {"name": entry.get("name", eid), "why": entry.get("why", ""), "in": []},
                    )
                    row["in"].append(short_label(p))
                continue
            row = unknown.setdefault(
                eid,
                {
                    "name": display_name(eid, v, p["path"]),
                    "loc": LOCATION_NAMES.get(v.get("location"), "?"),
                    "in": [],
                },
            )
            row["in"].append(short_label(p))

    if review:
        print(bold("\nUnresolved — decide, then move into the manifest or uninstall"))
        for eid, row in sorted(review.items(), key=lambda kv: kv[1]["name"]):
            print(f"  {tag('review', warn)} {row['name']} {dim(eid)}")
            print(f"  {'':<12} {dim('in: ' + ', '.join(row['in']))}")
            if row["why"]:
                print(f"  {'':<12} {dim(' '.join(row['why'].split()))}")

    if unknown:
        print(bold("\nUnclaimed — installed but named nowhere in the manifest"))
        for eid, row in sorted(unknown.items(), key=lambda kv: kv[1]["name"]):
            print(f"  {tag('drift', bad)} {row['name']} {dim(eid)} [{row['loc']}]")
            print(f"  {'':<12} {dim('in: ' + ', '.join(row['in']))}")
        print(
            dim(
                f"\n  `browser-ext add store <id>` to adopt one, or add it to\n"
                f"  {m.topic}_extensions_ignored with a verdict."
            )
        )
    elif not review:
        print(ok("\nNo drift — every installed extension is claimed by the manifest."))

    return 1 if (unknown and args.strict) else 0


def cmd_seeds(m: Manifest, args) -> int:
    print(f"{bold('External Extensions')} {dim(str(m.seed_dir))}")
    if not m.seed_dir.exists():
        print(f"  {dim('directory does not exist — run the topic to create it')}")
        return 0
    files = sorted(m.seed_dir.glob("*.json"))
    if not files:
        print(f"  {dim('(empty)')}")
    by_id = {e["id"]: e["name"] for e in m.by_source("store")}
    for f in files:
        try:
            url = json.loads(f.read_text()).get("external_update_url", "")
        except (json.JSONDecodeError, OSError):
            url = bad("unreadable")
        print(f"  {f.stem}  {by_id.get(f.stem, warn('orphan — no manifest entry'))}")
        print(f"    {dim(url)}")
    return 0


# ── mutation ────────────────────────────────────────────────────────────────
def _yaml_str(s: str) -> str:
    return json.dumps(s, ensure_ascii=False)


def cmd_add(m: Manifest, args) -> int:
    if args.kind == "store":
        eid = args.target.strip()
        # Accept a full Web Store URL as well as a bare ID.
        mo = re.search(r"/detail/(?:[^/]+/)?([a-p]{32})", eid)
        if mo:
            eid = mo.group(1)
        if not re.fullmatch(r"[a-p]{32}", eid):
            sys.exit(
                f"error: {args.target!r} is not a Chrome extension ID.\n"
                "  Expected 32 characters a-p, or a Web Store URL containing one."
            )
        if any(e.get("id") == eid for e in m.by_source("store")):
            print(warn(f"{eid} is already in the manifest — nothing to do."))
            return 0
        name = args.name or find_name_anywhere(eid)
        if not name:
            sys.exit(
                f"error: cannot resolve a name for {eid}. It is not installed in any\n"
                "  local profile, so pass --name explicitly."
            )
        block = (
            f"  - source: store\n"
            f"    id: {eid}\n"
            f"    name: {_yaml_str(name)}\n"
            f"    why: {_yaml_str(args.why or 'TODO: why this machine has it.')}\n"
        )
    else:
        require("git")
        repo = args.target.strip()
        slug = args.slug or re.sub(r"\.git$", "", repo.rstrip("/").split("/")[-1])
        if any(e.get("slug") == slug for e in m.by_source("git")):
            print(warn(f"slug {slug!r} is already in the manifest — nothing to do."))
            return 0
        ref = args.ref or latest_tag(repo)
        if not ref:
            sys.exit(
                f"error: no tags found in {repo} and no --ref given.\n"
                "  A ref is required: tracking a branch means the extension can change\n"
                "  under you on any run. Pass --ref explicitly."
            )
        block = (
            f"  - source: git\n"
            f"    slug: {slug}\n"
            f"    name: {_yaml_str(args.name or slug)}\n"
            f"    repo: {_yaml_str(repo)}\n"
            f"    ref: {ref}\n"
        )
        if args.build:
            block += f"    build: {_yaml_str(args.build)}\n"
        if args.load_subdir:
            block += f"    load_subdir: {args.load_subdir}\n"
        block += f"    why: {_yaml_str(args.why or 'TODO: why this machine has it.')}\n"

    m.append_entry(block)
    print(ok(f"Added to {m.path}:"))
    print(dim(block.rstrip()))
    print(
        "\nNext: review the entry (the `why` is a placeholder), then\n"
        f"  ansible-playbook apps/{m.topic}/playbook.yaml --tags install"
    )
    return 0


def cmd_sync(m: Manifest, args) -> int:
    require("git")
    entries = m.by_source("git")
    if args.slug:
        entries = [e for e in entries if e["slug"] == args.slug]
        if not entries:
            sys.exit(f"error: no git entry with slug {args.slug!r}")
    if not entries:
        print(dim("No git-sourced extensions in the manifest."))
        return 0

    root = Path(m.unpacked_root)
    root.mkdir(parents=True, exist_ok=True)
    rc = 0

    for e in entries:
        clone, load = m.clone_dir(e), m.load_dir(e)
        print(f"\n{bold(e['name'])} {dim('@ ' + e.get('ref', '?'))}")

        if not (clone / ".git").exists():
            print(f"  {dim('cloning ' + e['repo'])}")
            r = git("clone", e["repo"], str(clone), check=False)
            if r.returncode != 0:
                print(f"  {bad('clone failed')}: {r.stderr.strip()}")
                rc = 1
                continue
        else:
            git("fetch", "--tags", "--prune", cwd=clone, check=False)

        before = head_ref(clone)
        r = git("checkout", e["ref"], cwd=clone, check=False)
        if r.returncode != 0:
            print(f"  {bad('checkout failed')}: {r.stderr.strip()}")
            rc = 1
            continue
        after = head_ref(clone)
        moved = before != after
        print(f"  {tag('checkout', ok)} {after}" + (dim(f" (was {before})") if moved else ""))

        build = e.get("build")
        if build and (moved or not (load / "manifest.json").exists()):
            print(f"  {dim('building: ' + build)}")
            env = dict(os.environ)
            env["PATH"] = f"{HOME}/.local/share/mise/shims:{env.get('PATH', '')}"
            b = subprocess.run(build, shell=True, cwd=str(clone), env=env)
            if b.returncode != 0:
                print(f"  {bad('build failed')} — see output above")
                rc = 1
                continue
            print(f"  {tag('built', ok)} {load}")
        elif build:
            print(f"  {tag('build', dim)} {dim('up to date')}")

        if moved:
            print(
                f"  {warn('reload required')} — Chrome does not watch the filesystem.\n"
                f"  {'':<12} Open chrome://extensions and reload it. The ID is unchanged."
            )
    return rc


def main() -> int:
    ap = argparse.ArgumentParser(
        prog="browser-ext",
        description="Manage and audit a browser topic's extension manifest.",
    )
    ap.add_argument("--topic", default="chrome", help="browser topic name (default: chrome)")
    ap.add_argument("--manifest", type=Path, help="path to defaults/main.yaml")
    sub = ap.add_subparsers(dest="cmd")

    s = sub.add_parser("status", help="manifest vs reality")
    s.add_argument("--profile", help="only this profile (name or directory)")

    d = sub.add_parser("drift", help="installed but not claimed by the manifest")
    d.add_argument("--strict", action="store_true", help="exit 1 on unclaimed drift")

    sub.add_parser("seeds", help="inspect the External Extensions directory")

    a = sub.add_parser("add", help="append an entry to the manifest")
    a.add_argument("kind", choices=["store", "git"])
    a.add_argument("target", help="extension ID / Web Store URL, or git clone URL")
    a.add_argument("--name", help="human label (store: resolved locally if omitted)")
    a.add_argument("--why", help="why this machine has it")
    a.add_argument("--slug", help="git: directory name (default: repo name)")
    a.add_argument("--ref", help="git: tag/branch/SHA (default: latest tag)")
    a.add_argument("--build", help="git: build command run after checkout")
    a.add_argument("--load-subdir", dest="load_subdir", help="git: dir the browser loads")

    y = sub.add_parser("sync", help="fetch, check out and build git extensions")
    y.add_argument("--slug", help="only this extension")

    args = ap.parse_args()

    if not CHROME_DIR.exists() and args.cmd not in {"add", "sync"}:
        sys.exit(f"error: no Chrome user directory at {CHROME_DIR}")

    m = Manifest(args.manifest or default_manifest_path(args.topic), args.topic)

    return {
        "status": cmd_status,
        "drift": cmd_drift,
        "seeds": cmd_seeds,
        "add": cmd_add,
        "sync": cmd_sync,
        None: cmd_status,
    }[args.cmd](m, args)


if __name__ == "__main__":
    sys.exit(main())
