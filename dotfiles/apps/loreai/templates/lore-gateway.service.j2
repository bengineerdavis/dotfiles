{# apps/loreai/templates/lore-gateway.service.j2 — systemd USER unit for the
   Lore.AI gateway (Debian), the same ownership as the launchd agent, no
   root (TASK-243). It only fires while the user has a session, so
   install.yaml reports `loginctl enable-linger` rather than changing login
   behaviour (AGENTS.md § Cross-platform). The per-machine env file carries
   the worker model and the OpenRouter key; it is mode 0600, so no
   EnvironmentFile secrets land in the unit itself. #}
[Unit]
Description=Lore.AI persistent-memory gateway (apps/loreai)
After=default.target

[Service]
ExecStart=/bin/sh -c '. {{ loreai_env_file }} && exec {{ loreai_install_dir }}/lore start'
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
