# Machine-local Lore.AI environment — apps/loreai, written {{ ansible_date_time.date }}.
# Sourced by ~/dotfiles/apps/loreai/files/zsh/env.zsh at shell start.
# Each machine answers for itself: delete this file and re-run the topic to
# re-answer the first-install prompts, or edit directly.

# ── Telemetry ────────────────────────────────────────────────────────────────
# Production builds send privacy-filtered operational telemetry to Sentry
# (install ID, path hashes, token usage, cost, traces; never prompts, bodies,
# paths or project names). 0 opts out.
# https://withlore.ai/docs/install/#operational-telemetry
export SENTRY_ENABLED={{ loreai_telemetry_final }}

{% if loreai_inference_final == 'local' -%}
# ── Background workers + upstreams → local server (ollama) ──────────────────
# LORE_UPSTREAM_OLLAMA routes sessions launched through the plugins;
# LORE_WORKER_UPSTREAM pins the background pipeline to the same server.
# 32B+ at Q4 is Lore's stated floor for curation parity; below it, disable
# the curator in .lore.json and run distillation-only.
export LORE_UPSTREAM_OLLAMA="{{ loreai_local_upstream }}"
export LORE_WORKER_UPSTREAM="{{ loreai_local_upstream }}"
{% endif -%}
{% if loreai_worker_model_final | length > 0 -%}
# ── Background-worker model ──────────────────────────────────────────────────
# Lore runs distillation, curation and query expansion through ONE worker
# model (no per-pipeline knob — verified in BYK/loreai source). The pick
# must clear the curation bar; the decision record is in the topic README.
# Exported whenever set, for any inference choice: LORE_WORKER_MODEL is the
# top-priority override independent of where workers run.
export LORE_WORKER_MODEL="{{ loreai_worker_model_final }}"
# Temporary OpenCode workaround: route OpenAI-protocol sessions to OpenRouter.
export LORE_UPSTREAM_OPENAI="{{ loreai_openai_upstream }}"
{% endif -%}
{% if loreai_inference_final == 'openrouter' or loreai_worker_model_final is match('^openrouter/') -%}
# Key resolution: an existing environment wins; a secrets manager is the
# intended home (1Password CLI is installed — fill in the item path and
# uncomment); `llm keys` is the fallback, NOT the source of truth.
if [ -z "${OPENROUTER_API_KEY:-}" ]; then
  # export OPENROUTER_API_KEY="$(op read 'op://<vault>/<item>/credential' 2>/dev/null)"
  export OPENROUTER_API_KEY="$(llm keys get openrouter 2>/dev/null)"
fi
# Sessions may authenticate to Anthropic/OpenAI while workers use OpenRouter.
# Give workers their own credential: the gateway otherwise looks in the
# session's provider-scoped credential store and can run OpenRouter with no
# auth even when OPENROUTER_API_KEY is present (observed 2026-10-27).
if [ -z "${LORE_WORKER_API_KEY:-}" ]; then
  export LORE_WORKER_API_KEY="$OPENROUTER_API_KEY"
fi
{% endif -%}
# ── Reviewed alternates (OpenRouter catalog IDs + prices, 2026-10-21) ───────
# Lore reads ONE worker model — switching is editing LORE_WORKER_MODEL above.
{% for c in loreai_worker_model_candidates -%}
# {{ '%-46s' | format(c.id) }} {{ c.note }}
{% endfor -%}
{% if loreai_worker_model_local_candidates | length > 0 -%}
# Local tier (needs 32B-class hardware; tags house-measured in
# apps/ollama/MODELS.md):
{% for c in loreai_worker_model_local_candidates -%}
# {{ c.id }}
{% endfor -%}
{% endif -%}
