[init]
	defaultBranch = main
	templateDir = {{ .chezmoi.homeDir }}/.git-template
[user]
    email = {{ .email }}
    name = {{ .name }}
[core]
	editor = code --wait
	excludesfile = {{ .chezmoi.homeDir }}/.gitignore_global
[commit]
	template = {{ .chezmoi.homeDir }}/.commit-message-template
# source : https://stackoverflow.com/a/66649559
# linx native (apt) source: 
# https://stackoverflow.com/questions/34119866/setting-up-and-using--as-your-git-difftool-and-mergetool
[merge]
  tool = meld
  # Show the common ancestor in conflict markers, not just the two sides.
  # Without it, "both sides added a line" and "both sides renamed the same
  # line" produce identical markers and opposite correct resolutions — and
  # picking one where you should have kept both silently drops a value other
  # code may already branch on. zdiff3 also hoists the lines both sides agree
  # on out of the conflict region. Needs git 2.35+.
  conflictstyle = zdiff3
[rerere]
  # Record how a conflict was resolved and replay it when the same conflict
  # reappears. Worth more than it looks here: merging a tree of branches
  # surfaces the same conflict once per level, and resolving it by hand each
  # time is a fresh chance to resolve it differently.
  enabled = true
[mergetool]
  prompt = false
  keepBackup = false
  writeToTemp = false
# Labels name each pane. Setting cmd replaces git's built-in meld driver, so
# git judges success by whether $MERGED changed, not by meld's exit code.
[mergetool "meld"]
  cmd = meld \"$LOCAL\" --label=LOCAL \"$MERGED\" --label=MERGED \"$REMOTE\" --label=REMOTE --output \"$MERGED\"
# source: https://stackoverflow.com/a/55882069
[diff]
	tool = meld
[difftool]
	prompt = false
[difftool "meld"]
	cmd = meld \"$LOCAL\" --label=LOCAL \"$REMOTE\" --label=REMOTE
