//
// Why a loader exists at all: apps/dotagents installs the plugin's full
// upstream tree under ~/.agents/plugins/<name>/, including
// .opencode/plugins/<name>.mjs, but dotagents projects only skill links into
// OpenCode (measured 2026-11-17, dotagents 3.4.0). OpenCode auto-discovers
// `*.js` files in this directory, so this file is what connects the two
// without a `plugins` array entry in opencode.jsonc.
//
// The implementation stays upstream's: this file re-exports it, so an upstream
// update arrives by re-running the dotagents topic, never by editing here.
//
// The dependency is resolved at load time from the running user's home rather
// than baked in at deploy time (AGENTS.md § Machine-specific values: let the
// consuming tool expand what it already knows). A hard-coded home directory
// would be silently wrong on any other machine, and a wrong path here fails as
// "plugin not loaded", which looks like the plugin was never installed.
import os from 'node:os';
import path from 'node:path';
import { pathToFileURL } from 'node:url';

const HOME = os.homedir();

const target = path.join(
  HOME,
  '.agents',
  'plugins',
  '{{ opencode_adhd_plugin_source }}',
  '.opencode',
  'plugins',
  '{{ opencode_adhd_plugin_source }}.mjs',
);

const mod = await import(pathToFileURL(target).href);

export default mod.default;
