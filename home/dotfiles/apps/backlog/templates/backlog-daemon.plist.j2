<?xml version="1.0" encoding="UTF-8"?>
<!-- Managed by apps/backlog.
     Per-user launchd agent for the backlog-md-py singleton daemon: the
     shared process that serializes queue mutations across concurrent agent
     sessions (docs/BACKLOG-MIGRATION.md). Runs the daemon in its documented
     foreground mode so launchd owns the lifecycle; the MCP stdio shim
     forwards to it once the runtime record exists. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>{{ backlog_daemon_label }}</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{ backlog_bin }}</string>
    <string>daemon</string>
    <string>run</string>
    <string>--foreground</string>
    <string>--host</string>
    <string>{{ backlog_daemon_host }}</string>
    <string>--port</string>
    <string>{{ backlog_daemon_port }}</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>{{ backlog_logs_dir }}/daemon.log</string>
  <key>StandardErrorPath</key><string>{{ backlog_logs_dir }}/daemon.log</string>
</dict>
</plist>
