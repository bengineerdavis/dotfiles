<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{{ herdr_launchd_label }}</string>

  <key>ProgramArguments</key>
  <array>
    <string>{{ herdr_shims_dir }}/herdr</string>
    <string>server</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ProcessType</key>
  <string>Interactive</string>

  <key>StandardOutPath</key>
  <string>{{ herdr_log_dir }}/server.log</string>

  <key>StandardErrorPath</key>
  <string>{{ herdr_log_dir }}/server.err.log</string>
</dict>
</plist>
