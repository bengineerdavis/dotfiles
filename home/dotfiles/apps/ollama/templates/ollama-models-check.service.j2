# Managed by apps/ollama — one model-set drift check. Triggered by the timer.
# Reads only: it reports tags a family gained upstream and never pulls or edits
# the manifest. Output lands in the journal and in check.log.
[Unit]
Description=Report ollama model drift against upstream
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/bin:%h/.local/bin:/usr/bin:/bin
ExecStart=%h/bin/ollama-models check{% if ollama_model_check_next_gen | default(false) | bool %} --next-gen{% endif %}

StandardOutput=append:%h/.local/share/ollama-models/check.log
StandardError=append:%h/.local/share/ollama-models/check.log
