#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["pyyaml"]
# ///
"""ollama-models — manage the Ollama model set declared in the topic manifest.

Run as a uv single-file script: the shebang invokes `uv run --script`, which
resolves the `pyyaml` dependency above into a cached ephemeral venv. uv is
provided by mise (apps/mise/files/config.toml -> [tools] uv). Nothing is
installed into a global Python.

The manifest (apps/ollama/defaults/main.yaml) is the single source of truth:
families → members, each member carrying one tag per os/hardware key plus
`size_gb`. Keys are tried most-specific-first — on Linux `linux_nvidia` or
`linux_amd` (auto-detected) before the universal `linux` — so a family with no
hardware-specific build just declares `darwin` + `linux` as before. This tool
resolves the manifest for the current host, gates each entry against a RAM/VRAM
budget (total − ollama_ram_reserve_pct), and drives ollama accordingly.

Subcommands:
  sync [--refresh] [--dry-run]   pull manifest models for this OS within budget
                                 (default: only missing ones; --refresh re-pulls all)
  status                          show installed / missing / skipped (oversized)
  check [--next-gen]              diff each family's upstream tags vs the manifest;
                                 flag unknown precision/format keywords; with
                                 --next-gen, probe for newer family generations
  adopt FAMILY --to FAMILY        rewrite the manifest to a newer generation of a
                                 family, preserving every comment. Pulls NOTHING
                                 — the new tags read MISSING until you `sync`.
                                 Gated on ollama_model_update_scope; --dry-run
                                 prints the diff and writes nothing.

  `status` and `check` both end by reporting ROLE DRIFT: any tag named in
  `ollama_roles` that no family declares. Such a pick is unpullable by `sync`
  and looks like an orphan to `prune` — see role_drift() for why that matters.
  prune [--remove]                list installed models not in the manifest;
                                 --remove deletes them (with confirmation).
                                 Tags listed under `ollama_prune_keep` (bare
                                 :latest aliases, pinned experiments) are never
                                 listed. Tags for OTHER hosts' hardware keys are
                                 kept too, so pruning on a mac cannot delete the
                                 nvfp4 builds a Linux box pulled.

Manifest location: $OLLAMA_MODELS_MANIFEST, else --manifest, else the
defaults/main.yaml two dirs up from this script.

Exit codes: 0 did it (or there was nothing to do) · 1 error · 2 usage error
(argparse's own) · 3 refused, by policy, by scope, or because nobody was there
to confirm.
"""
from __future__ import annotations

import argparse
import copy
import difflib
import hashlib
import os
import platform
import re
import subprocess
import sys
import urllib.error
import urllib.request
from collections import namedtuple
from pathlib import Path

try:
    import yaml
except ImportError:
    sys.exit(
        "error: PyYAML not available.\n"
        "  this script is meant to run via uv (`uv run --script`); ensure uv is\n"
        "  installed (provided by mise), or run: uv run --script "
        + str(Path(__file__).name)
    )

OLLAMA_COM = "https://ollama.com"
REGISTRY = "https://registry.ollama.ai"
UA = "ollama-models/1.0 (+dotfiles)"

# Tokens that may appear after the size in a tag and are already understood.
# Anything else is surfaced by `check` as a possible NEW precision/feature.
KNOWN_TOKENS = {
    # precision / quantization
    "mlx", "bf16", "fp16", "fp8", "fp4", "mxfp8", "mxfp4", "nvfp4", "qat",
    "int4", "int8", "q2_k", "q3_k_s", "q3_k_m", "q3_k_l", "q4_0", "q4_1",
    "q4_k_s", "q4_k_m", "q5_0", "q5_1", "q5_k_s", "q5_k_m", "q6_k", "q8_0",
    # role / variant
    "it", "instruct", "think", "thinking", "coding", "code", "base", "chat",
    "mtp", "cloud", "latest", "distill", "qwen", "vl", "embedding", "reranker",
    "moe", "h", "micro", "tiny", "small", "reasoning", "vision",
}
SIZE_RE = re.compile(r"^(?:a|e)?\d+(?:\.\d+)?[bm]$|^\d+x\d+b$|^\d+$", re.I)

# ── what an automated run may do about models ───────────────────────────────
# Two axes, both declared in the manifest, because they answer different
# questions and collapsing them would make one of the answers unsayable:
#
#   POLICY  how much say you want — skip / report / prompt / auto
#   SCOPE   what it may act on   — weights / manifest / both
#
# The policy vocabulary predates this tool: playbook.yaml already resolves it
# for the weights refresh, and `prompt` already degrades to `report` without a
# TTY. Both are reused verbatim rather than mirrored, so the CLI and an ansible
# run reach the same decision instead of two that drift.
#
# Scope defaults to `weights`, which is exactly what the policy governed before
# this command existed — so a manifest that says nothing keeps its old
# behaviour, and rewriting the manifest is something you switch on deliberately.
UPDATE_POLICIES = ("skip", "report", "prompt", "auto")
UPDATE_SCOPES = ("weights", "manifest", "both")
Gate = namedtuple("Gate", "policy scope")

# Refused — by policy, by scope, or for want of anyone to confirm. Distinct from
# 1 (something broke) so a caller can tell a deliberate no from a failure, and
# from 2, which argparse hardcodes for a usage error and is not ours to reuse.
REFUSED = 3


def interactive() -> bool:
    """Is there a human to answer a prompt? Both ends, not just one: a piped
    stdout with a live stdin still means nobody sees the diff they are
    approving."""
    return sys.stdin.isatty() and sys.stdout.isatty()


def effective_policy(policy: str) -> str:
    """`prompt` needs someone to answer it; with no TTY it becomes `report`.

    The same degradation playbook.yaml applies, for the same reason: an
    unattended run must not block on a pause, and must not take silence for
    consent either.
    """
    return "report" if policy == "prompt" and not interactive() else policy


# ── manifest ────────────────────────────────────────────────────────────────
def default_manifest() -> Path:
    return Path(__file__).resolve().parent.parent / "defaults" / "main.yaml"


def load_manifest(path: Path):
    if not path.exists():
        sys.exit(f"error: manifest not found: {path}")
    data = yaml.safe_load(path.read_text()) or {}
    reserve = int(data.get("ollama_ram_reserve_pct", 33))
    families = data.get("ollama_models") or {}
    if not isinstance(families, dict):
        sys.exit("error: ollama_models must be a mapping of family -> [members]")
    # Tags that are legitimately installed but deliberately not manifest members
    # (bare `:latest` aliases, hand-pinned experiments). `prune` never lists
    # them; `sync` never pulls them.
    keep = fold(data.get("ollama_prune_keep") or [])
    # Context headroom: how much KV cache to budget for on top of the weights.
    ctx = {
        # What a PREALLOCATING runtime (GGUF) reserves up front, whether or not
        # you use it. Must match the server's OLLAMA_CONTEXT_LENGTH.
        "declared": int(data.get("ollama_ctx_declared_tokens", 32768)),
        # What a LAZY runtime (MLX on macOS) actually holds in typical use.
        "typical": int(data.get("ollama_ctx_typical_tokens", 8192)),
        "kv_default": float(data.get("ollama_kv_kb_per_token_default", 70)),
        # Soft overshoot: a model this far past budget is installed and flagged
        # `tight` rather than skipped outright.
        "tolerance": float(data.get("ollama_budget_tolerance_pct", 15)),
    }
    # Role picks are tags too, and nothing else cross-checks them against the
    # families above — see role_drift().
    roles = data.get("ollama_roles") or {}
    # How much say an automated run gets, and over what. See UPDATE_POLICIES.
    policy = str(data.get("ollama_model_update_policy", "prompt"))
    scope = str(data.get("ollama_model_update_scope", "weights"))
    for name, value, allowed in (
        ("ollama_model_update_policy", policy, UPDATE_POLICIES),
        ("ollama_model_update_scope", scope, UPDATE_SCOPES),
    ):
        if value not in allowed:
            sys.exit(f"error: {name} must be one of {', '.join(allowed)} "
                     f"— got {value!r} ({path})")
    return reserve, families, keep, ctx, roles, Gate(policy, scope)


# ── host facts ──────────────────────────────────────────────────────────────
# Every per-OS/hardware key a manifest member may carry. `resolve()` walks the
# host's priority list (see os_keys) and uses the FIRST key the member defines,
# so `linux` alone still works for families with no hardware-specific build.
OS_KEYS = ("darwin", "linux_nvidia", "linux_amd", "linux")


def gpu_vendor() -> str:
    """'nvidia' | 'amd' | '' for this Linux host (a box may have both; NVIDIA
    wins because nvfp4 is the fastest build we ship)."""
    if nvidia_vram_gb() > 0:
        return "nvidia"
    if amd_vram_gb() > 0:
        return "amd"
    # No vendor tool: fall back to the same /sys PCI probe the ansible topic uses.
    for path in Path("/sys/bus/pci/devices").glob("*/vendor"):
        try:
            vid = path.read_text().strip().lower()
        except OSError:
            continue
        if vid == "0x10de":
            return "nvidia"
        if vid == "0x1002":
            return "amd"
    return ""


# Native FP4 tensor cores arrive with Blackwell — compute capability 10.0 on the
# datacenter B-series, 12.0 on consumer RTX 50xx. On Ampere (8.6) and Ada (8.9)
# NVFP4 is *emulated* through higher-precision kernels with no latency advantage
# over BF16, so an RTX 3090 running an nvfp4 build is strictly worse off than the
# same model as GGUF. `linux_nvidia` therefore means "has real FP4 silicon", not
# merely "is an NVIDIA card"; everything older falls through to `linux`.
BLACKWELL_CC = 10.0


def nvidia_compute_cap() -> float:
    """Highest CUDA compute capability present, or 0.0 if none/unavailable."""
    try:
        out = subprocess.run(
            ["nvidia-smi", "--query-gpu=compute_cap", "--format=csv,noheader"],
            capture_output=True, text=True, check=True,
        ).stdout
    except (subprocess.CalledProcessError, FileNotFoundError):
        return 0.0
    caps = []
    for tok in out.split():
        try:
            caps.append(float(tok))
        except ValueError:
            pass
    return max(caps) if caps else 0.0


def os_keys() -> list[str]:
    """Manifest keys to try, most specific first."""
    if platform.system() == "Darwin":
        return ["darwin"]
    vendor = gpu_vendor()
    if vendor == "nvidia" and nvidia_compute_cap() < BLACKWELL_CC:
        return ["linux"]        # pre-Blackwell: native GGUF beats emulated FP4
    if vendor:
        return [f"linux_{vendor}", "linux"]
    return ["linux"]


def nvidia_vram_gb() -> float:
    """Total VRAM of the largest NVIDIA GPU, or 0 if none / nvidia-smi absent."""
    try:
        out = subprocess.run(
            ["nvidia-smi", "--query-gpu=memory.total", "--format=csv,noheader,nounits"],
            capture_output=True, text=True, check=True,
        ).stdout
    except (subprocess.CalledProcessError, FileNotFoundError):
        return 0.0
    vals = [float(x) for x in out.split() if x.strip().replace(".", "").isdigit()]
    return max(vals) / 1024 if vals else 0.0  # MiB → GiB


def amd_vram_gb() -> float:
    """Total VRAM of the largest AMD GPU, or 0 if none / rocm-smi absent."""
    try:
        out = subprocess.run(
            ["rocm-smi", "--showmeminfo", "vram", "--csv"],
            capture_output=True, text=True, check=True,
        ).stdout
    except (subprocess.CalledProcessError, FileNotFoundError):
        return 0.0
    # CSV rows carry a bytes total; take the largest plausible value.
    vals = [float(x) for x in re.findall(r"\b(\d{9,})\b", out)]
    return max(vals) / 1024**3 if vals else 0.0


def system_ram_gb() -> float:
    if platform.system() == "Darwin":
        out = subprocess.check_output(["sysctl", "-n", "hw.memsize"])
        return int(out) / 1024**3
    try:
        for line in Path("/proc/meminfo").read_text().splitlines():
            if line.startswith("MemTotal"):
                return int(line.split()[1]) / 1024**2  # kB → GiB
    except OSError:
        pass
    return 0.0


def total_ram_gb() -> tuple[float, str]:  # noqa: D401 — see override note below
    """Budget basis, with an explicit override for multi-GPU hosts.

    On a box with two cards of different sizes (a 24GB 3090 and a 16GB 6900XT,
    each behind its own ollama instance) probing the hardware is ambiguous:
    nvidia-smi answers 24 regardless of which instance you are sizing models
    for, so the smaller card would be over-committed. There is no reliable way
    to infer the intended target from OLLAMA_HOST — a port number says nothing
    about the GPU behind it — so it is stated rather than guessed:

        OLLAMA_VRAM_GB=16 OLLAMA_HOST=127.0.0.1:11435 ollama-models status
    """
    override = os.environ.get("OLLAMA_VRAM_GB")
    if override:
        try:
            return float(override), "vram(set)"
        except ValueError:
            pass
    return _probe_ram_gb()


def _probe_ram_gb() -> tuple[float, str]:
    """Budget basis + a label for it. On Mac, unified memory == system RAM. On
    Linux with a discrete GPU, the real inference constraint is VRAM (the linux
    tags are GPU quants); fall back to system RAM for CPU inference otherwise."""
    if platform.system() != "Darwin":
        vram = nvidia_vram_gb() or amd_vram_gb()
        if vram > 0:
            return vram, "vram"
    return system_ram_gb(), "ram"


# ── resolution ──────────────────────────────────────────────────────────────
def member_tag(m: dict, keys: list[str]) -> tuple[str, str] | None:
    """(tag, key_used) for the most specific key this member defines."""
    for k in keys:
        if m.get(k):
            return m[k], k
    return None


def member_size(m: dict, key: str) -> float:
    """`size_gb` is either a scalar (same footprint everywhere) or a mapping of
    OS key -> GB, for members whose per-hardware builds differ materially in
    size (e.g. a 20GB nvfp4 vs the 31GB mxfp8 that AMD/CPU has to fall back to).
    A mapping missing this key falls back to its largest entry, so the budget
    gate stays conservative rather than silently over-committing memory."""
    raw = m.get("size_gb", 0)
    if isinstance(raw, dict):
        if key in raw:
            return float(raw[key])
        return float(max(raw.values())) if raw else 0.0
    return float(raw)


# Builds whose runtime allocates KV cache ON USE rather than at num_ctx.
# Measured: qwen3.6:27b-mlx sits at 19GB with num_ctx=262144 and an empty cache,
# and grew to 22GB only when fed a real 41,683-token prompt. The equivalent GGUF
# (glm-4.7-flash) preallocates: 26GB at num_ctx=131072 with nothing in it.
# These tags are MLX builds (see the NVFP4 note in defaults/main.yaml) and only
# behave lazily under MLX — the same artifact on CUDA preallocates.
LAZY_KV_MARKERS = ("-mlx", "-nvfp4", "-mxfp8")


def kv_gb(m: dict, ctx: dict, tag: str = "", key: str = "") -> float:
    """GB of KV cache this member needs at the budgeting context length.

    Lazy (MLX) members are budgeted at the TYPICAL context, because they only
    pay for tokens actually used; preallocating members are budgeted at the
    DECLARED context, because they pay it whether used or not. That distinction
    is what lets the gate be lenient without being wishful.

    Weights alone are a misleading gate: `ministral-3:3b` is 4.5GB of weights
    but needs ~33GB at its full 262K window, so it clears a 24GB budget and then
    cannot run. KV cost is per-token and tracks ARCHITECTURE, not parameter
    count — measured here, granite4's hybrid layers cost ~19 KB/token while the
    much smaller ministral-3 costs ~107 KB/token. Members carry a measured
    `kv_kb_per_token` where one exists; the rest fall back to a mid-range
    default. See SIZING.md for the measurements.
    """
    kb = float(m.get("kv_kb_per_token", ctx["kv_default"]))
    lazy = key == "darwin" and any(mk in tag for mk in LAZY_KV_MARKERS)
    tokens = ctx["typical"] if lazy else ctx["declared"]
    return tokens * kb / 1e6


def resolve(families: dict, keys: list[str], budget: float, ram_budget: float = 0.0,
            ctx: dict | None = None):
    """Yield (family, tag, size_gb, kv, fits) for this host, in manifest order.

    `fits` gates on weights + KV at the target context, not on weights alone.

    A member may set `basis: ram` to opt out of the default budget. On a Linux
    host with a discrete GPU the budget is VRAM, which is the right gate for
    anything meant to run *on* the GPU — but wrong for large MoE models that are
    deliberately run on CPU or split across CPU+GPU, where the real limit is
    system RAM. Without this, an 81GB MoE would be gated out by a 24GB card on a
    128GB host. Ignored where no separate RAM budget applies (e.g. macOS unified
    memory, where the two are the same number).
    """
    for family, members in families.items():
        for m in members or []:
            hit = member_tag(m, keys)
            if not hit:
                continue
            tag, key = hit
            size = member_size(m, key)
            limit = ram_budget if (m.get("basis") == "ram" and ram_budget) else budget
            kv = kv_gb(m, ctx, tag, key) if ctx else 0.0
            # Soft ceiling: something a few hundred MB over budget will still
            # run fine, and refusing it is more annoying than useful.
            ceiling = limit * (1 + (ctx["tolerance"] / 100 if ctx else 0))
            yield family, tag, size, kv, size + kv <= ceiling


def installed_models() -> set[str]:
    try:
        out = subprocess.run(
            ["ollama", "list"], capture_output=True, text=True, check=True
        ).stdout
    except (subprocess.CalledProcessError, FileNotFoundError):
        return set()
    names = set()
    for line in out.splitlines()[1:]:
        line = line.strip()
        if line:
            names.add(line.split()[0])
    return names


# Ollama lowercases the tag when it writes a local manifest, so pulling the
# upstream tag `glm-4.7-flash:q4_K_M` lands on disk as `glm-4.7-flash:q4_k_m`.
# Comparing raw strings therefore reports a manifest model as both MISSING and
# an orphan at once — and `prune --remove` would delete a model we want. All
# installed-vs-manifest comparisons go through casefolded names.
def fold(names):
    return {n.lower() for n in names}


# Cloud tags — `:cloud`, `:20b-cloud`, `:0731-cloud` — are HOSTED-ONLY: ollama
# routes them to Ollama's servers and stores no weights on disk. They can never
# satisfy this manifest, whose entire point is a local, reproducible model set
# that works offline and is gated against a RAM/VRAM budget.
#
# They are easy to pick by mistake: they sit in the same tags list as real
# builds and look like ordinary variants. So they are refused at every surface
# rather than silently sitting at MISSING forever — `check` never suggests one,
# and `sync`/`status` name the reason out loud.
def is_cloud_tag(tag: str) -> bool:
    ref = tag.partition(":")[2]
    return ref == "cloud" or ref.endswith("-cloud")


CLOUD_WHY = ("cloud-only: hosted on ollama.com, no local weights — "
             "replace with a local tag (e.g. a -q4_K_M / -mlx / -nvfp4 build)")


def http_get(url: str) -> str:
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=20) as resp:
        return resp.read().decode("utf-8", "replace")


def upstream_tags(family: str) -> set[str]:
    """Scrape the public tags page for a family's available tags."""
    path = family if "/" in family else f"library/{family}"
    html = http_get(f"{OLLAMA_COM}/{path}/tags")
    variants = re.findall(re.escape(family) + r":([A-Za-z0-9][A-Za-z0-9._-]*)", html)
    return {f"{family}:{v}" for v in variants}


# ── digest diff (cheap "has upstream changed?" check for --refresh) ───────────
# Ollama models are content-addressed: a tag points to a small manifest of
# sha256-digested layers, and `ollama pull` only fetches blobs it lacks. So a
# refresh of an unchanged model already transfers ~0 bytes — but it still spawns
# a pull per model. These helpers let --refresh skip that entirely: compare the
# local manifest file's sha256 to the upstream manifest's, and only pull on a
# real difference. registry.ollama.ai serves the manifest as a plain body (no
# Docker-Content-Digest header), so we hash the body ourselves; the header is
# added too when present, and any fetch/parse failure falls back to pulling.
def _registry_ref(tag: str) -> tuple[str, str]:
    """'qwen3.6:27b-mlx' -> ('library/qwen3.6', '27b-mlx'); namespaced tags kept."""
    name, _, ref = tag.partition(":")
    repo = name if "/" in name else f"library/{name}"
    return repo, ref or "latest"


def _ollama_models_root() -> Path:
    root = os.environ.get("OLLAMA_MODELS")
    return Path(root) if root else Path.home() / ".ollama" / "models"


def local_manifest_digest(tag: str) -> str | None:
    repo, ref = _registry_ref(tag)
    p = _ollama_models_root() / "manifests" / "registry.ollama.ai" / repo / ref
    if not p.is_file():
        return None
    return "sha256:" + hashlib.sha256(p.read_bytes()).hexdigest()


def remote_manifest_digests(tag: str) -> set[str] | None:
    """Acceptable upstream digests (body hash + any header), or None on error."""
    repo, ref = _registry_ref(tag)
    url = f"{REGISTRY}/v2/{repo}/manifests/{ref}"
    req = urllib.request.Request(url, headers={
        "User-Agent": UA,
        "Accept": "application/vnd.docker.distribution.manifest.v2+json",
    })
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            digs = {"sha256:" + hashlib.sha256(resp.read()).hexdigest()}
    except (urllib.error.URLError, OSError):
        return None
    hdr = (resp.headers.get("Docker-Content-Digest") or "").strip()
    if hdr:
        digs.add(hdr)
    return digs


def changed_state(tag: str) -> bool | None:
    """True = upstream differs, False = identical, None = couldn't determine."""
    local = local_manifest_digest(tag)
    if not local:
        return None
    remote = remote_manifest_digests(tag)
    if not remote:
        return None
    return local not in remote


# ── commands ────────────────────────────────────────────────────────────────
def declared_tags(families, keep) -> set[str]:
    """Every tag the manifest declares, under EVERY host key, plus prune-keeps.

    All OS keys, not just this host's: a mac checkout must not treat the nvfp4
    build a Linux box pulled as undeclared (and vice versa) just because it
    resolves to a different tag here.
    """
    out = set()
    for members in families.values():
        for m in members or []:
            for k in OS_KEYS:
                if m.get(k):
                    out.add(m[k].lower())
    return out | keep


# ── role → family drift ──────────────────────────────────────────────────────
# `ollama_roles` NAMES tags; `ollama_models` DECLARES them. Nothing tied the two
# together, so a role could point at a tag no family lists — and then `sync`
# never pulls it (a fresh host cannot satisfy that role at all) while `prune`
# counts the already-pulled weights as an orphan and offers to delete them.
# That is exactly how qwen3.8:27b-mlx ended up promoted to chat/vision `best`,
# 18GB on disk, and one `prune --remove` from deletion (2026-08-28).
#
# `openrouter/…` picks are exempt: they are remote escape hatches, resolved by
# ollama-role as "remote" and never installed locally. Cloud tags are exempt
# because they are already refused at every other surface — flagging them here
# too would add noise, not information.
def role_drift(families, keep, roles) -> list[tuple[str, str, str]]:
    """[(role, tier, tag)] for role picks no family declares."""
    declared = declared_tags(families, keep)
    out = []
    for role, spec in (roles or {}).items():
        if not isinstance(spec, dict):
            continue
        for tier, tags in ((spec.get("tiers") or {}) or {}).items():
            for tag in tags or []:
                if tag.startswith("openrouter/") or is_cloud_tag(tag):
                    continue
                if tag.lower() not in declared:
                    out.append((role, tier, tag))
    return out


def report_role_drift(families, keep, roles) -> None:
    drift = role_drift(families, keep, roles)
    if not drift:
        return
    print(f"\n! {len(drift)} role pick(s) declared by no family — `sync` cannot "
          f"pull these, and `prune` counts their weights as orphans:")
    for role, tier, tag in drift:
        print(f"    {role}/{tier}: {tag}")
    print("  fix: add the tag to its family under ollama_models, or to "
          "ollama_prune_keep if it is deliberately hand-pinned.")


def cmd_sync(args, reserve, families, keep, ctx, roles, gate):
    mem, basis = total_ram_gb()
    budget = mem * (100 - reserve) / 100
    # Separate system-RAM budget for members marked `basis: ram` (CPU/split MoE).
    # On macOS the basis is already system RAM, so this is the same number.
    ram_budget = system_ram_gb() * (100 - reserve) / 100
    keys = os_keys()
    have = fold(installed_models())
    print(f"os={'+'.join(keys)}  {basis}={mem:.0f}GB  budget={budget:.0f}GB  "
          f"reserve={reserve}%  mode={'refresh' if args.refresh else 'install-missing'}")
    pulled = skipped = present = unchanged = cloud = 0
    for family, tag, size, kv, fits in resolve(families, keys, budget, ram_budget, ctx):
        if is_cloud_tag(tag):
            print(f"  CLOUD  {tag:<42} NOT PULLED — {CLOUD_WHY}")
            cloud += 1
            continue
        if not fits:
            print(f"  skip   {tag:<42} ({size:.0f}GB weights + {kv:.0f}GB ctx > budget)")
            skipped += 1
            continue
        if tag.lower() in have:
            if not args.refresh:
                present += 1
                continue
            # refresh: only re-pull when the upstream manifest actually differs.
            state = changed_state(tag)
            if state is False:
                print(f"  keep   {tag:<42} (unchanged)")
                unchanged += 1
                continue
            note = "" if state is True else "  (digest unknown → pulling to be safe)"
            print(f"  {'would' if args.dry_run else 'pull '} {tag}{note}")
        else:
            print(f"  {'would' if args.dry_run else 'pull '} {tag}")
        if not args.dry_run:
            rc = subprocess.run(["ollama", "pull", tag]).returncode
            if rc != 0:
                print(f"    ! pull failed (rc={rc})", file=sys.stderr)
            else:
                pulled += 1
    print(f"done: pulled={pulled} unchanged={unchanged} "
          f"already-present={present} skipped-oversized={skipped} "
          f"refused-cloud={cloud}")
    if cloud:
        one = cloud == 1
        print(f"\n  ! {cloud} manifest {'entry references' if one else 'entries reference'} "
              f"a cloud tag and {'was' if one else 'were'} NOT installed.\n"
              f"    This is why {'it does' if one else 'they do'} not show up in "
              f"`ollama list`. Edit defaults/main.yaml to use a local build.")


def cmd_status(args, reserve, families, keep, ctx, roles, gate):
    mem, basis = total_ram_gb()
    budget = mem * (100 - reserve) / 100
    # Separate system-RAM budget for members marked `basis: ram` (CPU/split MoE).
    # On macOS the basis is already system RAM, so this is the same number.
    ram_budget = system_ram_gb() * (100 - reserve) / 100
    keys = os_keys()
    have = fold(installed_models())
    print(f"os={'+'.join(keys)}  {basis}={mem:.0f}GB  budget={budget:.0f}GB  "
          f"reserve={reserve}%  tolerance={ctx['tolerance']:.0f}%\n"
          f"ctx: {ctx['declared']} declared (GGUF, preallocated) / "
          f"{ctx['typical']} typical (MLX, lazy)\n"
          f"(sizes are weights + KV; the budget gates their SUM)\n")
    n_cloud = n_tight = 0
    for fam in families:
        print(f"{fam}:")
        for family, tag, size, kv, fits in resolve({fam: families[fam]}, keys, budget, ram_budget, ctx):
            if is_cloud_tag(tag):
                state = "CLOUD(never)"
                n_cloud += 1
            elif not fits:
                state = "skip(oversized)"
            elif size + kv > budget:
                # Inside tolerance but past the nominal budget — installed, but
                # say so, because it is the first thing to swap under pressure.
                state = "installed(tight)" if tag.lower() in have else "MISSING(tight)"
                n_tight += 1
            elif tag.lower() in have:
                state = "installed"
            else:
                state = "MISSING"
            print(f"  {state:<16} {tag} "
                  f"({size:.0f}+{kv:.1f}={size + kv:.1f}GB)")
    if n_tight:
        print(f"\n~ {n_tight} entr{'y is' if n_tight == 1 else 'ies are'} past the "
              f"{budget:.0f}GB budget but inside the {ctx['tolerance']:.0f}% tolerance — "
              f"they run, but are first to swap under pressure.")
    if n_cloud:
        print(f"\n! {n_cloud} entr{'y' if n_cloud == 1 else 'ies'} marked "
              f"CLOUD(never) will NEVER install — {CLOUD_WHY}.")
    report_role_drift(families, keep, roles)


def cmd_check(args, reserve, families, keep, ctx, roles, gate):
    manifest_by_family = {}
    for family, members in families.items():
        tags = set()
        for m in members or []:
            for k in OS_KEYS:
                if m.get(k):
                    tags.add(m[k])
        manifest_by_family[family] = tags

    for family, have_tags in manifest_by_family.items():
        print(f"\n{family}")
        try:
            up = upstream_tags(family)
        except urllib.error.HTTPError as e:
            print(f"  ! upstream fetch failed: HTTP {e.code}")
            continue
        except (urllib.error.URLError, OSError) as e:
            print(f"  ! upstream fetch failed: {e}")
            continue
        up_lc = fold(up)
        have_lc = fold(have_tags)
        new = sorted(t for t in up if t.lower() not in have_lc and not is_cloud_tag(t))
        gone = sorted(t for t in have_tags if t.lower() not in up_lc)
        # unknown precision/format keywords across all upstream tags
        unknown = set()
        for t in up:
            variant = t.split(":", 1)[1] if ":" in t else ""
            for tok in variant.split("-"):
                if not tok or SIZE_RE.match(tok):
                    continue
                if tok.lower() not in KNOWN_TOKENS:
                    unknown.add(tok)
        if gone:
            print(f"  ⚠ in manifest but gone upstream: {', '.join(gone)}")
        if unknown:
            print(f"  ★ NEW/unknown keyword(s) (possible new feature): "
                  f"{', '.join(sorted(unknown))}")
        if new:
            print(f"  + {len(new)} upstream tag(s) not in manifest:")
            for t in new:
                print(f"      {t}")
        if not (gone or unknown or new):
            print("  ✓ manifest matches upstream")
        if args.next_gen:
            for cand in next_gen_candidates(family):
                try:
                    html = http_get(f"{OLLAMA_COM}/library/{cand}/tags")
                except urllib.error.HTTPError:
                    continue
                except (urllib.error.URLError, OSError):
                    continue
                # A hosted-only family (every tag ends in `-cloud`) cannot
                # replace a local one at any price — say so, so it is not
                # mistaken for an actionable upgrade.
                tags = re.findall(re.escape(cand) + r":([A-Za-z0-9][A-Za-z0-9._-]*)", html)
                local = [t for t in tags if not t.endswith("cloud")]
                # Only offer `adopt` where it could actually run. A candidate
                # that is already a family of its own is one `adopt` would
                # refuse (a family must appear exactly once), and the heuristic
                # produces those routinely — it offers qwen3.8 as a newer
                # qwen3.6 while qwen3.8 sits right above it in the manifest.
                if not local:
                    note = "  (cloud-only — no local weights)"
                elif cand in families:
                    note = "  (already a family here)"
                else:
                    note = f"\n      adopt with: ollama-models adopt {family} --to {cand} --dry-run"
                print(f"  ⬆ newer generation may exist: {cand}{note}")
    report_role_drift(families, keep, roles)


# Version-like number anywhere in the name, with an optional trailing word.
# The old heuristic anchored digits to the END of the family, which silently
# returned NO candidates for 4 of 18 families (glm-4.7-flash, gpt-oss, qwen3-vl,
# embeddinggemma) — that is why glm-5.x was missed — and never probed `X.1`
# when the family had no minor, which is how lfm2 -> lfm2.5 stayed invisible.
_VERSION_RE = re.compile(r"^(?P<head>.*?)(?P<major>\d+)(?:\.(?P<minor>\d+))?(?P<tail>\D*)$")


def next_gen_candidates(family: str) -> list[str]:
    """Plausible newer generations of `family`, most-likely first.

      qwen3.6        -> qwen3.7 … qwen3.9, qwen4, qwen4.1 … qwen4.5
      lfm2           -> lfm2.1 … lfm2.9, lfm3, …          (finds lfm2.5)
      glm-4.7-flash  -> glm-4.8-flash …, glm-5-flash …, and the bare
                        glm-4.8 / glm-5 / glm-5.2 forms   (finds glm-5.2)
      qwen3-vl       -> qwen3.1-vl …, qwen4-vl …, plus bare qwen4
      gpt-oss        -> gpt-oss2, gpt-oss-2, gpt-oss-v2   (no version to bump)

    Renames are out of reach by construction: nothing derives deepseek-v4 from
    deepseek-r1. Those still need a manual look at the library index.
    """
    m = _VERSION_RE.match(family)
    if not m:
        return [f"{family}2", f"{family}-2", f"{family}-v2"]
    head, tail = m.group("head"), m.group("tail") or ""
    major, minor = int(m.group("major")), m.group("minor")

    stems = [f"{head}{major}.{n}"
             for n in range(int(minor) + 1 if minor is not None else 1, 10)]
    stems.append(f"{head}{major + 1}")
    # A new major usually lands with minors soon after (glm-5 -> glm-5.2), but
    # probing 1-9 on both majors doubles the request count for little gain.
    stems += [f"{head}{major + 1}.{n}" for n in range(1, 6)]

    out = []
    for s in stems:
        out.append(f"{s}{tail}")   # keep the trailing word: glm-5-flash
        if tail:
            out.append(s)          # …and drop it: glm-5 (how glm-5.2 is named)
    seen = set()
    return [c for c in out if not (c in seen or seen.add(c))]


# ── rewriting the manifest ──────────────────────────────────────────────────
# Adopting a newer generation is a MANIFEST edit, and the manifest is more
# comment than data: 499 of its 759 lines carry the measured rationale — tok/s
# figures, eval scores, why deepseek-r1:32b was demoted, why glm-4.7-flash left
# the `think` role, PROVISIONAL notes with dates. Those comments are the reason
# the file is trustworthy, so the edit mechanism was chosen by measuring the
# damage each one does to THIS file, not by reputation:
#
#   yaml.safe_load + yaml.dump   deletes all 499 comment lines. Disqualified.
#   ruamel.yaml round-trip       keeps all 499 comment lines, and still rewrites
#                                110 DATA lines on a no-op load-and-dump, tuned
#                                as far as its knobs go (indent(2,4,2), a null
#                                representer, preserve_quotes, width=4096). It
#                                re-emits every flow mapping from the parsed
#                                structure, so `{ gen_tok_s: 103.0, gb: 2.6 }`
#                                loses the column alignment that makes
#                                ollama_model_perf and ollama_remote_cost
#                                readable as tables. 110 lines of collateral to
#                                change 4 is the wrong trade.
#   targeted line surgery        touches the family's own block and nothing
#                                else. Costs no new dependency and reuses the
#                                choice `browser-ext` already made for the same
#                                reason — that file, too, is mostly comments.
#
# The catch with line surgery is that a regex is easy to get subtly wrong, and a
# subtle wrong answer here silently corrupts the one file nobody re-derives. So
# the write is gated: verify_rewrite() has to prove the result is the intended
# one by three independent means before a byte is written, and refuses
# otherwise. Measurements are reproducible — see tests/ollama_models/.
def split_code_comment(line: str) -> tuple[str, str]:
    """Split a YAML line into (code, comment). A `#` inside quotes is data.

    Comments are never rewritten — they hold the rationale, and a family name
    appears in plenty of them (the qwen3-vl note explains itself by comparison
    with qwen3.6). Substitution applies to the code half only.
    """
    quote = ""
    for i, ch in enumerate(line):
        if quote:
            if ch == quote:
                quote = ""
        elif ch in "\"'":
            quote = ch
        elif ch == "#" and (i == 0 or line[i - 1] in " \t"):
            return line[:i], line[i:]
    return line, ""


def family_block(lines: list[str], family: str) -> tuple[int, int] | None:
    """(start, end) line indices of `family:` within ollama_models, or None.

    Members are indented four spaces or more; a sibling family key is indented
    two, and a new section is indented none. So the block ends at the first line
    whose CODE is non-empty and not four-space indented — which leaves blank
    lines and comments inside the span, harmlessly, since neither is rewritten.
    """
    top = next((i for i, ln in enumerate(lines) if ln.startswith("ollama_models:")), None)
    if top is None:
        return None
    key = _yaml_safe_key(family)
    head = re.compile(r"^  " + re.escape(key) + r":\s*($|#)")
    start = next((i for i in range(top + 1, len(lines)) if head.match(lines[i])), None)
    if start is None:
        return None
    end = len(lines)
    for i in range(start + 1, len(lines)):
        code = split_code_comment(lines[i])[0]
        if code.strip() and not code.startswith("    "):
            end = i
            break
    return start, end


def retag_plan(members, family: str, new_family: str) -> list[tuple[str, str]]:
    """[(old_tag, new_tag)] for every OS-keyed tag in the family, de-duplicated.

    Only tags actually prefixed by the family are touched. The manifest states
    that invariant ("every member's tag starts with it"); this enforces it
    rather than assuming it, so a stray tag is left alone and then shows up as
    a leftover in the diff the human reads.
    """
    pairs: list[tuple[str, str]] = []
    seen: set[str] = set()
    for m in members or []:
        for key in OS_KEYS:
            tag = m.get(key)
            if not tag or not tag.startswith(family + ":") or tag in seen:
                continue
            seen.add(tag)
            pairs.append((tag, new_family + tag[len(family):]))
    return pairs


def _yaml_safe_key(name: str) -> str:
    """Quote a family name when bare YAML 1.1 would misparse it as a boolean
    or null (`no`, `yes`, `on`, `off`, `true`, `false`, `null`, `y`, `n`) or
    as a number, so a key written bare would not read back as the same name."""
    lowered = name.lower()
    booleans = {"y", "yes", "n", "no", "true", "false", "on", "off",
                "null", "none", "~"}
    if lowered in booleans or re.fullmatch(
            r"[+-]?\d+(\.\d+)?([eE][+-]?\d+)?", name):
        return f'"{name}"'
    return name


def rewrite_family(text: str, family: str, new_family: str,
                   pairs: list[tuple[str, str]]) -> str:
    """Return `text` with the family key and its member tags renamed in place."""
    lines = text.splitlines(keepends=True)
    span = family_block(lines, family)
    if span is None:
        sys.exit(f"error: no `{family}:` family under ollama_models")
    start, end = span
    for i in range(start, end):
        code, comment = split_code_comment(lines[i])
        if not code.strip():
            continue
        if i == start:
            # The family key only. Its trailing padding is left as-is, so a
            # name of a different length shifts that ONE line's inline comment
            # by the difference. Re-padding was considered and dropped: it
            # would break the `code.replace(family, new_family) == result`
            # oracle in verify_rewrite(), and trading the strongest integrity
            # check for a column of whitespace is the wrong way round. Realign
            # by hand in the same edit if it matters.
            key = _yaml_safe_key(family)
            code = re.sub(r"^(\s*)" + re.escape(key) + r":",
                          lambda m: m.group(1) + _yaml_safe_key(new_family) + ":", code)
        for old, new in pairs:
            # `:` and `-` are in the boundary class, so `qwen3.6:27b-mlx`
            # cannot match inside `qwen3.6:27b-mlx-bf16`.
            #
            # Honest note: mutation testing says this boundary is currently
            # INERT. Deleting either half leaves all 41 tests passing, and not
            # for want of a case — the mutants are equivalent. Every planned
            # substitution is the same `family:` -> `newfamily:` prefix swap,
            # so a match at the wrong offset produces the right answer anyway.
            # It is kept as a guard against a future schema that plans two
            # unrelated substitutions at once, and it is documented as
            # defensive rather than proven, because claiming otherwise would
            # be claiming a test that does not exist. The gate that IS proven
            # is verify_rewrite(), which refuses the write.
            #
            # An earlier draft ALSO sorted the pairs longest-first. That was
            # removed: two mechanisms for one invariant, both untestable
            # because each hid the other.
            code = re.sub(r"(?<![0-9A-Za-z._:/-])" + re.escape(old)
                          + r"(?![0-9A-Za-z._:/-])", lambda m, n=new: n, code)
        lines[i] = code + comment
    return "".join(lines)


def _intended_doc(doc: dict, family: str, new_family: str, mapping: dict) -> dict:
    """`doc` with the family key renamed in place and its member tags mapped.

    Built from the PARSED document rather than from text, so it is an oracle
    independent of the line surgery it is checking.
    """
    out = copy.deepcopy(doc)
    renamed = {}
    for key, members in (out.get("ollama_models") or {}).items():
        if key == family:
            for m in members or []:
                for os_key in OS_KEYS:
                    if m.get(os_key) in mapping:
                        m[os_key] = mapping[m[os_key]]
            renamed[new_family] = members
        else:
            renamed[key] = members
    out["ollama_models"] = renamed
    return out


def verify_rewrite(before: str, after: str, family: str, new_family: str,
                   pairs: list[tuple[str, str]]) -> list[str]:
    """Problems that must stop the write. Empty means the rewrite is clean.

    Three independent checks, because any one of them can be satisfied by a
    wrong answer:

      TEXT       every comment line, and every untouched line, byte-identical;
                 line count unchanged.
      LINE       each changed line is reproduced by a naive whole-string family
                 substitution on its code half — a different implementation
                 from the boundary-aware regex that produced it, so the two
                 disagreeing is a signal rather than a shared blind spot.
      STRUCTURE  the reparsed document equals the intended document computed
                 from the parse, with the family keys still in their original
                 order (dict equality alone would not notice a reordering, and
                 order is what `status` prints in).
    """
    problems: list[str] = []
    b, a = before.splitlines(), after.splitlines()
    if len(b) != len(a):
        return [f"line count changed: {len(b)} -> {len(a)}"]

    cb = [ln for ln in b if ln.lstrip().startswith("#")]
    ca = [ln for ln in a if ln.lstrip().startswith("#")]
    if cb != ca:
        problems.append(f"comment lines changed: {len(cb)} -> {len(ca)}")

    for n, (lb, la) in enumerate(zip(b, a), start=1):
        if lb == la:
            continue
        code_b, com_b = split_code_comment(lb)
        code_a, com_a = split_code_comment(la)
        if com_b != com_a:
            problems.append(f"line {n}: inline comment changed")
        # Two notations, both legitimate retag output: tag strings live inside
        # existing quotes, so they carry the bare name; the family KEY line
        # carries the quoted form when the bare name would misparse (§
        # _yaml_safe_key). The oracle accepts either form per line — anything
        # the retag did not write still matches neither and is refused.
        forms = {code_b.replace(family, new_family),
                 code_b.replace(family, _yaml_safe_key(new_family))}
        if code_a not in forms:
            problems.append(f"line {n}: changed by something other than the retag")

    try:
        doc_b, doc_a = yaml.safe_load(before), yaml.safe_load(after)
    except yaml.YAMLError as e:
        problems.append(f"result is not valid YAML: {e}")
        return problems
    want = _intended_doc(doc_b, family, new_family, dict(pairs))
    if doc_a != want:
        problems.append("the reparsed document is not the intended one")
    if list(doc_a.get("ollama_models") or {}) != list(want.get("ollama_models") or {}):
        problems.append("family order changed")
    return problems


def cmd_adopt(args, reserve, families, keep, ctx, roles, gate):
    old, new = args.family, args.to
    if old not in families:
        sys.exit(f"error: no family `{old}` under ollama_models in {args.manifest}")
    if new == old:
        sys.exit(f"error: --to names the family it already is (`{old}`)")
    if new in families:
        sys.exit(f"error: `{new}` is already a family. A family must appear "
                 f"exactly once — duplicate YAML keys silently discard the "
                 f"earlier block, so merging two is a hand edit.")

    # Scope before policy: "may this tool edit the manifest at all" is a prior
    # question to "how much say do I want over this edit". Both come after the
    # argument checks above, so a typo'd family name is reported as a typo
    # rather than as a policy problem.
    if gate.scope not in ("manifest", "both"):
        print(f"refused: ollama_model_update_scope is `{gate.scope}`, which "
              f"covers weights only.\n"
              f"  Rewriting the manifest stays off until it is asked for. Set\n"
              f"      ollama_model_update_scope: manifest      # or: both\n"
              f"  in {args.manifest}.", file=sys.stderr)
        return REFUSED
    policy = "report" if args.dry_run else effective_policy(gate.policy)
    if policy == "skip":
        print("refused: ollama_model_update_policy is `skip`.", file=sys.stderr)
        return REFUSED

    pairs = retag_plan(families[old], old, new)
    if not pairs:
        print(f"nothing to do: `{old}` declares no tags prefixed `{old}:`")
        return 0

    # Verify the destination exists before proposing it. A newer generation is
    # guessed by a name heuristic (see next_gen_candidates), and a guess that
    # resolves to nothing would otherwise be written into the manifest and only
    # discovered at the next `sync`.
    try:
        upstream = fold(upstream_tags(new))
    except (urllib.error.URLError, OSError) as e:
        print(f"refused: could not read upstream tags for `{new}` ({e}).\n"
              f"  The manifest is not rewritten on an unverified guess.",
              file=sys.stderr)
        return REFUSED
    missing = [n for _, n in pairs if n.lower() not in upstream]
    if missing:
        print(f"refused: {len(missing)} of {len(pairs)} tag(s) have no `{new}` "
              f"build upstream:", file=sys.stderr)
        for tag in missing:
            print(f"    {tag}", file=sys.stderr)
        print(f"  A partial migration leaves the family half-declared, which is "
              f"worse than not starting, so nothing is written. Either wait for "
              f"upstream to publish the rest, or drop those members by hand "
              f"first.\n  `ollama-models check` lists what {new} does publish.",
              file=sys.stderr)
        return REFUSED

    before = args.manifest.read_text()
    after = rewrite_family(before, old, new, pairs)
    problems = verify_rewrite(before, after, old, new, pairs)
    if problems:
        print("ABORTED — the rewrite did not come out clean, so nothing was "
              "written. This is a bug in rewrite_family(), not in your "
              "manifest:", file=sys.stderr)
        for p in problems:
            print(f"    {p}", file=sys.stderr)
        return 1

    diff = "".join(difflib.unified_diff(
        before.splitlines(keepends=True), after.splitlines(keepends=True),
        f"a/{args.manifest.name}", f"b/{args.manifest.name}"))
    if not diff:
        print("nothing to do: the manifest already reads that way")
        return 0
    print(diff, end="")
    before_lines = before.splitlines()
    # Count the original lines that move, not both sides of the diff: "8 of
    # 789" would read as twice the damage actually done.
    touched = sum(1 for b, a in zip(before_lines, after.splitlines()) if b != a)
    n_comments = sum(1 for ln in before_lines if ln.lstrip().startswith("#"))
    print(f"\n{len(pairs)} tag(s) + the family key: {touched} changed line(s) of "
          f"{len(before_lines)}. All {n_comments} comment lines unchanged, "
          f"and the document reparses to the same thing everywhere else.\n"
          f"NO WEIGHTS ARE PULLED — the new tags read MISSING until `sync`.")

    if policy == "report":
        why = ("--dry-run" if args.dry_run
               else f"ollama_model_update_policy is `{gate.policy}`"
               if gate.policy == "report"
               else "no TTY, so `prompt` degraded to `report`")
        print(f"\nnothing written ({why}).", file=sys.stderr)
        # --dry-run got exactly what it asked for; a degraded prompt did not.
        return 0 if args.dry_run else REFUSED
    if policy == "prompt":
        if input(f"\nrewrite {args.manifest}? [y/N] ").strip().lower() not in ("y", "yes"):
            print("aborted; nothing written")
            return REFUSED

    args.manifest.write_text(after)
    print(f"\nwrote {args.manifest}")
    _, fam2, keep2, _, roles2, _ = load_manifest(args.manifest)
    report_role_drift(fam2, keep2, roles2)
    print(f"\nnext: `status` shows the new tags as MISSING · `sync` pulls them · "
          f"`prune` reclaims the {len(pairs)} superseded one(s). Role picks and "
          f"the measured figures in ollama_model_perf still name the OLD tags, "
          f"deliberately: a measurement belongs to the model it was taken on.")
    return 0


def cmd_prune(args, reserve, families, keep, ctx, roles, gate):
    wanted = declared_tags(families, keep)
    orphans = sorted(t for t in installed_models() if t.lower() not in wanted)
    if not orphans:
        print("no orphans: every installed model is in the manifest")
        return
    print(f"{len(orphans)} installed model(s) not in the manifest:")
    for t in orphans:
        print(f"  {t}")
    if not args.remove:
        print("\n(use `ollama-models prune --remove` to delete these)")
        return
    ans = input(f"\nremove all {len(orphans)} model(s)? this frees disk but is "
                f"irreversible [y/N] ")
    if ans.strip().lower() != "y":
        print("aborted")
        return
    for t in orphans:
        print(f"  rm {t}")
        subprocess.run(["ollama", "rm", t])


# ── entrypoint ──────────────────────────────────────────────────────────────
def main():
    p = argparse.ArgumentParser(prog="ollama-models", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--manifest", type=Path,
                   default=Path(os.environ.get("OLLAMA_MODELS_MANIFEST", default_manifest())))
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("sync", help="pull manifest models for this OS")
    s.add_argument("--refresh", action="store_true", help="re-pull all (update), not just missing")
    s.add_argument("--dry-run", action="store_true", help="print what would be pulled")
    s.set_defaults(func=cmd_sync)

    sub.add_parser("status", help="show installed/missing/skipped").set_defaults(func=cmd_status)

    c = sub.add_parser("check", help="diff manifest vs upstream tags")
    c.add_argument("--next-gen", action="store_true", help="probe for newer family generations")
    c.set_defaults(func=cmd_check)

    pr = sub.add_parser("prune", help="find installed models not in the manifest")
    pr.add_argument("--remove", action="store_true", help="delete the orphans (confirmed)")
    pr.set_defaults(func=cmd_prune)

    # `--dry-run` and `ollama_model_update_policy: report` are the same
    # behaviour under two names, and deliberately one implementation: the flag
    # forces the policy rather than branching beside it. The flag exists because
    # "show me" is an ergonomic request that should not need a manifest edit.
    ad = sub.add_parser("adopt", help="retag a family to a newer generation (writes no weights)")
    ad.add_argument("family", help="the family to retag, as it appears under ollama_models")
    ad.add_argument("--to", required=True, metavar="FAMILY",
                    help="the newer family name, e.g. --to qwen3.7")
    ad.add_argument("--dry-run", action="store_true",
                    help="print the diff and write nothing")
    ad.set_defaults(func=cmd_adopt)

    args = p.parse_args()
    reserve, families, keep, ctx, roles, gate = load_manifest(args.manifest)
    sys.exit(args.func(args, reserve, families, keep, ctx, roles, gate) or 0)


if __name__ == "__main__":
    main()
