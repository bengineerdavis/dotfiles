# ~/.local/share/chezmoi/.chezmoi.toml.tmpl
# This template generates your local ~/.config/chezmoi/chezmoi.toml
# Source: https://www.chezmoi.io

# Top-level settings
color = "on"
pager = "bat -l help"

# Add custom variables here to use in your templates
# Example: email = "your@email.com"
{{ $email := promptStringOnce . "email" "Git email — use a work address on a work machine" "bengineerdavis@gmail.com" }}
{{ $name := promptStringOnce . "name" "Git full name" "Ben Davis" }}
{{ $machine := promptStringOnce . "machine" "Machine label — a short name for per-machine config switches" .chezmoi.hostname }}
[data]
    email = "{{ $email }}"
    name = "{{ $name }}"
    machine = "{{ $machine }}"
    # Computed facts, not prompts: the machine already knows these.
    arch = "{{ .chezmoi.arch }}"
    isMac = {{ eq .chezmoi.os "darwin" }}
    distro = "{{ if eq .chezmoi.os "linux" }}{{ .chezmoi.osRelease.id }}{{ end }}"

[diff]
    # Graphical side-by-side comparison using Meld
    # Ref: https://www.chezmoi.io
    command = "meld"
    # Destination = Live file (~/.zshrc) | Target = Calculated state (templates applied)
    args = [
        "--label", "LOCAL (current): {{ "{{" }} .Destination {{ "}}" }}",
        "--label", "CHEZMOI (will write): {{ "{{" }} .Target {{ "}}" }}",
        "--diff",
        "{{ "{{" }} .Destination {{ "}}" }}",
        "{{ "{{" }} .Target {{ "}}" }}"
    ]

[merge]
    # 3-Way Merge: Resolve conflicts between your Repo, Templates, and Disk
    # Ref: https://www.chezmoi.io
    command = "meld"
    # PRO TIP: Merge changes from the outer panes INTO the middle (Source) to save to git.
    args = [
        "--label", "LOCAL (disk): {{ "{{" }} .Destination {{ "}}" }}",
        "--label", "SOURCE (repo): {{ "{{" }} .Source {{ "}}" }}",
        "--label", "TARGET (calculated): {{ "{{" }} .Target {{ "}}" }}",
        "{{ "{{" }} .Destination {{ "}}" }}",
        "{{ "{{" }} .Source {{ "}}" }}",
        "{{ "{{" }} .Target {{ "}}" }}"
    ]

[edit]
    # Use VS Code for 'chezmoi edit'
    # Ref: https://www.chezmoi.io
    command = "code"
    # --wait is critical: chezmoi pauses until you close the tab to apply changes/hooks
    args = ["--wait"]


