#!/bin/zsh

# Pyenv configuration
export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init --path)"
# Only init pyenv-virtualenv when the plugin is actually installed — otherwise
# `pyenv virtualenv-init` errors with "no such command" on every shell start.
[[ -d $PYENV_ROOT/plugins/pyenv-virtualenv ]] && eval "$(pyenv virtualenv-init -)"

# trying to fix freezing comic-app-library window select issues
# see more here: https://github.com/pop-os/cosmic-applibrary/issues/296
export WPGU_BACKEND=gl
