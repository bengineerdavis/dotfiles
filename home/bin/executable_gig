#!/usr/bin/env bash
# gitignore.io fetcher for Bash and Zsh on Mac/Linux
# docs: https://docs.gitignore.io/install/command-line
set -ieu -o pipefail

# Join arguments with commas
# Works in both Bash and Zsh
params=$(echo "$*" | tr ' ' ',')

if [ -z "$params" ]; then
    echo "Usage: gi [type1,type2,...]"
    echo "Example: gi python,macos"
    exit 1
fi

echo "Fetching .gitignore for: $params"
printf "https://www.toptal.com/developers/gitignore/api/%s\n" "$params"

curl -sL "https://www.toptal.com/developers/gitignore/api/$@"
