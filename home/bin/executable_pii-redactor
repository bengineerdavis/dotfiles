#!/usr/bin/env bash
# pii-redactor — deploy shim for the pii-redaction skill's script.
#
# The implementation lives with the skill that specifies it:
#
#   ai-prompt-library/skills/pii-redaction/scripts/pii-redactor
#
# and this file only makes it callable as `pii-redactor` from a shell. That
# split is the author's ruling (2026-11-10): a skill and its tools live
# together where the skill is defined, and a thin bin wrapper that makes the
# tool callable from the terminal belongs in the dotfiles repo.
#
# The wrapper resolves the skill at run time rather than embedding a path, so
# it keeps working across checkouts and worktrees. Search order:
#
#   1. $PII_REDACTOR_SKILL_SCRIPT, for an explicit override
#   2. the dotagents-installed skill copy (what a fresh machine has)
#   3. a local ai-prompt-library checkout
#
# If none is found, say what is missing and where it should be. A wrapper that
# silently does nothing is worse than one that fails loudly.

set -euo pipefail

find_script() {
  if [[ -n "${PII_REDACTOR_SKILL_SCRIPT:-}" ]]; then
    # The override is checked like any other candidate. Returning it verbatim
    # would turn a typo into a bare `exec: ...: No such file or directory`,
    # which does not say what was wrong or how to fix it.
    #
    # `-f` as well as `-x`: a directory passes `-x` (execute on a directory
    # is search permission), so an override with the last component missing
    # would validate and then fail at `exec` with "is a directory".
    [[ -f "$PII_REDACTOR_SKILL_SCRIPT" && -x "$PII_REDACTOR_SKILL_SCRIPT" ]] ||
      return 2
    printf '%s\n' "$PII_REDACTOR_SKILL_SCRIPT"
    return 0
  fi

  local candidate
  for candidate in \
    "${HOME}/.agents/skills/pii-redaction/scripts/pii-redactor" \
    "${HOME}/code/personal/ai-prompt-library/skills/pii-redaction/scripts/pii-redactor"
  do
    if [[ -x "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  return 1
}

# `rc`, not `status`: zsh reserves `status` as a read-only alias for `$?`, so
# assigning it aborts with "read-only variable: status" — which reads like the
# wrapped command failed. The shebang makes bash the normal interpreter, but a
# script that dies when sourced or run under another shell is a trap.
rc=0
target="$(find_script)" || rc=$?

if [[ "$rc" -eq 2 ]]; then
  cat >&2 <<EOF
[ERROR] PII_REDACTOR_SKILL_SCRIPT is set but is not an executable file:

  ${PII_REDACTOR_SKILL_SCRIPT}

Point it at the skill's script:

  ai-prompt-library/skills/pii-redaction/scripts/pii-redactor

or unset it to use the installed skill.
EOF
  exit 1
fi

if [[ "$rc" -ne 0 ]]; then
  cat >&2 <<'EOF'
[ERROR] pii-redactor's implementation was not found.

It lives with the pii-redaction skill, not in this dotfiles repo:

  ai-prompt-library/skills/pii-redaction/scripts/pii-redactor

Install the skill with:

  npx @sentry/dotagents --project install

or point at a checkout explicitly:

  export PII_REDACTOR_SKILL_SCRIPT=/path/to/skills/pii-redaction/scripts/pii-redactor
EOF
  exit 1
fi

exec "$target" "$@"
