#!/usr/bin/env python3
# -----------------------------------------------------------------------------
# quarantine — an encrypted holding area for things a retention rule deleted.
#
# Usage:
#   quarantine init                       create a keypair; print the identity once
#   quarantine put [OPTS] PATH...         archive the paths, then remove them
#   quarantine list                       what is held, and when it expires
#   quarantine peek ID                    list an entry's contents, write nothing
#   quarantine get ID PATH                one file to stdout
#   quarantine restore ID [--into DIR]    decrypt and extract an entry
#   quarantine expire [--dry-run]         delete entries past their expiry
#
# Options:
#   --days N            override the retention window for this entry
#   --reason TEXT       why it was quarantined; stored inside the archive
#   --into DIR          restore destination (default: a new dir under $PWD)
#   --identity-from SPEC  where to read the key; or $QUARANTINE_IDENTITY_FROM
#                         op: | bw: | keychain: | file: | env: | -
#   --keep              put: archive without removing the originals
#
# Examples:
#   quarantine put --reason "log retention" old.db
#   quarantine peek 20260822T1
#   quarantine get 20260822T1 etc/hosts --identity-from keychain:quarantine
#   QUARANTINE_IDENTITY_FROM=op://Private/quarantine/key quarantine restore 2026
#
# Dependencies:       tar, zstd, age (all via the mise topic)
# Exit codes: 0 ok | 1 usage/refused | 2 nothing matched | 127 missing dependency
# -----------------------------------------------------------------------------
#
# WHY THIS EXISTS
# A retention window set slightly too short is otherwise unrecoverable, and that
# risk pushes people to set windows too long — which is the actual hazard. This
# makes expiry reversible for a bounded period, so the window can be honest.
#
# WRITING NEEDS NO SECRET, READING DOES
# Entries are encrypted to an age *public* recipient, so `put` and `expire` run
# unattended with nothing sensitive on disk. Only `restore` needs the private
# identity, which belongs in a password manager and is never written here — the
# one file `init` leaves behind is the public recipient.
#
# That asymmetry is the point: a process that can quarantine data cannot read
# what it or anything else quarantined.
#
# PATHS ARE CONTENT
# The sidecar is deliberately thin — id, timestamps, byte count, item count. No
# filenames, no source paths. A path like
# .../tickets/<customer>/<ticket-id>/mail.md identifies a customer as surely as
# the file's contents do, so the manifest of real paths is written *inside* the
# encrypted archive. This rule exists because the opposite mistake was made
# while auditing the llm log: a source path was read out of a database and
# leaked a customer name into a transcript.
#
# QUARANTINE IS RETENTION
# Holding something encrypted is still holding it. For content under a total
# retention cap — anything work-tagged — quarantine would extend the window past
# the cap while looking like extra safety, so `put` refuses it. See
# dotfiles/policy/personal.yaml (work_tagged_on_expiry: delete).

from __future__ import annotations

import argparse
import contextlib
import getpass
import hashlib
import json
import os
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
from datetime import datetime, timedelta, timezone
from pathlib import Path

STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state"))
STORE = STATE / "quarantine"
RECIPIENTS = STORE / "recipients"

# Used only when the policy layers cannot answer. Not a preference — a floor, so
# a missing resolver cannot silently grant an unbounded hold.
FALLBACK_DAYS = 30
POLICY_KEY = "retention.quarantine_days"

ARCHIVE_SUFFIX = ".tar.zst.age"
MANIFEST_NAME = ".quarantine-manifest.json"

# ---------------------------------------------------------------------------
# Getting the key without putting it on disk
# ---------------------------------------------------------------------------
# age reads identities from stdin with `-i -`, and the ciphertext stays a file
# argument. So the key can travel vault -> pipe -> age and never be written
# anywhere, which is the difference between "encrypted at rest" and "encrypted
# at rest next to its own key".
#
# Backends, given as --identity-from SPEC:
#
#   op:op://Vault/Item/field   1Password CLI. Biometric unlock, no session to manage.
#   bw:<item>                  Bitwarden CLI. Needs BW_SESSION (see `bw unlock`).
#   keychain:<service>         macOS Keychain. Zero install, already present.
#   file:<path>                A key file. Simplest, weakest.
#   env:<VARNAME>              Contents of an environment variable.
#   -                          Read the key from this process's stdin.
#
# $QUARANTINE_IDENTITY_FROM supplies a default so routine use needs no flag.
# There is deliberately no built-in default path: a key discovered automatically
# beside the archive protects only against someone copying the archive alone.
IDENTITY_ENV = "QUARANTINE_IDENTITY_FROM"


def resolve_identity(spec: str | None) -> bytes:
    """Fetch key material for `age -i -`. Never touches the filesystem."""
    spec = spec or os.environ.get(IDENTITY_ENV)
    if not spec:
        die(
            "no identity source. Pass --identity-from SPEC or set "
            f"${IDENTITY_ENV}.\n"
            "  op:op://Vault/Item/field | bw:<item> | keychain:<service> |\n"
            "  file:<path> | env:<VAR> | -\n"
            "  The key was printed once by `quarantine init`."
        )

    if spec == "-":
        data = sys.stdin.buffer.read()
        if not data.strip():
            die("stdin was empty; expected an age identity")
        return data

    kind, _, ref = spec.partition(":")
    if not ref:
        die(f"identity spec {spec!r} needs a reference, e.g. keychain:quarantine")

    if kind == "file":
        path = Path(ref).expanduser()
        if not path.exists():
            die(f"identity file not found: {path}")
        return path.read_bytes()

    if kind == "env":
        val = os.environ.get(ref)
        if not val:
            die(f"${ref} is unset or empty")
        return val.encode()

    cmds = {
        "op": ["op", "read", ref],
        "bw": ["bw", "get", "password", ref],
        "keychain": [
            "security", "find-generic-password", "-a", getpass.getuser(),
            "-s", ref, "-w",
        ],
    }
    if kind not in cmds:
        die(f"unknown identity backend {kind!r}")
    require(cmds[kind][0])
    out = subprocess.run(cmds[kind], capture_output=True)
    if out.returncode != 0:
        msg = out.stderr.decode(errors="replace").strip().splitlines()
        hint = {
            "op": "is 1Password unlocked? try: op signin",
            "bw": "is the vault unlocked? try: export BW_SESSION=$(bw unlock --raw)",
            "keychain": f"try: security add-generic-password -a $USER -s {ref} -w",
        }[kind]
        die(f"{kind} lookup failed: {msg[-1] if msg else out.returncode}\n  {hint}")
    if not out.stdout.strip():
        die(f"{kind} returned an empty value for {ref!r}")
    return out.stdout


def open_archive(archive: Path, identity: bytes):
    """Yield a decrypted, decompressed tar stream. Plaintext stays in pipes."""
    if not archive.exists():
        die(f"archive missing: {archive}\n  the sidecar is present, so the store is inconsistent")
    ag = subprocess.Popen(
        ["age", "-d", "-i", "-", str(archive)],
        stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
    )
    ag.stdin.write(identity)
    ag.stdin.close()
    zs = subprocess.Popen(
        ["zstd", "-dq"], stdin=ag.stdout, stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    ag.stdout.close()
    return ag, zs


@contextlib.contextmanager
def read_archive(archive: Path, identity: bytes):
    """Context-managed tar stream that reports a bad key as an error, not a
    traceback. A wrong identity yields an empty pipe, and tarfile's
    'empty file' ReadError says nothing useful about why."""
    ag, zs = open_archive(archive, identity)
    try:
        try:
            tf = tarfile.open(fileobj=zs.stdout, mode="r|")
        except tarfile.ReadError:
            err = ag.stderr.read().decode(errors="replace").strip()
            die(
                "could not read the archive — wrong identity, or it is damaged"
                + (f"\n  age: {err}" if err else "")
            )
        yield tf
        tf.close()
    finally:
        if zs.stdout:
            zs.stdout.close()
        zs.wait()
        ag.wait()


def die(msg: str, code: int = 1) -> "typing.NoReturn":  # noqa: F821
    print(f"quarantine: {msg}", file=sys.stderr)
    sys.exit(code)


def require(*cmds: str) -> None:
    """Report every missing dependency at once, before doing any work."""
    missing = [c for c in cmds if shutil.which(c) is None]
    if missing:
        die(
            f"missing dependencies: {' '.join(missing)}\n"
            "  install with: mise install  (see dotfiles/apps/mise)",
            127,
        )


def retention_days(override: int | None) -> tuple[int, str]:
    """Window for a new entry: flag, then policy, then the floor."""
    if override is not None:
        return override, "--days"
    if shutil.which("policy"):
        try:
            out = subprocess.run(
                ["policy", "get", POLICY_KEY], capture_output=True, text=True
            )
            if out.returncode == 0:
                return int(out.stdout.split()[0]), "policy"
        except (ValueError, IndexError, OSError):
            pass
    return FALLBACK_DAYS, "fallback"


def recipient() -> str:
    if not RECIPIENTS.exists():
        die("no recipient configured — run `quarantine init` first")
    for line in RECIPIENTS.read_text().splitlines():
        line = line.strip()
        if line and not line.startswith("#"):
            return line
    die(f"{RECIPIENTS} contains no recipient")


def entries() -> list[dict]:
    out = []
    for meta in sorted(STORE.glob("*.json")):
        try:
            d = json.loads(meta.read_text())
        except (json.JSONDecodeError, OSError):
            continue
        d["_meta"] = meta
        # The sidecar is "<id>.tar.zst.age.json", so exactly one suffix comes
        # off. Stripping two also removed ".age" and pointed at a file that
        # never existed, which surfaced as an empty decrypt rather than a
        # missing-file error.
        d["_archive"] = meta.with_suffix("")
        out.append(d)
    return out


# --- commands ---------------------------------------------------------------


def cmd_init(_args) -> int:
    require("age-keygen")
    STORE.mkdir(parents=True, exist_ok=True)
    STORE.chmod(0o700)
    if RECIPIENTS.exists():
        die(f"{RECIPIENTS} already exists — refusing to overwrite a recipient")

    gen = subprocess.run(["age-keygen"], capture_output=True, text=True, check=True)
    identity, pub = "", ""
    for line in gen.stdout.splitlines():
        if line.startswith("AGE-SECRET-KEY"):
            identity = line.strip()
        elif "public key:" in line:
            pub = line.split("public key:")[1].strip()
    if not identity or not pub:
        die("age-keygen output not understood; nothing written")

    RECIPIENTS.write_text(
        "# age public recipient for the quarantine store.\n"
        "# Public by design: writing needs no secret. Safe to commit? No —\n"
        "# it is machine-local because the store it describes is.\n"
        f"{pub}\n"
    )
    RECIPIENTS.chmod(0o600)

    print("Recipient written to:", RECIPIENTS)
    print("\nSTORE THIS IN YOUR PASSWORD MANAGER. It is printed once and not saved:\n")
    print(f"  {identity}\n")
    print("Without it, quarantined entries cannot be restored — by you or anyone.")
    print("\nThen point the tool at wherever you put it, e.g.:")
    print(f"  export {IDENTITY_ENV}=op://Private/quarantine/key      # 1Password")
    print(f"  export {IDENTITY_ENV}=keychain:quarantine              # macOS Keychain")
    print("  security add-generic-password -a $USER -s quarantine -w  # to store it there")
    return 0


def cmd_put(args) -> int:
    require("tar", "zstd", "age")
    if args.work_tagged:
        die(
            "refusing: work-tagged content is capped by the company layer, so\n"
            "  quarantine would extend retention past the cap while looking like\n"
            "  extra safety. Delete it instead. See dotfiles/policy/personal.yaml",
        )

    paths = [Path(p).resolve() for p in args.paths]
    missing = [p for p in paths if not p.exists()]
    if missing:
        die(f"{len(missing)} path(s) do not exist; nothing archived", 2)

    STORE.mkdir(parents=True, exist_ok=True)
    STORE.chmod(0o700)
    rcpt = recipient()
    days, source = retention_days(args.days)

    now = datetime.now(timezone.utc)
    stamp = now.strftime("%Y%m%dT%H%M%SZ")
    digest = hashlib.sha256(
        ("\n".join(str(p) for p in paths) + stamp).encode()
    ).hexdigest()[:8]
    entry_id = f"{stamp}-{digest}"
    archive = STORE / f"{entry_id}{ARCHIVE_SUFFIX}"

    # The manifest carries the real paths, so it goes inside the archive.
    manifest = {
        "id": entry_id,
        "created": now.isoformat(),
        "reason": args.reason or "",
        "host": os.uname().nodename,
        "user": getpass.getuser(),
        "items": [
            {"path": str(p), "bytes": p.stat().st_size if p.is_file() else None}
            for p in paths
        ],
    }

    with tempfile.TemporaryDirectory() as tmp:
        tarball = Path(tmp) / "payload.tar"
        with tarfile.open(tarball, "w") as tf:
            mf = Path(tmp) / MANIFEST_NAME
            mf.write_text(json.dumps(manifest, indent=2))
            tf.add(mf, arcname=MANIFEST_NAME)
            for p in paths:
                # Absolute paths are stored relative to root so restore cannot
                # silently overwrite the original location.
                tf.add(p, arcname=str(p).lstrip("/"))

        # tar -> zstd -> age, so plaintext never lands on disk beyond the tmpdir.
        with open(tarball, "rb") as src, open(archive, "wb") as dst:
            zs = subprocess.Popen(["zstd", "-q", "-T0"], stdin=src, stdout=subprocess.PIPE)
            ag = subprocess.Popen(["age", "-r", rcpt], stdin=zs.stdout, stdout=dst)
            zs.stdout.close()
            if ag.wait() != 0 or zs.wait() != 0:
                archive.unlink(missing_ok=True)
                die("encryption failed; originals left untouched")

    archive.chmod(0o600)
    sidecar = STORE / f"{entry_id}{ARCHIVE_SUFFIX}.json"
    sidecar.write_text(
        json.dumps(
            {
                "id": entry_id,
                "created": now.isoformat(),
                "expires": (now + timedelta(days=days)).isoformat(),
                "retention_days": days,
                "retention_source": source,
                "items": len(paths),
                "bytes": archive.stat().st_size,
            },
            indent=2,
        )
    )
    sidecar.chmod(0o600)

    print(f"quarantined {len(paths)} item(s) -> {entry_id}")
    print(f"  expires in {days}d ({source})   {archive.stat().st_size} bytes")

    if args.keep:
        print("  originals kept (--keep)")
        return 0
    for p in paths:
        shutil.rmtree(p) if p.is_dir() else p.unlink()
    print(f"  originals removed")
    return 0


def cmd_list(_args) -> int:
    rows = entries()
    if not rows:
        print("quarantine is empty")
        return 0
    now = datetime.now(timezone.utc)
    print(f"{'id':<26} {'items':>5} {'bytes':>10}  expires")
    for r in rows:
        exp = datetime.fromisoformat(r["expires"])
        left = (exp - now).days
        state = f"in {left}d" if left >= 0 else f"EXPIRED {-left}d ago"
        print(f"{r['id']:<26} {r.get('items',0):>5} {r.get('bytes',0):>10}  {state}")
    return 0


def cmd_restore(args) -> int:
    require("age", "zstd", "tar")
    match = [r for r in entries() if r["id"] == args.id or r["id"].startswith(args.id)]
    if not match:
        die(f"no entry matching {args.id!r}", 2)
    if len(match) > 1:
        die(f"{args.id!r} matches {len(match)} entries; be more specific")
    entry = match[0]
    archive = Path(str(entry["_archive"]))
    if not archive.exists():
        die(f"sidecar present but archive missing: {archive}")

    identity = resolve_identity(args.identity_from)
    dest = Path(args.into) if args.into else Path.cwd() / f"restored-{entry['id']}"
    dest.mkdir(parents=True, exist_ok=True)

    with read_archive(archive, identity) as tf:
        tf.extractall(dest, filter="data")

    mf = dest / MANIFEST_NAME
    print(f"restored {entry['id']} -> {dest}")
    if mf.exists():
        man = json.loads(mf.read_text())
        print(f"  reason: {man.get('reason') or '(none recorded)'}")
        print(f"  {len(man.get('items', []))} original path(s) listed in {MANIFEST_NAME}")
    return 0


def _one_entry(ident: str) -> dict:
    match = [r for r in entries() if r["id"] == ident or r["id"].startswith(ident)]
    if not match:
        die(f"no entry matching {ident!r}", 2)
    if len(match) > 1:
        die(f"{ident!r} matches {len(match)} entries; be more specific")
    return match[0]


def cmd_peek(args) -> int:
    """List what is inside an entry without writing anything to disk."""
    require("age", "zstd")
    entry = _one_entry(args.id)
    with read_archive(
        Path(str(entry["_archive"])), resolve_identity(args.identity_from)
    ) as tf:
        for m in tf:
            if m.name == MANIFEST_NAME:
                continue
            kind = "d" if m.isdir() else "-"
            print(f"  {kind} {m.size:>10}  {m.name}")
    return 0


def cmd_get(args) -> int:
    """Extract a single member to stdout.

    The whole stream is still decrypted up to that member — age is a stream
    cipher and tar has no index, so there is no random access. It costs one
    sequential read, not a full unpack to disk, which is the distinction that
    matters for grabbing one file out of a large entry.
    """
    require("age", "zstd")
    entry = _one_entry(args.id)
    found = False
    with read_archive(
        Path(str(entry["_archive"])), resolve_identity(args.identity_from)
    ) as tf:
        for m in tf:
            if m.name == args.path or m.name.endswith("/" + args.path.lstrip("/")):
                src = tf.extractfile(m)
                if src is None:
                    die(f"{args.path} is not a regular file")
                shutil.copyfileobj(src, sys.stdout.buffer)
                found = True
                break
    if not found:
        die(f"{args.path!r} not found in {entry['id']} — try `quarantine peek`", 2)
    return 0


def cmd_expire(args) -> int:
    now = datetime.now(timezone.utc)
    due = [r for r in entries() if datetime.fromisoformat(r["expires"]) <= now]
    if not due:
        print("nothing due")
        return 0
    for r in due:
        archive = Path(str(r["_archive"]))
        if args.dry_run:
            print(f"would delete {r['id']} ({r.get('bytes',0)} bytes)")
            continue
        archive.unlink(missing_ok=True)
        Path(str(r["_meta"])).unlink(missing_ok=True)
        print(f"deleted {r['id']}")
    return 0


def main() -> int:
    p = argparse.ArgumentParser(prog="quarantine", add_help=True)
    sub = p.add_subparsers(dest="cmd")

    sub.add_parser("init")

    sp = sub.add_parser("put")
    sp.add_argument("paths", nargs="+")
    sp.add_argument("--days", type=int)
    sp.add_argument("--reason")
    sp.add_argument("--keep", action="store_true")
    sp.add_argument(
        "--work-tagged",
        action="store_true",
        help="declare the content work-tagged; quarantine will refuse it",
    )

    sub.add_parser("list")

    sr = sub.add_parser("restore")
    sr.add_argument("id")
    sr.add_argument("--into")
    sr.add_argument("--identity-from", metavar="SPEC")

    sk = sub.add_parser("peek")
    sk.add_argument("id")
    sk.add_argument("--identity-from", metavar="SPEC")

    sg = sub.add_parser("get")
    sg.add_argument("id")
    sg.add_argument("path")
    sg.add_argument("--identity-from", metavar="SPEC")

    se = sub.add_parser("expire")
    se.add_argument("--dry-run", action="store_true")

    args = p.parse_args()
    if not args.cmd:
        p.print_help()
        return 1
    return {
        "init": cmd_init,
        "put": cmd_put,
        "list": cmd_list,
        "restore": cmd_restore,
        "peek": cmd_peek,
        "get": cmd_get,
        "expire": cmd_expire,
    }[args.cmd](args)


if __name__ == "__main__":
    sys.exit(main())
