#!/usr/bin/env bash

#
# Findline - A powerful command-line utility that combines ripgrep (rg) and fzf for
# interactive code search and navigation.
#
# This script allows users to search for text patterns in files using ripgrep and fzf
# for interactive selection, then optionally open the selected file at the specific line
# and column in various editors (VSCode, windsurf, or cursor).
#
# Dependencies:
#   - ripgrep (rg): For fast pattern searching in files
#   - fzf: For interactive fuzzy selection of results
#   - bat: For syntax-highlighted previews (optional but recommended)
#   - One of the supported editors: VSCode, windsurf, or cursor
#
# Usage: findline [-h|--help] [--path-only] [--vscode|--windsurf|--cursor] [--debug] [<rg SYNOPSIS>] [--subdir <subdirectory>] [--files <glob>]
#
# Flow:
#   1. Parse command line arguments
#   2. Search for pattern using ripgrep and pipe to fzf for selection
#   3. Parse the selected result to extract file path, line number, and column
#   4. Either print the file path or open the file in the selected editor
#
# Functions:
#   - show_help(): Display help and usage information
#   - parse_arguments(): Process command line arguments
#   - search_with_ripgrep_and_fzf(): Perform the search and interactive selection
#   - parse_result(): Extract file, line, and column information from selected result
#   - validate_editor_selection(): Ensure exactly one editor is selected
#   - show_debug_info(): Display debugging information about the parsed result
#   - open_in_editor(): Open the file in the selected editor at the right position
#   - main(): Orchestrates the entire process flow
#
# Author: bdavis
# License: MIT (assumed, specify if different)
#
# Why this stays bash despite its size:
#   The convention here is Python once a script passes ~80-100 lines, on the
#   grounds that bash gets verbose and error-prone for real logic. This script is
#   the exception, and deliberately so. Of its ~256 code lines almost none are
#   logic: it builds an rg command, pipes it to fzf with a bat preview, parses
#   the one selected line, and opens an editor. rg, fzf and bat are all Rust, and
#   they do every part that costs anything — the shell runs once and then waits.
#
#   So a port cannot make it faster, and both directions make it worse. Python
#   would add interpreter startup to a tool invoked interactively and constantly.
#   Rust would mean reimplementing or binding fzf's interactive selection: a
#   large project to end up shelling out to the same binaries.
#
#   Judge this script by lines of logic, not lines of file. If real logic ever
#   accumulates here — beyond argument parsing and result parsing — revisit.
###############
## Logging   ##
###############

# Global flag; set to 1 by main() after arg parsing so all helpers can see it.
_FINDLINE_DEBUG=0

log_error() { echo "findline: error: $*" >&2; }
log_warn()  { echo "findline: warning: $*" >&2; }
log_info()  { echo "findline: $*" >&2; }
log_debug() {
    if [[ "$_FINDLINE_DEBUG" -eq 1 ]]; then
        echo "findline: [debug] $*" >&2
    fi
}

###############
## Functions ##
###############

function show_help() {
    echo "Usage: findline [-h|--help] [--path-only] [--vscode|--windsurf|--cursor] [<rg SYNOPSIS>] [--subdir <subdirectory>] [--files <glob>]"
    echo ""
    echo "A command-line utility that combines ripgrep (rg) and fzf for a fuzzy search experience."
    echo ""
    echo "Options:"
    echo "  -h, --help          Show this help message and exit"
    echo "      --path-only      Output only file paths (one per result)"
    echo "      --vscode         Open the result in VSCode (code -g)"
    echo "      --windsurf       Open the result in windsurf CLI"
    echo "      --cursor         Open the result in cursor CLI"
    echo "      --debug          Print the parsed file, line, col, and the command that would be run before executing it. Can be combined with any editor CLI."
    echo "      --subdir DIR    Limit search to the specified subdirectory"
    echo "      --files GLOB    Only search files matching the glob pattern (e.g. '**/*.py')"
    echo ""
    echo "Examples:"
    echo "  findline 'search pattern'                          # Open in default editor (VSCode if available)"
    echo "  findline --vscode 'search pattern'                 # Open in VSCode"
    echo "  findline --windsurf 'search pattern'               # Open in windsurf"
    echo "  findline --cursor 'search pattern'                 # Open in cursor"
    echo "  findline --debug --vscode 'pattern'                # Show debug info and open in VSCode"
    echo "  findline --debug --windsurf 'pattern'              # Show debug info and open in windsurf"
    echo "  findline --path-only 'search pattern'              # Only print file path"
    echo "  findline --subdir src 'search pattern'"
    echo "  findline --subdir ~/code/myproject --files '**/*.py' 'pattern'"
    echo ""
    echo "With --debug, you'll see the parsed file, line, column, and the exact command that would be run before it executes. Useful for troubleshooting or verifying navigation behavior."
}

function parse_arguments() {
    # Store variable names as strings
    local _subdir_var=$1
    local _path_only_var=$2
    local _use_vscode_var=$3
    local _use_windsurf_var=$4
    local _use_cursor_var=$5
    local _debug_var=$6
    local _args_var=$7
    local _glob_var=$8

    # Initialize variables using eval
    eval "$_subdir_var=\".\""
    eval "$_path_only_var=0"
    eval "$_use_vscode_var=0"
    eval "$_use_windsurf_var=0"
    eval "$_use_cursor_var=0"
    eval "$_debug_var=0"
    eval "$_glob_var=\"\""

    # Shift past the variable name parameters
    shift 8

    while [[ $# -gt 0 ]]; do
        case $1 in
            --subdir)
                eval "$_subdir_var=\"$2\""
                shift 2
                ;;
            --files)
                eval "$_glob_var=\"$2\""
                shift 2
                ;;
            --path-only)
                eval "$_path_only_var=1"
                shift 1
                ;;
            --vscode)
                eval "$_use_vscode_var=1"
                shift 1
                ;;
            --windsurf)
                eval "$_use_windsurf_var=1"
                shift 1
                ;;
            --cursor)
                eval "$_use_cursor_var=1"
                shift 1
                ;;
            --debug)
                eval "$_debug_var=1"
                shift 1
                ;;
            -h|--help)
                show_help
                exit 0
                ;;
            *)
                # Store remaining arguments in the _args array
                eval "$_args_var=(\"$@\")"
                break
                ;;
        esac
    done
}

function search_with_ripgrep_and_fzf() {
    local search_pattern="$1"
    local subdir="$2"
    local glob_pattern="$3"

    # Check if subdir exists
    if [[ ! -d "$subdir" ]]; then
        log_error "directory '$subdir' does not exist"
        return 1
    fi

    # Build the fzf preview command based on whether bat is available
    local preview_cmd
    if command -v bat >/dev/null 2>&1; then
        preview_cmd="command bat -p --color=always {1} --highlight-line {2}"
    else
        # Fallback to a simple preview using sed/awk
        preview_cmd='awk "NR=={2} {printf \">\033[1;32m%s\033[0m\n\", \$0} NR!={2} && NR>={2}-5 && NR<={2}+5 {print}" {1} 2>/dev/null || echo "Preview not available"'
    fi

    local rg_glob_args=()
    if [[ -n "$glob_pattern" ]]; then
        rg_glob_args=(--glob "$glob_pattern")
    fi

    local _dbg_cmd="rg --color=always --line-number --no-heading --column --smart-case"
    [[ -n "$glob_pattern" ]] && _dbg_cmd+=" --glob '${glob_pattern}'"
    _dbg_cmd+=" '${search_pattern:-}' '${subdir}'"
    log_debug "running: ${_dbg_cmd}"

    command rg --color=always --line-number --no-heading --column --smart-case "${rg_glob_args[@]}" "${search_pattern:-}" "$subdir" \
        | command fzf -d':' --ansi \
            --preview "$preview_cmd" \
            --preview-window ~8,+{2}-5
}

function parse_result() {
    local result="$1"
    local _file_var="$2"
    local _line_var="$3"
    local _col_var="$4"
    local _location_var="$5"

    # Use _-prefixed locals so they don't shadow the caller's variable names
    # when the caller happens to use the same names (file, line, col, location).
    local _file _line _col _location

    _file=$(echo "$result" | awk -F':' '{print $1}')
    _line=$(echo "$result" | awk -F':' '{print $2}')
    _col=$(echo "$result" | awk -F':' '{print $3}')

    if [[ -n "$_col" ]]; then
        _location="$_file:$_line:$_col"
    else
        _location="$_file:$_line"
    fi

    printf -v "$_file_var"     '%s' "$_file"
    printf -v "$_line_var"     '%s' "$_line"
    printf -v "$_col_var"      '%s' "$_col"
    printf -v "$_location_var" '%s' "$_location"
}

function validate_editor_selection() {
    local use_vscode=$1
    local use_windsurf=$2
    local use_cursor=$3
    local path_only=$4
    
    # If path_only is set, we don't need an editor
    if [[ $path_only -eq 1 ]]; then
        return 0
    fi
    
    local cli_count=$((use_vscode + use_windsurf + use_cursor))
    
    # If no editor is specified, try to use VSCode as default if available
    if [[ $cli_count -eq 0 ]]; then
        if command -v code >/dev/null 2>&1; then
            return 0  # We'll use VSCode as default
        else
            log_error "no editor specified and VSCode (default) not found"
            log_info  "  use --vscode, --windsurf, --cursor, or --path-only"
            return 2
        fi
    elif [[ $cli_count -gt 1 ]]; then
        log_error "specify only one of --vscode, --windsurf, or --cursor"
        return 2
    fi
    return 0
}

function show_debug_info() {
    local file="$1"
    local line="$2"
    local col="$3"

    log_debug "file: $file"
    log_debug "line: $line"
    [[ -n "$col" ]] && log_debug "col: $col"
}

function open_in_editor() {
    local use_vscode=$1
    local use_windsurf=$2
    local use_cursor=$3
    local debug=$4
    local location="$5"
    
    # Default to VSCode if no editor is specified
    if [[ $use_vscode -eq 0 && $use_windsurf -eq 0 && $use_cursor -eq 0 ]]; then
        if command -v code --new-window >/dev/null 2>&1; then
            use_vscode=1
        fi
    fi
    
    if [[ $use_vscode -eq 1 ]]; then
        if ! command -v code >/dev/null 2>&1; then
            log_error "VSCode CLI (code) not found in PATH"
            return 3
        fi
        log_debug "running: code -g '$location'"
        command code -g "$location"
    elif [[ $use_windsurf -eq 1 ]]; then
        if ! command -v windsurf >/dev/null 2>&1; then
            log_error "windsurf CLI not found in PATH"
            return 3
        fi
        log_debug "running: windsurf '$location'"
        command windsurf "$location"
    elif [[ $use_cursor -eq 1 ]]; then
        if ! command -v cursor >/dev/null 2>&1; then
            log_error "cursor CLI not found in PATH"
            return 3
        fi
        log_debug "running: cursor '$location'"
        command cursor "$location"
    fi
}

function main() {
    # Display help message if -h or --help is passed
    if [[ "$1" == "-h" || "$1" == "--help" ]]; then
        show_help
        return 0
    fi

    # Check for required dependencies
    for cmd in rg fzf; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            log_error "required command '$cmd' not found"
            log_info  "  ripgrep (rg): https://github.com/BurntSushi/ripgrep"
            log_info  "  fzf:          https://github.com/junegunn/fzf"
            return 1
        fi
    done

    # Check for optional dependency
    if ! command -v bat >/dev/null 2>&1; then
        log_warn "bat not found — using basic preview (install bat for syntax highlighting)"
    fi

    # Initialize variables
    local subdir path_only use_vscode use_windsurf use_cursor debug args glob
    parse_arguments subdir path_only use_vscode use_windsurf use_cursor debug args glob "$@"

    # Activate debug mode globally so all helpers can see it
    _FINDLINE_DEBUG=$debug

    log_debug "pattern : '${args[*]:-}'"
    log_debug "dir     : '$subdir'"
    log_debug "glob    : '${glob:-}'"

    # Validate editor selection early
    validate_editor_selection "$use_vscode" "$use_windsurf" "$use_cursor" "$path_only" || return $?

    # Run the ripgrep (rg) command and pipe the results to fzf
    local result
    result=$(search_with_ripgrep_and_fzf "${args[*]:-}" "$subdir" "$glob")
    if [[ -z "$result" ]]; then
        log_info "no results — pattern='${args[*]:-}' dir='$subdir'${glob:+ glob='$glob'}"
        if [[ -n "$glob" ]]; then
            log_warn "glob patterns must be single-quoted to prevent shell expansion"
            log_info  "  did you mean: --files '${glob}'"
            log_info  "  verify files: find '${subdir}' -name '${glob##**/}' | head -5"
            log_info  "  search all types: omit --files"
        fi
        return 1
    fi

    # Strip ANSI color codes from result before parsing
    result=$(echo "$result" | sed 's/\x1b\[[0-9;]*m//g')
    log_debug "selected: $result"

    # Parse out file, line, col for goto logic
    local file line col location
    parse_result "$result" file line col location

    if [[ $path_only -eq 1 ]]; then
        echo "$file"
    else
        show_debug_info "$file" "$line" "$col"
        open_in_editor "$use_vscode" "$use_windsurf" "$use_cursor" "$debug" "$location"
    fi
}

#####################################
## Main entry point for the script ##
#####################################

# Allow sourcing for unit tests without executing main
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
