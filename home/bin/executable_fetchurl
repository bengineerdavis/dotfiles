PAGE_EXTS = {"html", "htm", "xhtml", "php", "asp", "aspx", "jsp", "cgi", "shtml", "do"}

# Attachment URLs as they appear in support transcripts, ticket exports and chat logs.
# These are the whole point of scanning a transcript, so they are recognised by name --
# both to classify them confidently and to tell you where each file came from.
ATTACHMENT_SOURCES = [
    (re.compile(r"(?i)\.zendesk\.com/attachments/"), "Zendesk attachment"),
    (re.compile(r"(?i)^https?://files\.slack\.com/files-"), "Slack file"),
    (re.compile(r"(?i)^https?://[\w.-]+\.slack\.com/files/"), "Slack file"),
    (
        re.compile(r"(?i)^https?://drive\.usercontent\.google\.com/download"),
        "Google Drive download",
    ),
    (re.compile(r"(?i)^https?://drive\.google\.com/uc\b"), "Google Drive download"),
    (
        re.compile(r"(?i)^https?://docs\.google\.com/\w+/.*/export"),
        "Google Docs export",
    ),
    (re.compile(r"(?i)^https?://(www\.)?dropbox\.com/s(cl)?/"), "Dropbox share"),
    (re.compile(r"(?i)^https?://dl\.dropboxusercontent\.com/"), "Dropbox direct link"),
    (re.compile(r"(?i)\.atlassian\.net/secure/attachment/"), "Jira attachment"),
    (
        re.compile(r"(?i)\.atlassian\.net/rest/api/[\w.]+/attachment/"),
        "Jira attachment (API)",
    ),
    (
        re.compile(r"(?i)^https?://github\.com/[\w.-]+/[\w.-]+/files/"),
        "GitHub issue attachment",
    ),
    (re.compile(r"(?i)^https?://user-images\.githubusercontent\.com/"), "GitHub image"),
    (re.compile(r"(?i)\.intercomcdn\.com/"), "Intercom attachment"),
    (re.compile(r"(?i)\.freshdesk\.com/.*attachment"), "Freshdesk attachment"),
    (re.compile(r"(?i)\.sentry\.io/api/0/.*/attachments/"), "Sentry event attachment"),
    (re.compile(r"(?i)\.sharepoint\.com/.*(download|Doc\.aspx)"), "SharePoint file"),
    (
        re.compile(r"(?i)^https?://[\w.-]*\.notion\.(so|site)/.*\.\w{2,4}\?"),
        "Notion attachment",
    ),
]
_DOWNLOADISH = re.compile(
    r"(?i)(/download/|/downloads/|/raw/|/export/|/attachments?/|/artifacts?/|/blob/|/files?/|"
    r"[?&](download|export|attachment|raw)=|[?&]format=(csv|json|xlsx?|pdf|tsv|xml|zip)|"
    r"response-content-disposition=|x-amz-signature=)"
)
_ASSET_HOST = re.compile(
    r"(?i)^(raw\.githubusercontent\.com|objects\.githubusercontent\.com|files\.pythonhosted\.org|"
    r"storage\.googleapis\.com|s3\.amazonaws\.com|cdn\..+|.+\.s3[.-][\w-]*\.amazonaws\.com|"
    r".+\.blob\.core\.windows\.net|.+\.r2\.cloudflarestorage\.com)$"
)

_URL_RE = re.compile(r"https?://[^\s<>\"'`\\\]\[{}|^]+")
_JUNK = ".,;:!?)]}>'\"`*_"


@dataclass
class Found:
    url: str
    verdict: str = "page"  # "file" | "page"
    why: str = ""
    size: int | None = None
    name: str | None = None  # what it would be saved as


class _HrefScanner(HTMLParser):
    ATTRS = ("href", "src", "data-url", "data-href", "poster")

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.urls: list[str] = []

    def handle_starttag(self, tag, attrs):
        a = {k.lower(): (v or "") for k, v in attrs}
        self.urls += [a[x].strip() for x in self.ATTRS if a.get(x, "").strip()]


def extract_urls(text: str, source: str) -> list[str]:
    """Pull http(s) URLs out of HTML, JSON, Markdown, logs -- whatever it is."""
    out, seen = [], set()

    def add(raw: str) -> None:
        candidate = raw.strip().strip("<>\"'").rstrip(_JUNK)
        while candidate.endswith(")") and candidate.count(")") > candidate.count("("):
            candidate = candidate[:-1]
        if not candidate.lower().startswith(("http://", "https://")):
            return
        try:
            candidate = validate_url(candidate)
        except InvalidURLError:
            return
        if candidate not in seen:
            seen.add(candidate)
            out.append(candidate)

    if re.search(r"<\s*(a|link|img|script|html)\b", text[:20000], re.IGNORECASE):
        scanner = _HrefScanner()
        with contextlib.suppress(Exception):
            scanner.feed(text)
            scanner.close()
        for url in scanner.urls:
            add(url)

    if text.lstrip()[:1] in "{[":
        with contextlib.suppress(ValueError):
            for url in walk_json_strings(json.loads(text)):
                add(url)

    for match in _URL_RE.finditer(text):
        add(match.group(0))

    log.debug("extracted %d unique URL(s) from %s", len(out), source)
    return out


def walk_json_strings(node: Any, depth: int = 0) -> Iterator[str]:
    if depth > 20:
        return
    if isinstance(node, str):
        if node.lower().startswith(("http://", "https://")):
            yield node
    elif isinstance(node, dict):
        for value in node.values():
            yield from walk_json_strings(value, depth + 1)
    elif isinstance(node, list):
        for value in node[:2000]:
            yield from walk_json_strings(value, depth + 1)


def classify(url: str) -> Found:
    """Guess file-vs-webpage from the URL alone."""
    p, ext = urlsplit(url), url_ext(url)
    host = (p.hostname or "").lower()
    verdict, why = "page", "no extension and no download markers"
    for pattern, label in ATTACHMENT_SOURCES:
        if pattern.search(url):
            verdict, why = "file", label
            break
    else:
        if ext in PAGE_EXTS:
            verdict, why = "page", f"ends in .{ext}, a rendered page"
        elif ext in FILE_EXTS:
            verdict, why = "file", f"ends in .{ext}"
        elif _DOWNLOADISH.search(url):
            verdict, why = "file", "URL contains a download/export marker"
        elif _ASSET_HOST.match(host):
            verdict, why = "file", f"{host} is an object store / CDN"
        elif p.path in ("", "/") and not p.query:
            verdict, why = "page", "bare site root"
        elif p.path.endswith("/"):
            verdict, why = "page", "path ends in a slash"
        elif ext:
            verdict, why = "file", f"unrecognised .{ext}, but it looks like a filename"
        elif re.search(r"(?i)/api/|/v\d+/", p.path):
            verdict, why = "file", "looks like an API endpoint"
    return Found(url, verdict, why, name=name_from_url(url))


async def confirm_types(items: list[Found], client: Client, concurrency: int) -> None:
    """Ask each server what its URL really is. Cheap, and far more accurate than guessing."""
    log.info("checking %d URL(s) with HEAD requests...", len(items))
    sem = asyncio.Semaphore(concurrency)

    async def probe(item: Found) -> None:
        async with sem:
            try:
                async with client.limiter(item.url).slot(JobLog("probe", 0)):
                    resp = await client.http.head(item.url)
                    if resp.status_code in (403, 405, 501):
                        resp = await client.http.get(
                            item.url, headers={"Range": "bytes=0-2047"}
                        )
            except httpx.HTTPError as exc:
                log.debug(
                    "probe of %s failed: %s", redact(item.url), type(exc).__name__
                )
                item.why += " (server did not respond to a probe)"
                return
            if resp.status_code >= 400:
                item.why = f"HTTP {resp.status_code} on probe; {item.why}"
                return
            ctype = (
                (resp.headers.get("content-type", "").split(";")[0] or "")
                .strip()
                .lower()
            )
            if resp.headers.get("content-length", "").isdigit():
                item.size = int(resp.headers["content-length"])
            disposition = resp.headers.get("content-disposition", "")
            if named := content_disposition_name(disposition):
                item.name = safe_name(named)  # the server's own name beats any guess
            if "attachment" in disposition.lower():
                item.verdict = "file"
                item.why = f"server sends it as an attachment{f' named {item.name!r}' if item.name else ''}"
            elif ctype in ("text/html", "application/xhtml+xml"):
                item.verdict, item.why = "page", f"server returns {ctype}"
            elif ctype:
                item.verdict, item.why = "file", f"server returns {ctype}"

    await asyncio.gather(*(probe(i) for i in items))


def parse_selection(spec: str, count: int) -> list[int] | None:
    """'1,3,5-9' / 'all' / 'files' / 'none' -> zero-based indices. None means "files"."""
    spec = spec.strip().lower()
    if spec in ("", "f", "files"):
        return None
    if spec in ("a", "all", "y", "yes"):
        return list(range(count))
    if spec in ("n", "no", "none", "q", "quit"):
        return []
    picked: list[int] = []
    for chunk in re.split(r"[,\s]+", spec):
        if not chunk:
            continue
        if "-" in chunk[1:]:
            lo, _, hi = chunk.partition("-")
            try:
                lo_i, hi_i = sorted((int(lo), int(hi)))
            except ValueError:
                raise UsageError(f"could not understand the range {chunk!r}")
            picked += [n - 1 for n in range(lo_i, hi_i + 1) if 1 <= n <= count]
        else:
            try:
                n = int(chunk)
            except ValueError:
                raise UsageError(
                    f"could not understand {chunk!r}",
                    "use numbers, ranges (2-5), 'files', 'all' or 'none'",
                )
            if not 1 <= n <= count:
                raise UsageError(f"{n} is out of range (1-{count})")
            picked.append(n - 1)
    return list(dict.fromkeys(picked))


def choose(items: list[Found], assume_yes: bool = False) -> list[str]:
    """Show what was found and ask which URLs to download."""
    file_idx = [n for n, i in enumerate(items) if i.verdict == "file"]
    if assume_yes:
        chosen = file_idx or list(range(len(items)))
        log.info("taking %d URL(s) without prompting", len(chosen))
        return [items[n].url for n in chosen]

    print(
        f"\nFound {len(items)} URL(s); {len(file_idx)} look like downloadable files:\n",
        file=sys.stderr,
    )
    for n, item in enumerate(items, 1):
        size = f", {human_bytes(item.size)}" if item.size else ""
        saves = f" -> {item.name}" if item.verdict == "file" and item.name else ""
        print(
            f"  {n:>3}. [{'FILE' if item.verdict == 'file' else 'page'}]{saves or ' ' + item.url}",
            file=sys.stderr,
        )
        detail = f"       {item.why}{size}"
        print(detail if not saves else f"{detail}\n       {item.url}", file=sys.stderr)
    print(
        "\n  files = the FILE ones (default) | all | 1,3,5-9 | none\n", file=sys.stderr
    )

    if not sys.stdin.isatty():
        raise UsageError(
            "cannot prompt: stdin is not a terminal",
            "drop -i to take every confirmed file automatically",
        )
    while True:
        try:
            answer = input("selection [files]: ")
        except (EOFError, KeyboardInterrupt):
            print(file=sys.stderr)
            return []
        try:
            picked = parse_selection(answer, len(items))
        except UsageError as exc:
            print(f"  {exc.message}", file=sys.stderr)
            continue
        if picked is None:
            if not file_idx:
                print(
                    "  nothing looks like a file -- choose 'all', some numbers, or 'none'.",
                    file=sys.stderr,
                )
                continue
            picked = file_idx
        return [items[n].url for n in picked]


# --------------------------------------------------------------------------- #
# CLI
# --------------------------------------------------------------------------- #


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog=PROGRAM,
        description="Download URLs, with file-type detection and pagination awareness.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""examples:
  %(prog)s https://example.com/data.csv
  %(prog)s thread.md                 # finds the attachments and downloads them
  %(prog)s thread.md -i              # ...but ask me which ones first
  %(prog)s urls.txt -o ./out
  %(prog)s https://a.com/1.pdf https://b.com/2.pdf -o ~/Downloads
  %(prog)s thread.md -q --json | jq  # for pipelines: no progress, one record per file

A target is a URL or a local file. A file containing a bare URL list is taken as-is;
any other document is scanned for URLs, and the ones that look like files are
downloaded. Use '-' to read a document from stdin.
""",
    )
    p.add_argument(
        "targets",
        nargs="*",
        metavar="URL|FILE",
        help="URLs to download, or documents to pull downloadable URLs out of "
        "('-' for stdin)",
    )
    p.add_argument(
        "-i",
        "--interactive",
        action="store_true",
        help="list what was found and ask which to download, instead of taking every "
        "confirmed file automatically",
    )
    p.add_argument(
        "-o",
        "--output",
        metavar="DIR",
        default=".",
        help="output directory, absolute or relative (default: current directory)",
    )
    p.add_argument(
        "-f",
        "--force",
        action="store_true",
        help="overwrite existing files instead of adding -1, -2",
    )
    p.add_argument(
        "-c",
        "--concurrency",
        type=int,
        default=4,
        metavar="N",
        help="download N URLs at once (default: 4)",
    )
    p.add_argument(
        "--timeout",
        type=float,
        default=30.0,
        metavar="SEC",
        help="per-operation timeout (default: 30)",
    )
    p.add_argument(
        "--refresh",
        action="store_true",
        help="ignore cached copies and re-fetch everything",
    )
    p.add_argument(
        "--max-pages",
        type=int,
        default=100,
        metavar="N",
        help="stop after N pages per URL (default: 100)",
    )
    p.add_argument(
        "--no-paginate",
        dest="paginate",
        action="store_false",
        help="fetch only the first page",
    )
    p.add_argument(
        "--token", metavar="TOKEN", help="send 'Authorization: Bearer TOKEN'"
    )
    p.add_argument(
        "-u",
        "--user",
        metavar="USER[:PASS]",
        help="HTTP Basic auth; prompts for the password if omitted",
    )
    p.add_argument(
        "--cookie",
        metavar="STRING",
        help="send a Cookie header, e.g. 'session=abc; csrf=xyz'",
    )
    p.add_argument(
        "-H",
        "--header",
        action="append",
        default=[],
        metavar="'K: V'",
        help="extra request header (repeatable)",
    )
    p.add_argument(
        "-v",
        "--verbose",
        action="count",
        default=0,
        help="-v debug, -vv also dump response headers",
    )
    p.add_argument(
        "-q",
        "--quiet",
        action="store_true",
        help="errors only: no progress bars, no per-file lines. The exit code carries "
        "the result",
    )
    p.add_argument(
        "--json",
        dest="as_json",
        action="store_true",
        help="write one JSON record per downloaded file to stdout (logs stay on stderr), "
        "for piping into jq",
    )
    p.add_argument("--version", action="version", version=f"{PROGRAM} {VERSION}")
    return p


def check_options(opts, parser: argparse.ArgumentParser) -> None:
    if not opts.targets:
        parser.error("nothing to do. Pass a URL, or a file to pull URLs out of.")
    if opts.interactive and opts.quiet:
        raise UsageError(
            "-i/--interactive and -q/--quiet contradict each other",
            "the picker has to print the list it is asking you about",
        )
    if opts.interactive and not sys.stdin.isatty():
        raise UsageError(
            "-i/--interactive needs a terminal to prompt on",
            "drop -i to take every confirmed file automatically",
        )
    for name, value in (
        ("--concurrency", opts.concurrency),
        ("--max-pages", opts.max_pages),
    ):
        if value < 1:
            raise UsageError(f"{name} must be at least 1")
    if opts.timeout <= 0:
        raise UsageError("--timeout must be positive")


def build_http(opts) -> tuple[Any, list[str], str]:
    """Create the HTTP client, report which credentials it will send, and fingerprint
    those credentials so cached bodies are never shared across identities."""
    headers = {"User-Agent": f"{PROGRAM}/{VERSION}", "Accept": "*/*"}
    used: list[str] = []

    for raw in opts.header:
        if ":" not in raw:
            raise UsageError(f"malformed --header {raw!r}", "use 'Name: value'")
        key, _, value = raw.partition(":")
        if not key.strip():
            raise UsageError(f"malformed --header {raw!r}: empty header name")
        headers[key.strip()] = value.strip()
        if key.strip().lower() in ("authorization", "x-api-key", "private-token"):
            used.append("custom auth header")

    if opts.token:
        token = opts.token.strip()
        headers["Authorization"] = (
            f"Bearer {token[7:].strip() if token.lower().startswith('bearer ') else token}"
        )
        used.append("bearer token")
    if opts.cookie:
        headers["Cookie"] = opts.cookie
        used.append("cookies")

    auth = None
    if opts.user:
        user, sep, password = opts.user.partition(":")
        if not user:
            raise UsageError("--user needs a username", "format: --user USER[:PASS]")
        if not sep:
            if not sys.stdin.isatty():
                raise UsageError(
                    "no password given and stdin is not a terminal",
                    "use --user USER:PASS",
                )
            try:
                password = getpass.getpass(f"Password for {user}: ")
            except (EOFError, KeyboardInterrupt):
                raise UsageError("password entry cancelled")
        auth = httpx.BasicAuth(user, password)
        used.append("HTTP Basic")

    client = httpx.AsyncClient(
        headers=headers,
        auth=auth,
        follow_redirects=True,
        trust_env=True,
        timeout=httpx.Timeout(opts.timeout, connect=min(10.0, opts.timeout)),
        limits=httpx.Limits(
            max_connections=max(10, opts.concurrency * 2),
            max_keepalive_connections=opts.concurrency,
        ),
    )
    # Credentials AND any custom header belong in the cache identity: a header can change
    # what the server returns (that is what Vary describes), so two runs that send
    # different headers must not share a cached body.
    material = "|".join(
        (
            headers.get("Authorization", ""),
            headers.get("Cookie", ""),
            opts.user or "",
            *sorted(opts.header),
        )
    )
    fingerprint = (
        hashlib.sha256(material.encode()).hexdigest()[:16]
        if material.strip("|")
        else "anonymous"
    )
    return client, used, fingerprint


def read_input(path: str) -> tuple[str, bool]:
    """Read a file (or stdin). Returns (text, is_a_bare_url_list)."""
    if path == "-":
        text = sys.stdin.read()
    else:
        target = Path(path).expanduser()
        if not target.exists():
            raise UsageError(
                f"input file not found: {target}",
                "check the path, or use '-' for stdin",
            )
        if target.is_dir():
            raise UsageError(f"input path is a directory, not a file: {target}")
        try:
            text = decode_text(target.read_bytes())
        except OSError as exc:
            raise UsageError(f"cannot read {target}: {exc}") from exc
    lines = [ln.strip() for ln in text.splitlines()]
    real = [ln for ln in lines if ln and not ln.startswith("#")]
    bare = bool(real) and all(
        " " not in ln and ln.lower().startswith(("http://", "https://")) for ln in real
    )
    return text, bare


def split_targets(targets: list[str]) -> tuple[list[str], list[str]]:
    """Sort each target into (urls, documents).

    A target is a document when a file of that name exists, or it is '-' for stdin.
    Anything else is treated as a URL, so a mistyped path still produces a URL error
    naming what you actually typed rather than a confusing file-not-found.
    """
    urls: list[str] = []
    documents: list[str] = []
    problems: list[str] = []
    for n, raw in enumerate(targets, 1):
        if raw == "-" or Path(raw).expanduser().is_file():
            documents.append(raw)
            continue
        try:
            urls.append(validate_url(raw, f"target {n}"))
        except InvalidURLError as exc:
            problems.append(exc.render())
    for problem in problems:
        log.warning("skipping unusable target -- %s", problem)
    if problems and not urls and not documents:
        raise UsageError("no usable targets given")
    return urls, documents


def emit_json(results: list[Result]) -> None:
    """One record per output file on stdout, plus one per failed target.

    Logs stay on stderr so this composes: `fetchurl thread.md --json | jq -r .path`.
    """
    for r in results:
        if r.ok:
            for f in r.files:
                print(
                    json.dumps(
                        {
                            "status": "ok",
                            "url": redact(r.url),
                            "path": str(f.path),
                            "bytes": f.size,
                            "kind": f.first.shape.kind,
                            "pages": len(f.pages),
                            "records": f.records(),
                        }
                    ),
                    flush=True,
                )
        else:
            print(
                json.dumps(
                    {
                        "status": "failed",
                        "url": redact(r.url),
                        "error": r.error.message if r.error else "unknown",
                    }
                ),
                flush=True,
            )


async def run(opts, parser: argparse.ArgumentParser) -> int:
    check_options(opts, parser)

    directory = Path(opts.output).expanduser()
    directory = (
        (Path.cwd() / directory).resolve()
        if not directory.is_absolute()
        else directory.resolve()
    )
    output = Output(directory, opts.force)
    output.prepare()
    log.debug("output directory: %s", directory)

    http, auth_used, fingerprint = build_http(opts)
    cache = Cache(opts.refresh)
    await cache.open()
    client = Client(http, auth_used, fingerprint, cache)
    log.info("authentication: %s", ", ".join(auth_used) if auth_used else "none")

    async with http:
        urls, documents = split_targets(opts.targets)

        for source in documents:
            text, bare = read_input(source)
            if bare:
                entries = [
                    ln.strip()
                    for ln in text.splitlines()
                    if ln.strip() and not ln.startswith("#")
                ]
                log.info("%s is a URL list (%d entries)", source, len(entries))
                for n, raw in enumerate(entries, 1):
                    try:
                        urls.append(validate_url(raw, f"URL from {source}:{n}"))
                    except InvalidURLError as exc:
                        log.warning("skipping unusable URL -- %s", exc.render())
                continue

            log.info("%s is not a URL list -- scanning it for URLs", source)
            found = [classify(u) for u in extract_urls(text, source)]
            if not found:
                raise UsageError(
                    f"no http(s) URLs found in {source}",
                    "the file may only contain relative links, or none at all",
                )
            log.info(
                "found %d URL(s): %d look like files",
                len(found),
                sum(f.verdict == "file" for f in found),
            )
            await confirm_types(found, client, opts.concurrency)
            confirmed = [f for f in found if f.verdict == "file"]
            log.info(
                "after checking: %d file(s), %d page(s)",
                len(confirmed),
                sum(f.verdict == "page" for f in found),
            )

            if opts.interactive:
                urls += await asyncio.to_thread(choose, found, False)
            else:
                # The default: take what was confirmed to be a file and get on with it.
                # Pages are never auto-downloaded -- asking for a document's attachments
                # should not silently scrape every page it happens to link to.
                if not confirmed:
                    log.warning(
                        "none of the %d URL(s) in %s resolved to a downloadable file; "
                        "re-run with -i to pick from the full list",
                        len(found),
                        source,
                    )
                for item in confirmed:
                    log.info(
                        "  will download %s (%s)",
                        item.name or name_from_url(item.url),
                        item.why,
                    )
                urls += [f.url for f in confirmed]

        urls = list(dict.fromkeys(urls))
        if not urls:
            log.info("nothing to download")
            return 0

        log.info(
            "downloading %d URL(s), %d at a time, into %s",
            len(urls),
            opts.concurrency,
            directory,
        )
        semaphore = asyncio.Semaphore(opts.concurrency)

        async def worker(url: str, slot: int) -> Result:
            async with semaphore:
                return await download(url, slot, client, output, opts)

        # Bars only when a person is watching: not under -q, not with --json (control
        # codes would corrupt piped output), and not when stderr is redirected.
        show_progress = (
            not opts.quiet
            and not opts.as_json
            and sys.stderr.isatty()
            and not os.environ.get("NO_COLOR")
        )
        started = time.monotonic()
        try:
            with Display(show_progress):
                results = await asyncio.gather(
                    *(worker(u, n) for n, u in enumerate(urls))
                )
        finally:
            await cache.close()

    ok = [r for r in results if r.ok]
    failed = [r for r in results if not r.ok]
    served = sum(r.cached for r in results)
    log.info("-" * 55)
    log.info(
        "done in %s: %d/%d succeeded, %d page(s), %d file(s), %s transferred",
        human_time(time.monotonic() - started),
        len(ok),
        len(results),
        sum(r.pages for r in results),
        sum(len(r.files) for r in ok),
        human_bytes(sum(r.downloaded for r in results)),
    )
    if served:
        log.info(
            "%d of those page(s) came from the cache (%d served outright, %d revalidated as unchanged)",
            served,
            cache.hits,
            cache.revalidated,
        )
    for r in ok:
        for f in r.files:
            log.info("  ok    %s (%s)", f.path, human_bytes(f.size))
    for r in failed:
        log.error("  FAIL  %s", redact(r.url))
        if r.error:
            log.error("        %s", r.error.message)
            if r.error.hint:
                log.error("        hint: %s", r.error.hint)

    if opts.as_json:
        emit_json(results)

    if not failed:
        return 0
    return max((r.error.exit_code for r in failed if r.error), default=1)


def main(argv: Sequence[str] | None = None) -> int:
    parser = build_parser()
    opts = parser.parse_args(argv)
    setup_logging(opts.verbose, opts.quiet)
    log.debug(
        "%s %s | httpx2 %s | python %s",
        PROGRAM,
        VERSION,
        getattr(httpx, "__version__", "?"),
        sys.version.split()[0],
    )
    try:
        return asyncio.run(run(opts, parser))
    except FetchError as exc:
        log.error("%s", exc.render())
        return exc.exit_code
    except KeyboardInterrupt:
        log.warning("interrupted")
        return 130
    except Exception as exc:
        log.error("unexpected error: %s: %s", type(exc).__name__, exc)
        log.debug("traceback", exc_info=True)
        if not opts.verbose:
            log.error("run again with -v for a traceback")
        return 1


if __name__ == "__main__":
    sys.exit(main())
