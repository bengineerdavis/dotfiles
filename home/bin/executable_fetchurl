#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["httpx2>=2.9", "diskcache>=5.6", "rich>=13.7"]
# ///
"""
fetchurl - download URLs, with file-type detection and pagination awareness.

  fetchurl https://example.com/data.csv
  fetchurl thread.md                    # finds the attachments and downloads them
  fetchurl thread.md -i                 # ...but ask which ones first
  fetchurl urls.txt -o ./downloads
  fetchurl thread.md -q --json | jq -r .path

Without uv:  pip install httpx2 && python3 fetchurl.py ...

Exit codes: 0 ok | 2 bad usage/URL | 3 network | 4 auth | 5 HTTP error | 6 output
            1 unexpected | 130 interrupted
"""

