#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["typer", "pyyaml"]
# ///
"""Scaffold chezmoi-Ansible topics that are correct for their manager.

Run as a uv single-file script: the shebang invokes `uv run --script`,
which resolves the dependencies above into a cached ephemeral venv.
Nothing is installed into a global Python.

`topical new` replaces `init-config.sh`: instead of copying template_dir
verbatim and leaving every field to hand-editing, it reads
dotfiles/managers.yaml and emits only what the topic's package managers
need — the cask playbook vars for a cask topic, `become: true` for apt,
nothing for a manager the topic does not use. The split of work:

  template_dir/    manager-neutral skeleton, copied verbatim, spliced
  managers.yaml    the facts: module, become, OS coverage, playbook
                   vars, upgraded_by — and the per-manager traps
  this script      the block templates and the package/outline mode map

Two emission modes. `package` managers (homebrew_formula, homebrew_cask,
homebrew_tap, apt) produce a complete live block from the topic name.
`outline` managers (apt_repository, release_artifact) produce a
commented skeleton, because URLs, keys and checksums are per-topic and
unknowable to a generator — the outline carries the traps inline.

Written to be carried into the separate `topical` project (TASKS.md
A9); repo discovery is upward-walk only, with --repo as the override.
"""

from __future__ import annotations

import json
import re
import shutil
import string
from pathlib import Path

import typer
import yaml

app = typer.Typer(
    help=__doc__.splitlines()[0],
    epilog="Docs: dotfiles/docs/TOPICS.md; manager catalog: dotfiles/managers.yaml.",
    no_args_is_help=True,
)

RESERVED_NAMES = {"new", "list", "doctor", "help"}
NAME_RE = re.compile(r"^[a-z][a-z0-9-]*$")
VALID_TIERS = ("pkg-manager", "runtime-manager", "app")
VALID_OS = ("Darwin", "Debian")

# The mode map. Every manager in managers.yaml must appear here or
# `new` refuses it with the fix named — a manager nobody has written a
# template for is the agent-pass case (TASKS.md A9), not a silent gap.
PACKAGE_MANAGERS = {"homebrew_formula", "homebrew_cask", "homebrew_tap", "apt"}
OUTLINE_MANAGERS = {"apt_repository", "release_artifact"}

# Which system role's upgrade pass covers a manager, for the generated
# upgrade.yaml guidance. `upgraded_by: topic` managers are absent here
# on purpose.
SYSTEM_ROLE_FOR = {
    "homebrew_formula": "apps/homebrew",
    "homebrew_cask": "apps/homebrew",
    "homebrew_tap": "apps/homebrew",
    "apt": "apps/apt",
    "apt_repository": "apps/apt",
}

BANNER_RULE = "─" * 78


class ScaffoldError(Exception):
    """A refusal: the message tells the operator the fix."""


# ── Manager block templates ─────────────────────────────────────────
# string.Template so Ansible's {{ }} braces pass through untouched.
# Parameters: $topic (topic name), $package (package name), $var (topic
# name with dashes as underscores, for register names), $when (guard).
#
# The tap trust shapes copy apps/opencode's, measured on Homebrew 7.0.1
# (2026-09-14): trust BEFORE tapping, two trust entries to tear down,
# and the 'Already trusted' / 'Not trusted' stdout strings changed_when
# reads.

INSTALL_PACKAGE = {
    "homebrew_formula": string.Template("""\
- name: "Install $package via Homebrew"
  community.general.homebrew:
    name: $package
    state: present
  when: $when
"""),
    "homebrew_cask": string.Template("""\
- name: "Install $package via Homebrew Cask (macOS)"
  community.general.homebrew_cask:
    name: $package
    state: present
    install_options: "appdir={{ user_appdir }}"
  when: $when
"""),
    "homebrew_tap": string.Template("""\
# Homebrew 7 refuses to load a third-party tap's formulae until the tap is
# trusted, and reports the refusal at TAP time as "invalid syntax in tap!" —
# naming neither trust nor the fix. Trust BEFORE tapping (dotfiles/managers.yaml).
- name: "Trust the $package tap"
  ansible.builtin.command:
    cmd: "brew trust --tap $package"
  register: ${var}_trust_tap
  changed_when: "'Already trusted' not in ${var}_trust_tap.stdout"
  when: $when

- name: "Tap $package"
  community.general.homebrew_tap:
    name: $package
    state: present
  when: $when
"""),
    "apt": string.Template("""\
- name: "Install $package via apt"
  ansible.builtin.apt:
    name: $package
    state: present
  become: true
  when: $when
"""),
}

REMOVE_PACKAGE = {
    "homebrew_formula": string.Template("""\
- name: "Remove $package via Homebrew"
  community.general.homebrew:
    name: $package
    state: absent
  when: $when
"""),
    "homebrew_cask": string.Template("""\
- name: "Remove $package via Homebrew Cask (macOS)"
  community.general.homebrew_cask:
    name: $package
    state: absent
  when: $when
"""),
    "homebrew_tap": string.Template("""\
# Install leaves TWO trust entries: the tap entry below, and a formula entry
# per formula installed from the tap — `brew untrust --tap` removes only the
# tap entry. Add one untrust --formula line per formula this topic installs
# (apps/opencode remove.yaml is the measured reference).
- name: "Untap $package"
  community.general.homebrew_tap:
    name: $package
    state: absent
  when: $when

- name: "Stop trusting the $package tap"
  ansible.builtin.command:
    cmd: "brew untrust --tap $package"
  register: ${var}_untrust_tap
  changed_when: "'Not trusted' not in ${var}_untrust_tap.stdout"
  when: $when
# - name: "Stop trusting the <formula> from $package"
#   ansible.builtin.command:
#     cmd: "brew untrust --formula $package/<formula>"
#   register: ${var}_untrust_formula
#   changed_when: "'Not trusted' not in ${var}_untrust_formula.stdout"
#   when: $when
"""),
    "apt": string.Template("""\
- name: "Remove $package via apt"
  ansible.builtin.apt:
    name: $package
    state: absent
  become: true
  when: $when
"""),
}

INSTALL_OUTLINE = {
    "apt_repository": string.Template("""\
# OUTLINE — third-party apt repository (apt_repository in dotfiles/managers.yaml).
# deb822_repository manages the repo file and its key; fill in the vendor's
# values. become: true is required.
# - name: "Add the $package apt repository"
#   ansible.builtin.deb822_repository:
#     name: $package
#     types: [deb]
#     suites: [<suite>]
#     components: [<component>]
#     url: <repository URL>
#     signed_by: <keyring path or URL>
#   become: true
#   when: $when
"""),
    "release_artifact": string.Template("""\
# OUTLINE — release artifact install (release_artifact in dotfiles/managers.yaml).
# No system role reaches these, so this topic MUST own its upgrade or it
# silently never updates: tag the fetch tasks [install, upgrade] so one
# checksum-compared fetch serves both phases (apps/ori, apps/ollama;
# docs/TOPICS.md § "Presence vs currency").
# - name: "Fetch the $package release archive"
#   ansible.builtin.get_url:
#     url: <release URL>
#     dest: <path under $$HOME>
#     checksum: sha256:<published checksum>
#   register: ${var}_fetch
#   tags: [install, upgrade]
# - name: "Unpack the $package archive"
#   ansible.builtin.unarchive:
#     src: <fetch dest>
#     dest: <install dir under $$HOME>
#     remote_src: true
#   when: ${var}_fetch is changed
#   tags: [install, upgrade]
"""),
}

REMOVE_OUTLINE = {
    "apt_repository": string.Template("""\
# OUTLINE — remove BOTH the repo file and the keyring, or the machine keeps
# fetching from a source nothing installs from (dotfiles/managers.yaml).
# - name: "Remove the $package apt repository"
#   ansible.builtin.deb822_repository:
#     name: $package
#     state: absent
#   become: true
#   when: $when
# - name: "Remove the $package repository keyring"
#   ansible.builtin.file:
#     path: <keyring path>
#     state: absent
#   become: true
#   when: $when
"""),
    "release_artifact": string.Template("""\
# OUTLINE — remove every path the fetch created: the unpacked install dir,
# the downloaded archive, and any symlink or PATH entry pointing at them.
# - name: "Remove the $package install dir"
#   ansible.builtin.file:
#     path: <install dir under $$HOME>
#     state: absent
#   when: $when
"""),
}


# ── Helpers ─────────────────────────────────────────────────────────


def find_repo(start: Path) -> Path:
    """Walk upward for the checkout holding the two inputs."""
    for candidate in (start, *start.parents):
        if (candidate / "dotfiles" / "managers.yaml").is_file() and (
            candidate / "dotfiles" / "template_dir"
        ).is_dir():
            return candidate
    raise ScaffoldError(
        f"no checkout with dotfiles/managers.yaml and dotfiles/template_dir "
        f"found at or above {start} — run from inside the repo or pass --repo"
    )


def os_guard(families: list[str]) -> str:
    if len(families) == 1:
        return f"ansible_facts['os_family'] == '{families[0]}'"
    listed = ", ".join(f"'{f}'" for f in families)
    return f"ansible_facts['os_family'] in [{listed}]"


def splice(path: Path, marker: str, replacement: str) -> None:
    text = path.read_text(encoding="utf-8")
    if marker not in text:
        raise ScaffoldError(
            f"{path}: splice marker {marker!r} not found — template_dir has drifted"
        )
    path.write_text(text.replace(marker, replacement, 1), encoding="utf-8")


def substitute_markers(root: Path, name: str) -> None:
    """Replace the template's name markers in every copied text file."""
    for path in sorted(root.rglob("*")):
        if not path.is_file():
            continue
        try:
            text = path.read_text(encoding="utf-8")
        except UnicodeDecodeError:
            continue
        if "<topic>" in text or "{{ app_name }}" in text:
            path.write_text(
                text.replace("<topic>", name).replace("{{ app_name }}", name),
                encoding="utf-8",
            )


def render_manager_blocks(
    managers: list[str],
    blocks: dict[str, string.Template],
    outlines: dict[str, string.Template],
    params: dict[str, str],
) -> str:
    if not managers:
        return (
            "# No package managers declared — this topic manages no packages.\n"
            "# Add one with `topical new ... --manager <name>`; the catalog is\n"
            "# dotfiles/managers.yaml."
        )
    parts = []
    for manager in managers:
        parts.append(f"# {BANNER_RULE}\n# {manager}\n# {BANNER_RULE}")
        if manager in blocks:
            parts.append(blocks[manager].substitute(params).rstrip())
        else:
            parts.append(outlines[manager].substitute(params).rstrip())
    return "\n\n".join(parts)


def render_vars(var_names: list[str], var_defs: dict[str, str]) -> str:
    if not var_names:
        return "  # No playbook vars required by the chosen managers."
    lines = ["  vars:"]
    for name in var_names:
        if name not in var_defs:
            raise ScaffoldError(
                f"managers.yaml lists playbook var {name!r} with no definition "
                f"in playbook_var_defs — add it there, not here"
            )
        lines.append(f"    {name}: {json.dumps(var_defs[name])}")
    return "\n".join(lines)


def upgrade_guidance(managers: list[str], meta: dict) -> str:
    """The generated section appended to upgrade.yaml."""
    if not managers:
        return ""
    uncovered = [m for m in managers if meta[m]["upgraded_by"] == "topic"]
    covered = sorted(
        {
            SYSTEM_ROLE_FOR[m]
            for m in managers
            if meta[m]["upgraded_by"] == "system_role"
        }
    )
    lines = [
        f"# {BANNER_RULE}",
        "# Generated upgrade guidance (topical new)",
        f"# {BANNER_RULE}",
    ]
    if covered:
        lines.append(
            f"# Covered by the {', '.join(covered)} upgrade pass — nothing to add here."
        )
    for manager in uncovered:
        lines.append(
            f"# WARNING: {manager} is upgraded_by: topic — no system "
            f"role reaches it.\n"
            f"# This topic MUST own its upgrade (docs/TOPICS.md "
            f"§ Presence vs currency);\n"
            f"# tag the install fetch [install, upgrade] as the outline shows."
        )
    return "\n\n" + "\n".join(lines) + "\n"


TOPIC_YML = """\
# apps/{name}/topic.yml — topic metadata read by the parent playbook.
# See docs/TOPICS.md.
topic_name: {name}
topic_provides: []
topic_requires: [{requires}]
topic_os: [{os_list}]
topic_tier: {tier}
"""


# ── Commands ────────────────────────────────────────────────────────


@app.callback()
def _callback() -> None:
    """Force group mode (future verbs need `new` to stay a verb).

    With one command Typer would collapse the CLI and drop the verb.
    """


@app.command()
def new(
    name: str = typer.Argument(..., help="Topic directory name under apps/."),
    tier: str = typer.Option("app", "--tier", help="|".join(VALID_TIERS)),
    os_list: list[str] | None = typer.Option(
        None, "--os", help="OS family; repeatable. Default: Darwin."
    ),
    requires: list[str] | None = typer.Option(
        None, "--requires", help="topic_requires entries; repeatable."
    ),
    managers: list[str] | None = typer.Option(
        None, "--manager", help="Package managers used; repeatable. See managers.yaml."
    ),
    package_name: str | None = typer.Option(
        None, "--package-name", help="Package name if it differs from the topic name."
    ),
    repo: Path | None = typer.Option(
        None, "--repo", help="Checkout to read managers.yaml and template_dir from."
    ),
    into: Path | None = typer.Option(
        None, "--into", help="Destination repo root. Default: same as --repo."
    ),
) -> None:
    """Scaffold a new topic under apps/, correct for its managers."""
    os_families = os_list or ["Darwin"]
    requires = requires or []
    managers = managers or []
    package = package_name or name

    # ── Input validation ─────────────────────────────────────────────
    if not NAME_RE.match(name):
        raise typer.BadParameter(
            f"topic name {name!r} must match {NAME_RE.pattern} "
            f"(e.g. 'firefox', 'visual-studio-code')"
        )
    if name in RESERVED_NAMES:
        raise typer.BadParameter(
            f"{name!r} is a reserved topical command — pick another topic name"
        )
    if tier not in VALID_TIERS:
        raise typer.BadParameter(f"--tier must be one of: {', '.join(VALID_TIERS)}")
    for family in os_families:
        if family not in VALID_OS:
            raise typer.BadParameter(f"--os must be one of: {', '.join(VALID_OS)}")

    try:
        repo_root = repo.resolve() if repo else find_repo(Path.cwd())
        managers_path = repo_root / "dotfiles" / "managers.yaml"
        template_dir = repo_root / "dotfiles" / "template_dir"
        data = yaml.safe_load(managers_path.read_text(encoding="utf-8"))
        var_defs: dict[str, str] = data.get("playbook_var_defs", {})
        meta: dict = data["managers"]

        # ── Manager validation ───────────────────────────────────────
        for manager in managers:
            if manager not in meta:
                valid = ", ".join(sorted(meta))
                raise ScaffoldError(
                    f"unknown manager {manager!r} — valid keys in "
                    f"managers.yaml: {valid}"
                )
            if manager not in PACKAGE_MANAGERS | OUTLINE_MANAGERS:
                raise ScaffoldError(
                    f"no scaffold template for manager {manager!r} — this is the\n"
                    f"agent-pass case (TASKS.md A9): scaffold without --manager and\n"
                    f"write the blocks by hand, or add a template to topical first"
                )
            overlap = [f for f in os_families if f in meta[manager]["os"]]
            if not overlap:
                raise ScaffoldError(
                    f"manager {manager!r} covers {meta[manager]['os']}, "
                    f"which does not\n"
                    f"overlap this topic's topic_os {os_families} — "
                    f"widen --os or drop\n"
                    f"the manager"
                )

        # ── Destination ──────────────────────────────────────────────
        dest_root = into.resolve() if into else repo_root
        dest = dest_root / "apps" / name
        if dest.exists():
            raise ScaffoldError(
                f"apps/{name} already exists at {dest} — topical new refuses to\n"
                f"overwrite. To regenerate an existing topic, scaffold to a scratch\n"
                f"dir with --into and reconcile by hand."
            )

        # ── Scaffold ─────────────────────────────────────────────────
        shutil.copytree(template_dir, dest)
        substitute_markers(dest, name)

        when = os_guard(os_families)
        params = {
            "topic": name,
            "package": package,
            "var": name.replace("-", "_"),
            "when": when,
        }

        var_names = list(
            dict.fromkeys(v for m in managers for v in meta[m]["playbook_vars"])
        )
        splice(
            dest / "playbook.yaml",
            "  # __PLAYBOOK_VARS__",
            render_vars(var_names, var_defs),
        )
        splice(
            dest / "tasks" / "install.yaml",
            "# __MANAGER_BLOCKS__",
            render_manager_blocks(managers, INSTALL_PACKAGE, INSTALL_OUTLINE, params),
        )
        splice(
            dest / "tasks" / "remove.yaml",
            "# __MANAGER_BLOCKS__",
            render_manager_blocks(managers, REMOVE_PACKAGE, REMOVE_OUTLINE, params),
        )

        (dest / "topic.yml").write_text(
            TOPIC_YML.format(
                name=name,
                requires=", ".join(requires),
                os_list=", ".join(os_families),
                tier=tier,
            ),
            encoding="utf-8",
        )

        guidance = upgrade_guidance(managers, meta)
        if guidance:
            upgrade = dest / "tasks" / "upgrade.yaml"
            upgrade.write_text(
                upgrade.read_text(encoding="utf-8") + guidance, encoding="utf-8"
            )
    except ScaffoldError as exc:
        typer.secho(str(exc), err=True, fg=typer.colors.RED)
        raise typer.Exit(1) from exc

    # ── Report ───────────────────────────────────────────────────────
    typer.echo(f"Scaffolded apps/{name} at {dest}")
    if managers:
        typer.echo(f"Managers emitted: {', '.join(managers)}")
        outlined = [m for m in managers if m in OUTLINE_MANAGERS]
        if outlined:
            typer.echo(
                f"Outline-only (fill in the commented skeletons): {', '.join(outlined)}"
            )
    else:
        typer.echo("No --manager given: install/remove carry no package blocks.")
    typer.echo(
        f"Verify: ansible-playbook apps/{name}/playbook.yaml --syntax-check "
        f"(from the checkout's dotfiles/ directory)"
    )


if __name__ == "__main__":
    app()
