#!/usr/bin/env bash
# skillify — author + publish a skill to the personal library, headlessly.
#
# Usage:
#   skillify [--bg] [--dir DIR] [--model M] "<request>"
#   skillify --help
#
#   --bg        run detached; log to ~/.local/state/skillify/<ts>.log, print PID
#   --dir DIR   directory opencode runs in (default: $PWD)
#   --model M   model override (provider/model-id), else opencode default
#
# The request is answered by an agent that loads the `skillify` skill
# (distributed into ~/.agents/skills by dotagents). The agent stops at the
# review gate: it prints the git/dotagents commands rather than running them.
set -euo pipefail

usage() { sed -n '2,14p' "$0"; }

bg=0 dir="$PWD" model=""
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --bg) bg=1 ;;
    --dir) dir="$2"; shift ;;
    --model) model="$2"; shift ;;
    -h|--help) usage; exit 0 ;;
    --*) printf 'unknown flag: %s\n' "$1" >&2; exit 2 ;;
    *) args+=("$1") ;;
  esac
  shift
done
[ ${#args[@]} -gt 0 ] || { usage >&2; exit 1; }
request="${args[*]}"

cmd=(opencode run --dir "$dir" --title "skillify: ${request:0:60}")
[ -n "$model" ] && cmd+=(--model "$model")
cmd+=("Load the skillify skill and follow it exactly. Request: $request")

if [ "$bg" -eq 1 ]; then
  log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/skillify"
  mkdir -p "$log_dir"
  log="$log_dir/$(date +%Y%m%d-%H%M%S).log"
  nohup "${cmd[@]}" >"$log" 2>&1 &
  echo "pid $! — log $log"
else
  exec "${cmd[@]}"
fi
