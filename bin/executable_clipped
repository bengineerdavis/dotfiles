# Script version
VERSION="1.0.0"

# Error handling
set -euo pipefail

# Function to display help
show_help() {
    cat << 'EOF'
clipped - Universal clipboard utility

USAGE:
    clipped [COMMAND]

COMMANDS:
    copy, c         Copy from stdin to system clipboard
    paste, p        Paste from system clipboard to stdout
    --help, -h      Show this help message
    --version       Show version information

EXAMPLES:
    echo 'hello world' | clipped copy
    clipped paste
    ls -la | clipped c
    clipped p > output.txt
    cat file.txt | clipped copy && clipped paste

SUPPORTED SYSTEMS:
    macOS           Uses pbcopy/pbpaste (built-in)
    Linux           Uses xclip, xsel, or wl-copy
    FreeBSD         Uses xclip or xsel
    Other Unix      Falls back to pbcopy/pbpaste if available

INSTALLATION REQUIREMENTS:
    macOS:          No additional packages needed
    Ubuntu/Debian:  sudo apt install xclip xsel wl-clipboard
    CentOS/RHEL:    sudo yum install xclip xsel
    Fedora:         sudo dnf install xclip xsel wl-clipboard
    Arch Linux:     sudo pacman -S xclip xsel wl-clipboard
    FreeBSD:        pkg install xclip xsel

EOF
}

# Function to display version
show_version() {
    echo "clipped version $VERSION"
    echo "Copyright (c) 2025 Ben Davis"
    echo "MIT License"
}

# Enhanced clipboard copy function
clipped_copy() {
    case "$(uname -s)" in
        Darwin) 
            # macOS - use native pbcopy
            if command -v pbcopy >/dev/null 2>&1; then
                pbcopy
            else
                echo "Error: pbcopy not found on macOS system" >&2
                exit 1
            fi
            ;;
        Linux|*BSD) 
            # Try clipboard utilities in order of preference
            if command -v xclip >/dev/null 2>&1; then
                xclip -selection clipboard
            elif command -v xsel >/dev/null 2>&1; then
                xsel --clipboard --input
            elif command -v wl-copy >/dev/null 2>&1; then
                # Wayland clipboard
                wl-copy
            elif command -v pbcopy >/dev/null 2>&1; then
                # Fallback to pbcopy if available (e.g., via homebrew on Linux)
                pbcopy
            else
                echo "Error: No clipboard utility found." >&2
                echo "Please install one of: xclip, xsel, wl-clipboard, or pbcopy" >&2
                exit 1
            fi
            ;;
        CYGWIN*|MINGW*|MSYS*)
            # Windows subsystems
            if command -v clip.exe >/dev/null 2>&1; then
                clip.exe
            elif command -v pbcopy >/dev/null 2>&1; then
                pbcopy
            else
                echo "Error: No clipboard utility found for Windows environment" >&2
                exit 1
            fi
            ;;
        *) 
            # Try pbcopy as last resort for unknown systems
            if command -v pbcopy >/dev/null 2>&1; then
                pbcopy
            else
                echo "Error: Unsupported operating system: $(uname -s)" >&2
                echo "Please install pbcopy or run on a supported system" >&2
                exit 1
            fi
            ;;
    esac
}

# Enhanced clipboard paste function
clipped_paste() {
    case "$(uname -s)" in
        Darwin) 
            # macOS - use native pbpaste
            if command -v pbpaste >/dev/null 2>&1; then
                pbpaste
            else
                echo "Error: pbpaste not found on macOS system" >&2
                exit 1
            fi
            ;;
        Linux|*BSD)
            # Try clipboard utilities in order of preference
            if command -v xclip >/dev/null 2>&1; then
                xclip -selection clipboard -o
            elif command -v xsel >/dev/null 2>&1; then
                xsel --clipboard --output
            elif command -v wl-paste >/dev/null 2>&1; then
                # Wayland clipboard
                wl-paste
            elif command -v pbpaste >/dev/null 2>&1; then
                # Fallback to pbpaste if available
                pbpaste
            else
                echo "Error: No clipboard utility found." >&2
                echo "Please install one of: xclip, xsel, wl-clipboard, or pbpaste" >&2
                exit 1
            fi
            ;;
        CYGWIN*|MINGW*|MSYS*)
            # Windows subsystems
            if command -v powershell.exe >/dev/null 2>&1; then
                powershell.exe -command "Get-Clipboard"
            elif command -v pbpaste >/dev/null 2>&1; then
                pbpaste
            else
                echo "Error: No clipboard utility found for Windows environment" >&2
                exit 1
            fi
            ;;
        *) 
            # Try pbpaste as last resort for unknown systems
            if command -v pbpaste >/dev/null 2>&1; then
                pbpaste
            else
                echo "Error: Unsupported operating system: $(uname -s)" >&2
                echo "Please install pbpaste or run on a supported system" >&2
                exit 1
            fi
            ;;
    esac
}

# Main command handler
main() {
    # Handle case when no arguments provided
    if [[ $# -eq 0 ]]; then
        echo "Error: No command specified" >&2
        echo "Use 'clipped --help' for usage information" >&2
        exit 1
    fi

    case "$1" in
        copy|c)
            clipped_copy
            ;;
        paste|p)
            clipped_paste
            ;;
        --help|-h|help)
            show_help
            ;;
        --version)
            show_version
            ;;
        *)
            echo "Error: Unknown command '$1'" >&2
            echo "" >&2
            echo "Usage: clipped {copy|paste|--help|--version}" >&2
            echo "" >&2
            echo "Commands:" >&2
            echo "  copy, c      Copy from stdin to clipboard" >&2
            echo "  paste, p     Paste from clipboard to stdout" >&2
            echo "  --help, -h   Show detailed help" >&2
            echo "  --version    Show version information" >&2
            echo "" >&2
            echo "Examples:" >&2
            echo "  echo 'hello world' | clipped copy" >&2
            echo "  clipped paste" >&2
            echo "  ls | clipped c" >&2
            echo "  clipped p > file.txt" >&2
            exit 1
            ;;
    esac
}

# Run main function with all arguments
main "$@"