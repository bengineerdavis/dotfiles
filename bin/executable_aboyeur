#!/usr/bin/env bash
# aboyeur — configure mise for the repo you are standing in, headlessly.
#
# Usage:
#   aboyeur [--bg] [--dir DIR] [--model M] [--check] ["<request>"]
#   aboyeur --help
#
#   --check     skip the agent; just run `mise doctor project` here
#   --bg        run detached; log to ~/.local/state/aboyeur/<ts>.log, print PID
#   --dir DIR   repository to configure (default: $PWD)
#   --model M   model override (provider/model-id), else opencode default
#
# The request is answered by an agent that loads the `aboyeur` skill
# (distributed into ~/.agents/skills by dotagents). The agent never installs
# tools or runs bootstrap without showing you the commands first.
set -euo pipefail

usage() { sed -n '2,15p' "$0"; }

bg=0 check=0 dir="$PWD" model=""
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --bg) bg=1 ;;
    --check) check=1 ;;
    --dir) dir="$2"; shift ;;
    --model) model="$2"; shift ;;
    -h|--help) usage; exit 0 ;;
    --*) printf 'unknown flag: %s\n' "$1" >&2; exit 2 ;;
    *) args+=("$1") ;;
  esac
  shift
done

if [ "$check" -eq 1 ]; then
  exec mise -C "$dir" doctor project
fi

[ ${#args[@]} -gt 0 ] || args=("Set up mise for this repository")
request="${args[*]}"

cmd=(opencode run --dir "$dir" --title "aboyeur: ${request:0:60}")
[ -n "$model" ] && cmd+=(--model "$model")
cmd+=("Load the aboyeur skill and follow it exactly for the repository in the current directory. Request: $request")

if [ "$bg" -eq 1 ]; then
  log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/aboyeur"
  mkdir -p "$log_dir"
  log="$log_dir/$(date +%Y%m%d-%H%M%S).log"
  nohup "${cmd[@]}" >"$log" 2>&1 &
  echo "pid $! — log $log"
else
  exec "${cmd[@]}"
fi
