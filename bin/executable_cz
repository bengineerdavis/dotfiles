#!/usr/bin/env bash
set -euo pipefail

main() { 
    # check if smart_wrap is available
    if ! command -v smart_wrap >/dev/null 2>&1; then
        echo "Error: 'smart_wrap' function not found. Please ensure it's defined in your shell environment." >&2
        return 1
    else
        # "Using 'smart_wrap' to access Chezmoi help..."
        smart_wrap chezmoi help "$@"; 
    fi
    }

main "$@"
