#!/usr/bin/env bash

# Homebrew Install Script
# This script both abstracts the process of installing Homebrew packages
# such that there is one common interface for both formulae and casks.

# It also provides logging and error handling capabilities.

# Author: Ben Davis
# License: MIT
# Author: Ben Davis w/ AI assistance
# Email: bengineerdavis@gmail.com
# Updated: 2025-12-25

# Main function
main() {
    echo "🍻 Homebrew universal package installer"
    echo "========================================"

    local package="$1"

    if [[ -z "$package" ]]; then
        echo "Usage: $0 <package-name>"
        exit 1
    fi

    if ! command -v brew &> /dev/null; then
        echo "Homebrew is not installed. Please install Homebrew first."
        exit 1
    fi

    if brew list --cask "$package" &> /dev/null; then
        echo "Cask package '$package' is already installed."
    elif brew list "$package" &> /dev/null; then
        echo "Formula '$package' is already installed."
    else
        echo "Installing '$package'..."
        if brew install --cask "$package"; then
            echo "'$package' has been successfully installed."
        else
            echo "Failed to install '$package'."
            exit 1
        fi
    fi
}

main "$@"