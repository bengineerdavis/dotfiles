#!/usr/bin/env bash
# -----------------------------------------------------------------------------
# ask-research — run a research brief through llm/OpenRouter as a RESUMABLE
# session: web search on, Zero-Data-Retention routing on, full transcript saved.
#
# Usage:
#   ask-research start BRIEF.md [--session NAME]     begin a session
#   ask-research ask "follow-up question"            continue it
#   ask-research ask-file NOTES.md                   continue with a file
#   ask-research show                                session info + transcript
#   ask-research list                                all sessions
#
# Options:
#   --session NAME   name the session (default: "default")
#   --model M        override the model
#   --no-online      disable web search
#   --no-zdr         disable Zero-Data-Retention routing (see the warning below)
#   --dry-run        print the llm command without running it
#   --approve-searches
#                    confirm every web query before it is sent. Use whenever the
#                    prompt is work-adjacent: a query is egress, and ZDR covers
#                    the inference endpoint, not the search provider.
#
# Dependencies:       llm, python3 (both must be on PATH)
#                     Installed and verified by the mise topic.
#
# Exit codes: 0 ok | 1 usage/aborted | 127 missing dependency
# -----------------------------------------------------------------------------
#
# Three llm features do the work (all verified against llm-openrouter 0.7):
#   -T get_answer -T get_contents  web search and page fetch, via llm-tools-exa.
#                              NOT `-o online true`, which is not a valid option
#                              on any openrouter model and errors with "Extra
#                              inputs are not permitted"; and not a `:online`
#                              model suffix, which does not exist either.
#                              Requires a separate Exa key: `llm keys set exa`.
#   -o provider '{"zdr":true}' route only to Zero-Data-Retention endpoints.
#   --cid <id>                 continue a specific conversation.
#
# WHY --cid AND NOT -c
# `llm -c` continues the *most recent* conversation globally — so any unrelated
# `llm` call in between silently hijacks your follow-up. This captures the
# conversation id on the first turn and targets it explicitly forever after.
#
# WHY OPTIONS ARE RE-PASSED EVERY TURN
# llm options do not persist across a conversation. ZDR and web search must be
# supplied on each call or a follow-up quietly downgrades — the leak would be
# invisible.
#
# ⚠ --online sends a search query derived from your prompt to Exa, a third
#   party. Fine for public-facts research; think twice for anything sensitive.
#
# Why this stays bash, provisionally:
#   CONVENTIONS.md calls for Python past ~80-100 lines. This sits at ~150 and is
#   a borderline case kept in bash because almost none of it is logic: it builds
#   an `llm` invocation, redirects the reply to a file, and appends to a
#   transcript. The one real computation — pulling conversation_id out of JSON —
#   already delegates to python3.
#
#   It earns a port the moment it needs to *read* what it stored, because
#   parsing transcripts in bash is exactly the error-prone work the convention
#   exists to prevent. Treat this header as the trigger, not an exemption.
# -----------------------------------------------------------------------------
set -euo pipefail

show_help() {
  # Print the header block between the first two ruler lines, comments stripped.
  # Marker-based so inserting lines above cannot desynchronise the help output,
  # which a hardcoded `sed -n '2,32p'` range silently would.
  # Two expressions rather than `s/^#\( \|$\)//`: `\|` is alternation in GNU
  # BRE but a literal pipe in BSD, so the one-liner silently left every line
  # prefixed with "# " on a stock macOS PATH.
  awk '/^# -{10,}$/{n++; next} n==1' "$0" | sed -e 's/^# //' -e 's/^#$//'
}

# Collect every missing dependency before failing, so one run reports all gaps.
# Runs before any file is created or opened for writing.
require() {
  local missing=() cmd
  for cmd in "$@"; do
    command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
  done
  if ((${#missing[@]})); then
    printf '%s: missing dependencies: %s\n' "${0##*/}" "${missing[*]}" >&2
    exit 127
  fi
}

# Print a diagnosis, not a usage line. $1 is the headline; every later argument
# is an indented context line, so callers can add detail without fighting
# quoting. Defined before argument parsing because the parser calls it.
fail() {
  printf 'ask-research: %s\n' "$1" >&2
  shift
  for line in "$@"; do printf '  %s\n' "$line" >&2; done
  exit 1
}

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/ask-research"
SESSION=default; MODEL=""; ONLINE=1; ZDR=1; DRY=0; APPROVE=0
CMD="${1:-}"; shift || true
ARG=""

needs_value() {
  # $1 = flag, $2 = the value as parsed. A flag consuming the next token is a
  # silent corruption when that token is another flag or absent entirely:
  # `--session --dry-run` would name a session "--dry-run".
  case "${2:-}" in
    ""|--*) fail "$1 needs a value" \
              "got: ${2:-(nothing — it was the last argument)}" \
              "example: $1 ${3:-VALUE}" ;;
  esac
}

while [ $# -gt 0 ]; do
  case "$1" in
    --session)   needs_value --session "${2:-}" NAME;  SESSION="$2"; shift 2 ;;
    --model)     needs_value --model   "${2:-}" MODEL; MODEL="$2";   shift 2 ;;
    --no-online) ONLINE=0; shift ;;
    --no-zdr)    ZDR=0; shift ;;
    --dry-run)   DRY=1; shift ;;
    --approve-searches) APPROVE=1; shift ;;
    -h|--help)   show_help; exit 0 ;;
    --*|-?)
      # Unknown flags used to fall through to the positional branch, so a typo
      # became the brief path and surfaced as "brief not found: --sesion".
      fail "unknown option: $1" \
        "valid options: --session --model --no-online --no-zdr --dry-run --help" \
        "run 'ask-research --help' for what each does" ;;
    *)
      if [ -n "$ARG" ]; then
        fail "unexpected extra argument: $1" \
          "already have: $ARG" \
          "this command takes one path or question; quote it if it contains spaces:" \
          "  ask-research ask \"your whole question here\""
      fi
      ARG="$1"; shift ;;
  esac
done

# Help and usage must not depend on anything being configured correctly. Reached
# when help is the *subcommand* (`ask-research --help`), which the flag loop
# above never sees. This has to run before dependency and key validation, or
# `--help` reports a missing API key instead of printing help.
case "$CMD" in
  -h|--help) show_help; exit 0 ;;
  "")        show_help; exit 1 ;;
esac

# Commands that actually send a prompt. `list` and `show` only read local state,
# so they must not be blocked by a missing tool or an unset search key.
SENDS=0
case "$CMD" in start|ask|ask-file) SENDS=1 ;; esac

# A dry run only prints the command it would have run, so it needs no tools.
if [ "$SENDS" = 1 ] && [ "$DRY" != 1 ]; then require llm python3; fi

case "$SESSION" in
  */*|.|..) fail "invalid session name: '$SESSION'" \
              "a session becomes a directory under $STATE" \
              "use a plain name, e.g. --session enc" ;;
esac

DIR="$STATE/$SESSION"; CIDFILE="$DIR/cid"; LOG="$DIR/transcript.md"
mkdir -p "$DIR" 2>/dev/null || fail "cannot create the session directory" \
  "path: $DIR" \
  "check permissions, or set XDG_STATE_HOME to a writable location"

# PyMuPDF writes its deprecation notice to STDOUT, which would land inside the
# saved response. Same fix as apps/mise/files/zsh/env.zsh, repeated so this
# script stays correct when run outside a configured shell.
export PYMUPDF_MESSAGE=fd:2

MODEL="${MODEL:-${OLLAMA_ROLE_ESCALATE:-openrouter/anthropic/claude-sonnet-5}}"

opts=()
[ "$ZDR" = 1 ] && opts+=(-o provider '{"zdr":true}')

# Web access is TOOLS, not an option. `-o online true` was invalid and failed
# every run with "Error: online / Extra inputs are not permitted"; llm-openrouter
# 0.7 advertises no `online` option and there is no `:online` model id either.
# llm-tools-exa registers get_answer (search with citations) and get_contents
# (fetch a URL), which suits a brief that demands primary sources better than a
# search flag would.
if [ "$ONLINE" = 1 ] && [ "$SENDS" = 1 ]; then
  # Exa needs its own key. Without one the model still calls the tools, gets a
  # 401 on each, and reasons its way to "I could not retrieve this" — burning
  # tokens to produce unsourced output, which is the exact failure this brief
  # style exists to prevent. Refuse up front instead.
  if ! llm keys list 2>/dev/null | grep -qx 'exa'; then
    fail "web research is on, but no Exa API key is configured" \
      "the search tools would return 401 and the answer would be unsourced" \
      "" \
      "fix it:      llm keys set exa" \
      "or proceed without web access, accepting unverified claims:" \
      "  ask-research $CMD ... --no-online"
  fi
  opts+=(-T get_answer -T get_contents)

  # ethics.yaml forbids egress bypassing human review. A search query is egress:
  # it is derived from the prompt and goes to a third party that ZDR routing says
  # nothing about. --tools-approve is the mechanical form of that gate — every
  # query is shown and confirmed before it leaves.
  if [ "$APPROVE" = 1 ]; then
    if ! (exec </dev/tty) 2>/dev/null; then
      fail "--approve-searches needs a terminal to ask at" \
        "there is none here, so it refuses rather than sending unreviewed queries" \
        "run it interactively, or drop the flag to send without review"
    fi
    opts+=(--tools-approve)
  fi
fi

# Count response files, excluding the accumulated transcript. `grep -c` exits
# non-zero on no match, so it cannot be combined with `|| echo 0` without
# printing twice.
count_turns() {
  local n=0 f
  for f in "$1"/*.md; do
    [ -e "$f" ] || continue
    case "$(basename "$f")" in transcript.md) ;; *) n=$((n+1)) ;; esac
  done
  printf '%s' "$n"
}

# Where a relative path might plausibly have been meant. The failure this exists
# for: a path relative to the chezmoi source tree, typed from somewhere else.
search_roots() {
  printf '%s\n' "$PWD" "$HOME/dotfiles" "$HOME/.local/share/chezmoi" "$HOME"
}

# Resolve a file argument, explaining precisely why it did not resolve.
# $1 = the argument, $2 = what it should be, for the message.
resolve_file() {
  local arg="$1" what="$2" root hit

  [ -n "$arg" ] || fail "no $what given" \
    "usage: ask-research $CMD <$what>" \
    "run 'ask-research --help' for the full usage"

  if [ -e "$arg" ]; then
    [ -d "$arg" ] && fail "'$arg' is a directory, not a $what"
    [ -r "$arg" ] || fail "'$arg' exists but is not readable" \
      "mode: $(ls -l "$arg" | awk '{print $1, $3, $4}')"
    [ -s "$arg" ] || fail "'$arg' is empty" \
      "a zero-byte brief would send an empty prompt"
    printf '%s' "$arg"
    return 0
  fi

  # Not found. Say what was actually tried, then look for it elsewhere — a
  # relative path resolves against the caller's cwd, which is the single most
  # common way this fails.
  local msgs=()
  case "$arg" in
    /*) msgs+=("looked for: $arg") ;;
    *)  msgs+=("looked for: $PWD/$arg" "(relative paths resolve against your current directory)") ;;
  esac

  while read -r root; do
    [ "$root" = "$PWD" ] && continue
    hit="$root/$arg"
    [ -f "$hit" ] && msgs+=("" "found it here instead:" "  $hit" "" "re-run with that path, or: cd $root")
  done < <(search_roots)

  # Fall back to a basename search when the whole relative path is wrong.
  if [ ${#msgs[@]} -le 2 ]; then
    local base found
    base="$(basename "$arg")"
    found="$(find "$PWD" "$HOME/dotfiles" -maxdepth 4 -name "$base" -type f 2>/dev/null | head -3)"
    [ -n "$found" ] && msgs+=("" "a file with that name exists at:" "$(printf '  %s\n' $found)")
  fi

  fail "$what not found: '$arg'" ${msgs[@]+"${msgs[@]}"}
}

# A follow-up needs a started session. When it is missing, the useful reply is
# what sessions do exist — usually the answer is a forgotten --session flag.
require_session() {
  if [ -s "$CIDFILE" ]; then return 0; fi
  local existing msgs=()
  # `|| true`: with no sessions the loop's last command fails, the subshell
  # exits non-zero, and under `set -e` the assignment takes the whole script
  # with it — silently, which is how this failed the first time.
  existing="$(for d in "$STATE"/*/; do
      [ -d "$d" ] || continue
      [ -s "$d/cid" ] || continue
      basename "$d"
    done 2>/dev/null || true)"
  if [ -n "$existing" ]; then
    msgs+=("started sessions:")
    while read -r s; do msgs+=("  $s  ($(count_turns "$STATE/$s") turns)"); done <<<"$existing"
    msgs+=("" "pick one with --session NAME, or start this one:")
  else
    msgs+=("no sessions have been started yet")
  fi
  msgs+=("  ask-research start BRIEF.md --session $SESSION")
  fail "session '$SESSION' has not been started" ${msgs[@]+"${msgs[@]}"}
}

banner() {
  { echo "session: $SESSION   model: $MODEL"
    echo "web    : $([ "$ONLINE" = 1 ] && echo 'ON (Exa tools: get_answer, get_contents)' || echo 'off — claims will not be web-verified')   \
zdr: $([ "$ZDR" = 1 ] && echo ON || echo '*** OFF — provider may retain ***')"
  } >&2
}

# Run one turn. $1 = stdin source file, $2 = human label for the transcript.
turn() {
  local src="$1" label="$2" cid_args=()
  [ -s "$CIDFILE" ] && cid_args=(--cid "$(cat "$CIDFILE")")

  if [ "$DRY" = 1 ]; then
    # `[*]` needs the same empty-array guard as `[@]`: bash 3.2 with `set -u`
    # treats an unset element expansion as an error, and macOS ships 3.2.
    echo "dry-run: llm -m $MODEL ${opts[*]+${opts[*]}} ${cid_args[*]+${cid_args[*]}} < $src" >&2
    return 0
  fi

  case "$MODEL" in *opus*|*gpt-5*|*kimi-k3*)
    # Fail closed when there is no terminal to ask at. Previously `read
    # </dev/tty` died half way through printing the question, leaving the
    # prompt on screen and no explanation of what went wrong.
    # `[ -r /dev/tty ]` is not enough: the device node exists and passes the
    # permission test even with no controlling terminal, then errors on open.
    # Actually opening it is the only reliable check.
    # The redirection has to happen inside a subshell: a failed redirect is
    # reported by the shell itself, so `: </dev/tty 2>/dev/null` still prints
    # "Device not configured" before our own message.
    if ! (exec </dev/tty) 2>/dev/null; then
      fail "'$MODEL' is an expensive tier and needs confirmation" \
        "no terminal is available to ask at, so this refuses rather than spending" \
        "run it interactively, or pick a cheaper model:" \
        "  ask-research $CMD ... --model \"\$OLLAMA_ROLE_ESCALATE\""
    fi
    printf 'Expensive tier (%s). Continue? [y/N] ' "$MODEL" >&2
    read -r ok </dev/tty || fail "could not read a confirmation from the terminal"
    case "$ok" in [yY]|[yY][eE][sS]) ;; *) fail "aborted — nothing was sent" ;; esac ;;
  esac

  local out err start rc; out="$DIR/$(date -u +%Y%m%dT%H%M%SZ).md"
  err="$DIR/.stderr"; start=$(date +%s)

  # Capture llm's stderr rather than letting set -e abort with no explanation,
  # and never leave a half-written response behind to be mistaken for a result.
  set +e
  llm -m "$MODEL" ${opts[@]+"${opts[@]}"} ${cid_args[@]+"${cid_args[@]}"} < "$src" > "$out" 2> "$err"
  rc=$?
  set -e
  if [ "$rc" -ne 0 ]; then
    rm -f "$out"
    local detail; detail="$(grep -v '^warning' "$err" | tail -3)"
    case "$detail" in
      *"No key found"*|*"API key"*)
        fail "llm could not authenticate (exit $rc)" "$detail" \
          "set a key: llm keys set openrouter" ;;
      *"Unknown model"*)
        fail "llm rejected the model '$MODEL' (exit $rc)" "$detail" \
          "list ids: llm models list" \
          "note ids are case-sensitive and must match 'ollama list' exactly" ;;
      *)
        fail "llm failed (exit $rc)" "${detail:-no stderr captured}" \
          "the response was discarded; the session is unchanged" ;;
    esac
  fi
  [ -s "$out" ] || { rm -f "$out"; fail "llm exited 0 but returned nothing" \
      "model: $MODEL" "this usually means the prompt was filtered or empty"; }
  rm -f "$err"

  # Capture the conversation id on the first turn so every later turn is
  # explicit rather than relying on "most recent".
  if [ ! -s "$CIDFILE" ]; then
    llm logs -n 1 --json 2>/dev/null \
      | python3 -c "import json,sys;d=json.load(sys.stdin);print((d[0] if isinstance(d,list) else d).get('conversation_id',''))" \
      > "$CIDFILE" 2>/dev/null || true
    if [ -s "$CIDFILE" ]; then
      echo "conversation: $(cat "$CIDFILE")" >&2
    else
      # Not fatal, but the consequence is specific and worth naming: without an
      # id, follow-ups fall back to "most recent", which any unrelated llm call
      # can steal.
      echo "warning: could not capture the conversation id — follow-ups in this" >&2
      echo "         session may attach to a different conversation" >&2
    fi
  fi

  { echo; echo "## $label — $(date -u +%FT%TZ)"; echo; cat "$out"; } >> "$LOG"
  echo "done in $(( $(date +%s) - start ))s → $out" >&2
  echo "appended to $LOG" >&2
  cat "$out"
}

case "$CMD" in
  start)
    BRIEF="$(resolve_file "$ARG" "brief")"
    [ -s "$CIDFILE" ] && fail "session '$SESSION' has already been started" \
      "started: $(date -u -r "$CIDFILE" +%FT%TZ 2>/dev/null || echo unknown)" \
      "turns so far: $(count_turns "$DIR")" \
      "continue it:  ask-research ask \"...\" --session $SESSION" \
      "start fresh:  ask-research start $ARG --session <new-name>"
    banner; echo "brief  : $BRIEF (~$(wc -w < "$BRIEF" | tr -d ' ') words)" >&2; echo >&2
    turn "$BRIEF" "BRIEF: $(basename "$BRIEF")"
    ;;
  ask)
    [ -n "$ARG" ] || fail "no question given" \
      'usage: ask-research ask "your question" [--session NAME]' \
      "to send a file instead: ask-research ask-file NOTES.md"
    require_session
    banner; printf '%s\n' "$ARG" > "$DIR/.q"; turn "$DIR/.q" "Q: $ARG"
    ;;
  ask-file)
    FILE="$(resolve_file "$ARG" "file")"
    require_session
    banner; turn "$FILE" "FILE: $(basename "$FILE")"
    ;;
  show)
    echo "session : $SESSION"; echo "dir     : $DIR"
    echo "cid     : $([ -s "$CIDFILE" ] && cat "$CIDFILE" || echo '(not started)')"
    echo "turns   : $(count_turns "$DIR")"
    # An `&&` list here is the last command in the branch, so its failure
    # becomes the script's exit status: `show` on a session with no transcript
    # yet reported failure while printing a perfectly good summary.
    if [ -f "$LOG" ]; then
      echo "---"; tail -40 "$LOG"
    else
      echo "(no transcript yet — nothing has been sent in this session)"
    fi
    ;;
  list)
    for d in "$STATE"/*/; do
      [ -d "$d" ] || continue
      n=$(basename "$d")
      printf '  %-18s turns=%-4s cid=%s\n' "$n" \
        "$(count_turns "$d")" \
        "$([ -s "$d/cid" ] && cat "$d/cid" || echo '-')"
    done ;;
  # Help is a successful outcome. Reached when help is the *subcommand*
  # (`ask-research --help`); the flag loop above handles it after a subcommand.
  -h|--help) show_help; exit 0 ;;
  *) show_help; exit 1 ;;
esac
