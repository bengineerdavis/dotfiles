#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "typer",
#   "rich",
# ]
# ///
# ---------------------------------------------------------------------------------------
# Script Name:        model-bench
# Description:        Benchmark LLM models for use as binned judges.
#                     Inspired by hyperfine — runs each model N times against a fixed
#                     scoring task, measures latency/success/JSON-validity/score quality,
#                     and prints a ranked results table.
#
# Usage:              model-bench [OPTIONS] [MODEL...]
#
# Typical workflows:
#   model-bench                                  # benchmark all models from binned config
#   model-bench devstral-small-2 qwen3.5:9b      # benchmark specific models
#   model-bench --update-config                  # benchmark + write winners to config
#   model-bench --runs 5 --warmup 2 --verbose    # more runs, show per-run detail
#   model-bench --export-json results.json       # export raw data
#   model-bench --setup                          # re-run the interactive guide
# ---------------------------------------------------------------------------------------
from __future__ import annotations

import datetime
import json
import os
import pathlib
import re
import shutil
import statistics
import subprocess
import sys
import time
import tomllib
from concurrent.futures import ThreadPoolExecutor, as_completed
from dataclasses import dataclass, field
from typing import Callable, Optional

import typer
from rich import box
from rich.console import Console
from rich.panel import Panel
from rich.progress import BarColumn, Progress, SpinnerColumn, TaskProgressColumn, TextColumn, TimeElapsedColumn
from rich.rule import Rule
from rich.table import Table
from rich.text import Text

VERSION = "0.2.0"

# ── Environment ────────────────────────────────────────────────────────────────

# llm's pdf plugin imports PyMuPDF, whose fitz shim prints a deprecation notice —
# and PyMuPDF's default message stream is stdout, not stderr. That line lands at
# the head of every captured llm response, so json.loads() fails on all of them:
# json_rate reads 0/N for every model, mean_score collapses to 0, and the
# composite degenerates into a pure latency ranking that looks like a real
# result. Route PyMuPDF's messages to stderr. Same fix as bin/pii-redactor.
os.environ.setdefault("PYMUPDF_MESSAGE", "fd:2")

# ── Paths ──────────────────────────────────────────────────────────────────────

BINNED_DIR  = pathlib.Path(os.environ.get("BINNED_HOME", str(pathlib.Path.home() / ".binned")))
CONFIG_FILE = BINNED_DIR / "config.toml"
SETUP_FILE  = BINNED_DIR / "model-bench-setup.json"

console = Console()

# ── Judge system prompt (mirrors binned's _JUDGE_SYSTEM) ──────────────────────

_JUDGE_SYSTEM = """\
You are a senior shell-script reviewer assessing a bash script generated by a tool
called `binned`. The tool follows a strict boilerplate template.

Score the script on FIVE criteria (each 0–10). Return ONLY valid JSON — no prose,
no markdown fences — matching this exact schema:

{
  "structure":    <int 0-10>,
  "correctness":  <int 0-10>,
  "safety":       <int 0-10>,
  "style":        <int 0-10>,
  "completeness": <int 0-10>,
  "verdict":      "pass" | "needs-work" | "fail",
  "note":         "<one sentence explaining the biggest strength or weakness>"
}

Scoring rubric:
  structure    10 = has #!/usr/bin/env bash, set -euo pipefail, die(), usage() with
                    --help/-h --verbose/-v --dry-run, argument parser, entry-point block
               5  = most boilerplate present but one section missing or stub
               0  = bare script, no boilerplate
  correctness  10 = fully implements the described command's behaviour
               5  = implements the core action but misses edge cases
               0  = does something unrelated or is broken
  safety       10 = all variables quoted, no injection risk, dangerous ops guarded
               5  = minor quoting gaps on non-user-controlled variables
               0  = obvious injection risk or unguarded destructive operations
  style        10 = UPPER_SNAKE_CASE globals, lower_snake_case locals, comments
                    explain WHY non-obvious things happen (not WHAT)
               5  = naming mostly correct; some what-comments present
               0  = no naming conventions; descriptive comments absent
  completeness 10 = all skeleton placeholders filled; realistic usage examples;
                    dry-run path prints what would happen
               5  = some placeholders remain (e.g. "[add example]")
               0  = majority of body is stubs or TODO comments

verdict:
  "pass"       if mean >= 7.0
  "needs-work" if 5.0 <= mean < 7.0
  "fail"       if mean < 5.0"""

# ── Golden reference script ────────────────────────────────────────────────────

_GOLDEN_COMMAND = "rsync -avz --delete ~/Documents/ user@server:/backup/documents/"

_GOLDEN_SCRIPT = """\
#!/usr/bin/env bash
set -euo pipefail

REMOTE_USER="user"
REMOTE_HOST="server"
REMOTE_PATH="/backup/documents/"
SOURCE_DIR="${HOME}/Documents/"
RSYNC_FLAGS=(-avz --delete)

die()   { echo "ERROR: $*" >&2; exit 1; }
info()  { echo "[rsync-backup] $*"; }
usage() {
    cat <<EOF
Usage: rsync-backup [OPTIONS]
  Sync ~/Documents/ to ${REMOTE_USER}@${REMOTE_HOST}:${REMOTE_PATH}
Options:
  -h, --help      Show this help and exit
  -v, --verbose   Extra verbosity passed to rsync
  -n, --dry-run   Show what would be transferred without making changes
Examples:
  rsync-backup
  rsync-backup --dry-run
EOF
}

VERBOSE=false
DRY_RUN=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)    usage; exit 0 ;;
        -v|--verbose) VERBOSE=true ;;
        -n|--dry-run) DRY_RUN=true ;;
        *) die "Unknown option: $1" ;;
    esac
    shift
done

[[ "$VERBOSE" == true ]] && RSYNC_FLAGS+=("--progress")
[[ "$DRY_RUN"  == true ]] && RSYNC_FLAGS+=("--dry-run")
[[ "$DRY_RUN"  == true ]] && info "DRY RUN — no files will be transferred"

info "Syncing ${SOURCE_DIR} → ${REMOTE_USER}@${REMOTE_HOST}:${REMOTE_PATH}"
rsync "${RSYNC_FLAGS[@]}" "${SOURCE_DIR}" "${REMOTE_USER}@${REMOTE_HOST}:${REMOTE_PATH}"
info "Done."
"""

_GOLDEN_PROMPT = (
    f"Original command the script was generated from:\n\n"
    f"    {_GOLDEN_COMMAND}\n\n"
    f"Generated script:\n\n"
    f"```bash\n{_GOLDEN_SCRIPT}\n```\n\n"
    f"Score this script according to the rubric."
)

# ── Reference scorecard ────────────────────────────────────────────────────────
#
# What a careful reviewer scores _GOLDEN_SCRIPT against the rubric above. This is
# the yardstick: a judge is measured by how close it lands to these numbers, not
# by how high it scores. Without it the benchmark rewarded generosity — a model
# returning straight 10s beat one that correctly found the script's real gaps.
#
# These are a considered reading, not ground truth, and they are deliberately a
# visible constant so they can be argued with. Re-derive them if _GOLDEN_SCRIPT
# ever changes; a stale reference is worse than none.
#
#   structure    9  — shebang, set -euo pipefail, die(), usage() with all three
#                     documented flags, and a real parser are all present. Short
#                     of 10 only because there is no main()/entry-point block;
#                     the script just runs off the end.
#   correctness  8  — reproduces the original rsync invocation exactly and wires
#                     both flags through. Loses points on edge cases: SOURCE_DIR
#                     is never checked for existence, and "Done." is printed
#                     unconditionally, including after a dry run.
#   safety       7  — every expansion is quoted and there is no injection route,
#                     but `--delete` against a remote is genuinely destructive
#                     and is guarded only by an opt-in --dry-run. The rubric asks
#                     for dangerous operations to be guarded; this one is not.
#   style        6  — naming follows the convention (UPPER_SNAKE globals,
#                     lower_snake functions), but the script carries no comments
#                     at all, and the rubric explicitly wants comments explaining
#                     WHY. That is the single biggest gap.
#   completeness 9  — no placeholders left, usage examples are realistic, and the
#                     dry-run path announces itself before doing nothing.
#
# Mean 7.8. Note this is well below the 10.0 that two local models awarded it.
_GOLDEN_REFERENCE: dict[str, int] = {
    "structure":    9,
    "correctness":  8,
    "safety":       7,
    "style":        6,
    "completeness": 9,
}
_GOLDEN_REFERENCE_VERDICT = "pass"

_SCORE_KEYS = tuple(_GOLDEN_REFERENCE)


def calibration(scores: dict[str, int]) -> float:
    """
    How close a judge's scorecard sits to _GOLDEN_REFERENCE, in 0..1.

    Mean absolute error across the five criteria, normalised by the 0-10 scale
    and inverted, so 1.0 is a perfect match and being wrong in either direction
    costs the same. Overrating is a real failure mode for a judge — it waves
    through scripts that should have been sent back — so it must not be rewarded.
    """
    error = sum(abs(scores[k] - _GOLDEN_REFERENCE[k]) for k in _SCORE_KEYS)
    return max(0.0, 1.0 - (error / len(_SCORE_KEYS)) / 10.0)


# ── Data types ─────────────────────────────────────────────────────────────────

@dataclass
class BenchRun:
    model:      str
    latency_s:  float
    success:    bool
    json_valid: bool
    mean_score: float | None
    # Per-criterion scores are kept, not just their mean: calibration is measured
    # against _GOLDEN_REFERENCE criterion by criterion, and a mean alone would let
    # offsetting errors cancel out and look like agreement.
    scores:     dict[str, int] | None = None
    verdict:    str = field(default="")
    raw:        str = field(default="", repr=False)
    error:      str = field(default="", repr=False)


@dataclass
class ModelStats:
    model:          str
    runs:           list[BenchRun]
    p50_latency:    float
    mean_latency:   float
    stddev_latency: float
    success_rate:   float
    json_rate:      float
    mean_score:     float
    score_stddev:   float
    calibration:    float   # 1.0 = matches _GOLDEN_REFERENCE exactly
    verdict_match:  float   # fraction of runs agreeing with the reference verdict
    composite:      float


@dataclass
class CheckItem:
    name:        str
    description: str
    optional:    bool
    test:        Callable[[], bool]
    fix_hint:    str                  # shown as-is; may contain newlines
    fix_cmd:     str | None = None    # suggested command; user can override


# ── Preflight checks ───────────────────────────────────────────────────────────

def _check_llm_present() -> bool:
    return shutil.which("llm") is not None


def _check_llm_has_models() -> bool:
    try:
        r = subprocess.run(["llm", "aliases", "list"],
                           capture_output=True, text=True, timeout=10)
        if r.returncode == 0 and r.stdout.strip():
            return True
        r2 = subprocess.run(["llm", "models", "list"],
                            capture_output=True, text=True, timeout=10)
        return r2.returncode == 0 and bool(r2.stdout.strip())
    except Exception:
        return False


def _check_ollama_present() -> bool:
    return shutil.which("ollama") is not None


def _get_checks() -> list[CheckItem]:
    is_mac = sys.platform == "darwin"
    ollama_install = (
        "brew install ollama"
        if is_mac
        else "curl -fsSL https://ollama.com/install.sh | sh"
    )
    return [
        CheckItem(
            name="llm CLI",
            description="The llm CLI is required to call language models for benchmarking.",
            optional=False,
            test=_check_llm_present,
            fix_hint="Install with pipx (recommended) or pip:",
            fix_cmd="pipx install llm",
        ),
        CheckItem(
            name="llm has at least one model",
            description=(
                "llm needs at least one model or alias configured before benchmarking."
            ),
            optional=False,
            test=_check_llm_has_models,
            fix_hint=(
                "Choose one:\n"
                "  Local (free):  ollama pull devstral-small-2  (then: llm install llm-ollama)\n"
                "  Claude (paid): llm install llm-claude && llm keys set claude\n"
                "  OpenAI (paid): llm install llm-openai && llm keys set openai"
            ),
            fix_cmd=None,   # too model-specific; let the user choose
        ),
        CheckItem(
            name="ollama  [local models]",
            description="ollama is needed to run local models. Skip if you only use cloud APIs.",
            optional=True,
            test=_check_ollama_present,
            fix_hint=f"Install from https://ollama.com  or run:",
            fix_cmd=ollama_install,
        ),
    ]


# ── Interactive preflight ──────────────────────────────────────────────────────

def _run_interactive_check(item: CheckItem) -> bool:
    """
    Show the check status.  If it fails, offer options to fix it interactively.
    Returns True when the check passes (now or after a fix), False if skipped.
    """
    if item.test():
        where = shutil.which("llm") or "" if "llm CLI" in item.name else ""
        note  = f" [dim]({where})[/dim]" if where else ""
        console.print(f"  [green]✓[/green]  {item.name}{note}")
        return True

    marker = "[yellow]~[/yellow]" if item.optional else "[red]✗[/red]"
    label  = "(optional) " if item.optional else ""
    console.print(f"  {marker}  {item.name}  [dim]{label}not found[/dim]")
    console.print(f"      [dim]{item.description}[/dim]")
    console.print()

    # Show the fix hint (may be multi-line)
    for line in item.fix_hint.splitlines():
        console.print(f"      {line}")
    console.print()

    while True:
        # Build the menu dynamically
        options: list[tuple[str, str]] = []
        if item.fix_cmd:
            options.append(("R", f"Run:  {item.fix_cmd}"))
        options.append(("C", "Custom command  (I'll type the command to run)"))
        options.append(("M", "Manual  (I'll run it myself — press Enter when done)"))
        skip_note = "optional — won't break benchmarking" if item.optional else "may cause errors later"
        options.append(("S", f"Skip  [{skip_note}]"))

        for key, label in options:
            console.print(f"      [[bold]{key}[/bold]]  {label}")

        raw = console.input("\n      → ").strip().lower()

        run_cmd: str | None = None
        if raw in ("r", "run") and item.fix_cmd:
            run_cmd = item.fix_cmd
        elif raw in ("c", "custom") or (raw not in ("r", "m", "s", "") and raw):
            custom = console.input("      Command to run: ").strip()
            if custom:
                run_cmd = custom
        elif raw in ("m", "manual", ""):
            console.print("      Run the command above, then press [bold]Enter[/bold] to re-check…")
            try:
                input()
            except (EOFError, KeyboardInterrupt):
                pass
        elif raw in ("s", "skip"):
            if not item.optional:
                console.print(
                    f"      [yellow]Warning:[/yellow] {item.name} is required. "
                    "Some features may fail."
                )
            console.print()
            return False
        else:
            continue  # unrecognised — redisplay menu

        if run_cmd:
            console.print(f"\n      [dim]$ {run_cmd}[/dim]\n")
            subprocess.run(run_cmd, shell=True)   # live output; not captured
            console.print()

        # Re-check after any action
        if item.test():
            console.print(f"      [green]✓[/green]  {item.name} — ready!\n")
            return True
        else:
            console.print(f"      [yellow]Still not detected.[/yellow] Try again or skip.\n")


def _run_preflight() -> bool:
    """Run all checks interactively. Returns False if any required check remains unmet."""
    console.print(Rule("[bold]Preflight checks[/bold]", style="dim"))
    console.print()

    checks   = _get_checks()
    skipped  = []
    all_good = True

    for item in checks:
        passed = _run_interactive_check(item)
        if not passed:
            skipped.append(item.name)
            if not item.optional:
                all_good = False

    if skipped:
        console.print(f"[dim]Skipped: {', '.join(skipped)}[/dim]")

    if not all_good:
        console.print(
            "\n[yellow]One or more required checks did not pass.[/yellow]\n"
            "model-bench may not work correctly. Fix them and re-run, or use:\n"
            "  model-bench --setup"
        )

    return all_good


# ── Interactive guide ──────────────────────────────────────────────────────────

_PAGES: list[tuple[str, str]] = [
    (
        "What model-bench does",
        """\
[bold]model-bench[/bold] runs each of your LLM models against a fixed scoring task
and measures three things:

  [cyan]JSON validity[/cyan]   Can it reliably return structured JSON?
                  (required — binned's judge panel breaks on invalid output)

  [cyan]Latency[/cyan]         p50 response time across N runs

  [cyan]Calibration[/cyan]     How close its scorecard sits to the reference one —
                  overrating costs exactly as much as underrating.

Results are ranked by a [bold]composite score[/bold]:
  calibration × 0.40  +  JSON validity × 0.35  +  speed × 0.25

The winner is the model that best balances accuracy and reliability.
A fast model that returns garbage JSON scores worse than a slower,
accurate one.""",
    ),
    (
        "Running a benchmark",
        """\
[bold]Basic usage:[/bold]

  [cyan]model-bench[/cyan]                              # all models in binned config
  [cyan]model-bench devstral-small-2 phi4:14b[/cyan]    # specific models
  [cyan]model-bench --runs 5 --warmup 2[/cyan]          # more runs for precision
  [cyan]model-bench --sequential[/cyan]                 # one model at a time (strict latency)

[bold]Key flags:[/bold]

  [bold]-n[/bold] / [bold]--runs[/bold]    INT    benchmark runs per model  [dim](default 3)[/dim]
  [bold]-w[/bold] / [bold]--warmup[/bold]  INT    warmup runs, discarded from stats  [dim](default 1)[/dim]
  [bold]-t[/bold] / [bold]--timeout[/bold] INT    per-run timeout in seconds  [dim](default 180)[/dim]
  [bold]-v[/bold] / [bold]--verbose[/bold]       show per-run breakdown after the table

Warmup runs let the model load into memory so they don't skew latency.
Use [bold]--sequential[/bold] when you want fair head-to-head latency comparisons
(parallel runs compete for CPU/RAM).""",
    ),
    (
        "Reading the results table",
        """\
[bold]Column guide:[/bold]

  [bold]Rank[/bold]       overall position by composite score
  [bold]Model[/bold]      alias as registered with llm
  [bold]p50[/bold]        median latency    [bold]±[/bold]  standard deviation
  [bold]OK[/bold]         runs that exited 0  [dim](model available + responded)[/dim]
  [bold]JSON[/bold]       runs where the response parsed as valid JSON
  [bold]Score[/bold]      mean judge score 0–10 across valid runs
  [bold]████░[/bold]      composite score bar

[bold]What to look for:[/bold]

  [green]✓[/green] JSON = 3/3 and Score ≥ 7.0  →  excellent judge; use as primary
  [yellow]~[/yellow] JSON = 2/3 or Score 5–7      →  acceptable fallback
  [red]✗[/red] JSON = 0/3 or times out        →  remove from panel entirely

A model that sometimes returns valid JSON is less reliable than a slower
model that always does — JSON validity is weighted highest for that reason.""",
    ),
    (
        "Updating binned config & next steps",
        """\
[bold]Update your binned judge pool automatically:[/bold]

  [cyan]model-bench --update-config[/cyan]           # write top-8 local models → config
  [cyan]model-bench --update-config --top 5[/cyan]   # write top-5 instead

This sets [bold]local_judge_pool[/bold] in [dim]~/.binned/config.toml[/dim].
binned reads this as the ordered fallback pool when a judge fails.

[bold]Export results for offline analysis:[/bold]

  [cyan]model-bench --export-json results.json[/cyan]

[bold]Combine with binned:[/bold]

  After updating config, run [cyan]binned config[/cyan] to see the pool in context.
  Run [cyan]binned self-improve[/cyan] to test judges on a real script.

[bold]Re-run this guide anytime:[/bold]

  [cyan]model-bench --setup[/cyan]""",
    ),
]


def _run_tutorial() -> None:
    total = len(_PAGES)
    for i, (title, content) in enumerate(_PAGES, 1):
        console.print()
        console.print(
            Panel(
                content,
                title=f"[bold]{title}[/bold]",
                subtitle=f"[dim]{i} / {total}[/dim]",
                border_style="dim",
                padding=(1, 2),
            )
        )
        if i < total:
            try:
                console.input("[dim]  Press Enter for next…[/dim]  ")
            except (EOFError, KeyboardInterrupt):
                console.print()
                break
        else:
            console.print()


def _run_setup() -> bool:
    """
    Combined first-run experience: preflight checks + optional tutorial.
    Returns True if it's safe to proceed with benchmarking.
    """
    console.print()
    console.print(
        Panel(
            "[bold]Welcome to model-bench[/bold]\n\n"
            "This guide will check that your environment is ready and show\n"
            "you how to get the most out of model-bench.\n\n"
            "It only runs once. Re-launch anytime with:  [cyan]model-bench --setup[/cyan]",
            border_style="cyan",
            padding=(1, 2),
        )
    )
    console.print()

    ok = _run_preflight()
    console.print()

    # Offer the tutorial regardless of preflight result (it's informational)
    try:
        show = console.input(
            "[bold]Show the quick-start guide?[/bold]  "
            "[[bold]Y[/bold]]es / [[bold]N[/bold]]o  → "
        ).strip().lower()
    except (EOFError, KeyboardInterrupt):
        show = "n"
        console.print()

    if show not in ("n", "no"):
        _run_tutorial()

    # Persist setup state
    BINNED_DIR.mkdir(parents=True, exist_ok=True)
    SETUP_FILE.write_text(json.dumps({
        "setup_completed_at": datetime.datetime.utcnow().isoformat(),
        "preflight_ok": ok,
    }, indent=2))

    if ok:
        console.print(Rule("[bold green]Setup complete[/bold green]", style="green"))
        console.print()
    else:
        console.print(
            Rule("[bold yellow]Setup complete with warnings[/bold yellow]", style="yellow")
        )
        console.print()

    return ok


# ── Benchmark core ─────────────────────────────────────────────────────────────

_JSON_FENCE_RE = re.compile(r"^```(?:json)?\s*", re.MULTILINE)
_FENCE_END_RE  = re.compile(r"```\s*$",          re.MULTILINE)


def _run_once(model: str, timeout: int) -> BenchRun:
    t0 = time.perf_counter()
    try:
        result = subprocess.run(
            ["llm", "-m", model, "--system", _JUDGE_SYSTEM, _GOLDEN_PROMPT],
            capture_output=True, text=True, timeout=timeout,
        )
        latency = time.perf_counter() - t0
        success = result.returncode == 0
        raw     = result.stdout.strip()

        cleaned = _JSON_FENCE_RE.sub("", raw)
        cleaned = _FENCE_END_RE.sub("", cleaned).strip()

        try:
            data   = json.loads(cleaned)
            # int() so a model answering "9" as a string still counts as valid;
            # a non-numeric answer raises and is caught as invalid JSON below.
            scores = {key: int(data[key]) for key in _SCORE_KEYS}
            return BenchRun(model=model, latency_s=latency, success=success,
                            json_valid=True,
                            mean_score=sum(scores.values()) / len(scores),
                            scores=scores,
                            verdict=str(data.get("verdict", "")).strip().lower(),
                            raw=raw)
        except Exception:
            return BenchRun(model=model, latency_s=latency, success=success,
                            json_valid=False, mean_score=None, raw=raw,
                            error=result.stderr[:200])
    except subprocess.TimeoutExpired:
        return BenchRun(model=model, latency_s=time.perf_counter() - t0,
                        success=False, json_valid=False, mean_score=None, error="timeout")
    except Exception as exc:
        return BenchRun(model=model, latency_s=time.perf_counter() - t0,
                        success=False, json_valid=False, mean_score=None, error=str(exc))


def _compute_stats(model: str, runs: list[BenchRun]) -> ModelStats:
    latencies    = [r.latency_s for r in runs]
    good         = [r for r in runs if r.json_valid and r.mean_score is not None]
    scores       = [r.mean_score for r in good]   # type: ignore[misc]
    success_rate = sum(1 for r in runs if r.success) / len(runs)
    json_rate    = len(good) / len(runs)
    mean_score   = statistics.mean(scores) if scores else 0.0
    p50          = statistics.median(latencies)

    # Calibration against _GOLDEN_REFERENCE, not raw magnitude. The previous
    # formula used mean_score/10 with nothing to compare against, so it scored
    # generosity: a model answering straight 10s beat one that correctly found
    # the golden script's real gaps. Measured here, two local models did exactly
    # that — both awarded 10.0 to a script with no comments and an unguarded
    # `--delete`, and outranked the model that caught it.
    cal = [calibration(r.scores) for r in good if r.scores]
    mean_calibration = statistics.mean(cal) if cal else 0.0
    verdict_match = (
        sum(1 for r in good if r.verdict == _GOLDEN_REFERENCE_VERDICT) / len(good)
        if good else 0.0
    )

    composite = (
        json_rate * 0.35
        + mean_calibration * 0.40
        + max(0.0, 1.0 - p50 / 120.0) * 0.25
    )
    return ModelStats(
        model=model, runs=runs,
        p50_latency=p50,
        mean_latency=statistics.mean(latencies),
        stddev_latency=statistics.stdev(latencies) if len(latencies) > 1 else 0.0,
        success_rate=success_rate,
        json_rate=json_rate,
        mean_score=mean_score,
        score_stddev=statistics.stdev(scores) if len(scores) > 1 else 0.0,
        calibration=mean_calibration,
        verdict_match=verdict_match,
        composite=composite,
    )


def _benchmark_model(
    model: str, n_runs: int, n_warmup: int, timeout: int, progress, task_id
) -> ModelStats:
    progress.update(task_id, description=f"  [dim]{model:<36s}[/dim] warming up…")
    for _ in range(n_warmup):
        _run_once(model, timeout)
        progress.advance(task_id)

    runs: list[BenchRun] = []
    for i in range(n_runs):
        run = _run_once(model, timeout)
        runs.append(run)
        progress.advance(task_id)
        status = "✓" if run.json_valid else ("~" if run.success else "✗")
        progress.update(task_id,
            description=f"  [cyan]{model:<36s}[/cyan] run {i+1}/{n_runs}  {status}")

    progress.update(task_id, description=f"  [green]{model:<36s}[/green] done")
    return _compute_stats(model, runs)


# ── Output ─────────────────────────────────────────────────────────────────────

def _bar(value: float, width: int = 8) -> Text:
    filled = max(0, min(width, round(value * width)))
    color  = "green" if value >= 0.75 else ("yellow" if value >= 0.45 else "red")
    return Text("█" * filled + "░" * (width - filled), style=color)


def _print_results(ranked: list[ModelStats], n_runs: int, verbose: bool) -> None:
    console.print()
    tbl = Table(
        box=box.ROUNDED,
        show_header=True,
        header_style="bold",
        title=f"[bold]model-bench results[/bold]  ({n_runs} runs · {_GOLDEN_COMMAND[:50]}…)",
        title_style="",
        caption=(f"Composite = calibration×0.40 + JSON validity×0.35 + speed×0.25   "
                 f"(reference mean {sum(_GOLDEN_REFERENCE.values())/len(_GOLDEN_REFERENCE):.1f})"),
        caption_style="dim",
    )
    tbl.add_column("Rank",      justify="right",  style="bold", no_wrap=True)
    tbl.add_column("Model",     justify="left",               no_wrap=True)
    tbl.add_column("p50",       justify="right",              no_wrap=True)
    tbl.add_column("±",         justify="right",  style="dim", no_wrap=True)
    tbl.add_column("OK",        justify="center",             no_wrap=True)
    tbl.add_column("JSON",      justify="center",             no_wrap=True)
    tbl.add_column("Score",     justify="right",              no_wrap=True)
    tbl.add_column("Cal",       justify="right",              no_wrap=True)
    tbl.add_column("Composite", justify="left",               no_wrap=True, min_width=10)

    ref_mean = sum(_GOLDEN_REFERENCE.values()) / len(_GOLDEN_REFERENCE)
    for rank, s in enumerate(ranked, 1):
        n          = len(s.runs)
        ok_frac    = f"{sum(1 for r in s.runs if r.success)}/{n}"
        json_frac  = f"{sum(1 for r in s.runs if r.json_valid)}/{n}"
        score_str  = f"{s.mean_score:.1f}" if s.json_rate > 0 else "—"
        cal_str    = f"{s.calibration:.2f}" if s.json_rate > 0 else "—"
        # Score is now shown for information only — how far a model sits from the
        # reference is what ranks it, so colour by distance rather than height.
        drift      = abs(s.mean_score - ref_mean)
        tbl.add_row(
            Text(str(rank), style="bold green" if rank == 1 else ("bold" if rank <= 3 else "")),
            s.model,
            f"{s.p50_latency:.1f} s",
            f"±{s.stddev_latency:.1f}",
            Text(ok_frac,   style="green" if s.success_rate == 1.0 else ("yellow" if s.success_rate > 0 else "red")),
            Text(json_frac, style="green" if s.json_rate    == 1.0 else ("yellow" if s.json_rate    > 0 else "red")),
            Text(score_str, style="green" if drift <= 0.5 else ("yellow" if drift <= 1.5 else "red")),
            Text(cal_str,   style="green" if s.calibration >= 0.90 else ("yellow" if s.calibration >= 0.80 else "red")),
            _bar(s.composite),
        )

    console.print(tbl)

    if verbose:
        console.print("\n[bold]Per-run detail:[/bold]")
        for s in ranked:
            console.print(f"\n  [cyan]{s.model}[/cyan]")
            for i, r in enumerate(s.runs, 1):
                status = ("[green]✓[/green]" if r.json_valid
                          else ("[yellow]~[/yellow]" if r.success else "[red]✗[/red]"))
                score_part = f"  score={r.mean_score:.1f}" if r.mean_score is not None else ""
                err_part   = f"  [{r.error}]" if r.error else ""
                console.print(f"    run {i}: {status}  {r.latency_s:.1f}s{score_part}{err_part}")


# ── Config update ──────────────────────────────────────────────────────────────

def _toml_str(data: dict) -> str:
    lines: list[str] = []
    for k, v in data.items():
        if v is None:
            continue
        if isinstance(v, bool):
            lines.append(f"{k} = {'true' if v else 'false'}")
        elif isinstance(v, (int, float)):
            lines.append(f"{k} = {v}")
        elif isinstance(v, str):
            escaped = v.replace("\\", "\\\\").replace('"', '\\"')
            lines.append(f'{k} = "{escaped}"')
    return "\n".join(lines) + "\n"


def _is_local(model: str) -> bool:
    saas = ("claude", "gpt", "o1", "o3", "o4", "gemini", "mistral-",
            "codestral-", "command", "sonar", "llama-api")
    return not any(model.lower().startswith(p) for p in saas)


def _update_config(ranked: list[ModelStats], top_n: int) -> None:
    local_winners = [s.model for s in ranked if _is_local(s.model)][:top_n]
    if not local_winners:
        console.print("[yellow]No local models in results — config not updated.[/yellow]")
        return

    cfg: dict = {}
    if CONFIG_FILE.exists():
        try:
            cfg = tomllib.loads(CONFIG_FILE.read_text())
        except Exception:
            pass

    old = cfg.get("local_judge_pool", "")
    cfg["local_judge_pool"] = ",".join(local_winners)
    BINNED_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text(_toml_str(cfg))

    console.print(
        f"\n[green]✓[/green] [bold]local_judge_pool[/bold] updated → {CONFIG_FILE}\n"
        f"  old: [dim]{old or '(empty)'}[/dim]\n"
        f"  new: [cyan]{cfg['local_judge_pool']}[/cyan]"
    )


# ── Model discovery ────────────────────────────────────────────────────────────

def _models_from_config() -> list[str]:
    if not CONFIG_FILE.exists():
        return []
    try:
        cfg = tomllib.loads(CONFIG_FILE.read_text())
    except Exception:
        return []
    seen: set[str] = set()
    models: list[str] = []
    for key in ("judge_models", "local_judge_pool", "saas_judge_fallbacks"):
        for m in (cfg.get(key, "") or "").split(","):
            m = m.strip()
            if m and m not in seen:
                seen.add(m)
                models.append(m)
    return models


def _installed_ollama_models() -> list[str]:
    if not shutil.which("ollama"):
        return []
    try:
        result = subprocess.run(["ollama", "list"], capture_output=True, text=True, timeout=10)
        return [line.split()[0] for line in result.stdout.splitlines()[1:] if line.strip()]
    except Exception:
        return []


# ── CLI ────────────────────────────────────────────────────────────────────────

app = typer.Typer(
    name="model-bench",
    help="Benchmark LLM models for use as binned judges.",
    add_completion=False,
    context_settings={"allow_extra_args": True, "ignore_unknown_options": True},
)


# Registered as a command, not a callback. A Typer app whose only entry point is
# a @callback is still a click Group, and a Group resolves its first positional
# as a subcommand name — so the documented `model-bench qwen3.5:9b-mlx` died with
# "No such command", and `--` did not help, even though ctx.args is read below.
# With exactly one command and no callback, Typer collapses the app to a flat
# CLI and the extra args land in ctx.args as intended.
@app.command(context_settings={"allow_extra_args": True, "ignore_unknown_options": True})
def main(
    ctx: typer.Context,
    runs: int = typer.Option(3, "--runs", "-n",
        help="Benchmark runs per model (warmup not counted)"),
    warmup: int = typer.Option(1, "--warmup", "-w",
        help="Warmup runs per model (discarded from stats)"),
    timeout: int = typer.Option(180, "--timeout", "-t",
        help="Per-run timeout in seconds"),
    update_config: bool = typer.Option(False, "--update-config",
        help="Write top-N local models to ~/.binned/config.toml as local_judge_pool"),
    top: int = typer.Option(8, "--top",
        help="How many models to write when --update-config"),
    export_json: Optional[pathlib.Path] = typer.Option(None, "--export-json",
        help="Export full results to a JSON file"),
    verbose: bool = typer.Option(False, "--verbose", "-v",
        help="Show per-run detail after the summary table"),
    sequential: bool = typer.Option(False, "--sequential",
        help="Run models one at a time for stricter latency isolation"),
    setup: bool = typer.Option(False, "--setup",
        help="Re-run the interactive setup guide and preflight checks"),
    version: bool = typer.Option(False, "--version", "-V", help="Show version and exit"),
):
    """Benchmark LLM models for use as binned judges.

    Pass model aliases as arguments, or omit them to benchmark all models
    found in ~/.binned/config.toml.

        model-bench                                # all configured models
        model-bench devstral-small-2 qwen3.5:9b   # specific models
        model-bench --update-config                # benchmark + save winners
        model-bench --setup                        # (re-)run the setup guide
    """
    if version:
        typer.echo(f"model-bench {VERSION}")
        raise typer.Exit(0)

    # First-run or explicit --setup: walk through the guide before anything else
    is_first_run = not SETUP_FILE.exists()
    if setup or is_first_run:
        ready = _run_setup()
        if setup:
            # --setup was the goal; don't proceed to benchmark unless models also given
            if not ctx.args:
                raise typer.Exit(0)
        if not ready and is_first_run:
            raise typer.Exit(1)

    # Quick preflight for normal runs (after setup is done)
    if not shutil.which("llm"):
        console.print(
            "[red]llm CLI not found.[/red] "
            "Run [bold]model-bench --setup[/bold] for installation help."
        )
        raise typer.Exit(1)

    # Resolve models: args > config > ollama
    models: list[str] = [m for m in ctx.args if m.strip()]
    if not models:
        models = _models_from_config()
    if not models:
        models = _installed_ollama_models()
    if not models:
        console.print(
            "[yellow]No models found.[/yellow]\n"
            "Pass model aliases as arguments, configure them with [cyan]binned config[/cyan],\n"
            "or run [cyan]model-bench --setup[/cyan] for guided setup."
        )
        raise typer.Exit(1)

    # Deduplicate preserving order
    seen: set[str] = set()
    models = [m for m in models if not (m in seen or seen.add(m))]  # type: ignore[func-returns-value]

    console.print(
        f"\n[bold]model-bench[/bold]  {len(models)} model(s) · "
        f"{runs} run(s) + {warmup} warmup · timeout {timeout}s"
    )
    console.print(f"[dim]Golden task: {_GOLDEN_COMMAND}[/dim]\n")

    all_stats: dict[str, ModelStats] = {}
    progress_cols = [
        SpinnerColumn(),
        TextColumn("{task.description}"),
        BarColumn(bar_width=20),
        TaskProgressColumn(),
        TimeElapsedColumn(),
    ]

    def _run_all(progress):
        if sequential:
            for model in models:
                tid = progress.add_task(f"  {model:<36s}", total=runs + warmup)
                all_stats[model] = _benchmark_model(model, runs, warmup, timeout, progress, tid)
        else:
            tids = {m: progress.add_task(f"  {m:<36s}", total=runs + warmup) for m in models}
            with ThreadPoolExecutor(max_workers=len(models)) as pool:
                futures = {
                    pool.submit(_benchmark_model, m, runs, warmup, timeout, progress, tids[m]): m
                    for m in models
                }
                for fut in as_completed(futures):
                    m = futures[fut]
                    try:
                        all_stats[m] = fut.result()
                    except Exception as exc:
                        console.print(f"[red]  {m}: failed — {exc}[/red]")

    with Progress(*progress_cols, console=console, transient=False) as progress:
        _run_all(progress)

    if not all_stats:
        console.print("[red]No results.[/red]")
        raise typer.Exit(1)

    ranked = sorted(all_stats.values(), key=lambda s: s.composite, reverse=True)
    _print_results(ranked, runs, verbose)

    if len(ranked) > 1:
        w, r = ranked[0], ranked[1]
        delta = w.p50_latency - r.p50_latency
        console.print(
            f"\n[bold green]Winner: {w.model}[/bold green]"
            f"  composite={w.composite:.3f} "
            f"({abs(delta):.1f}s {'slower' if delta > 0 else 'faster'} than {r.model})"
        )

    if export_json:
        data = [
            {
                "model": s.model,
                "p50_latency_s": s.p50_latency,
                "mean_latency_s": s.mean_latency,
                "stddev_latency": s.stddev_latency,
                "success_rate": s.success_rate,
                "json_rate": s.json_rate,
                "mean_score": s.mean_score,
                "score_stddev": s.score_stddev,
                "calibration": s.calibration,
                "verdict_match": s.verdict_match,
                "composite": s.composite,
                "reference": _GOLDEN_REFERENCE,
                "runs": [
                    # Per-criterion scores are exported too: the mean alone cannot
                    # show WHERE a judge diverged from the reference, which is the
                    # interesting part when comparing two similar composites.
                    {"latency_s": r.latency_s, "success": r.success,
                     "json_valid": r.json_valid, "mean_score": r.mean_score,
                     "scores": r.scores, "verdict": r.verdict, "error": r.error}
                    for r in s.runs
                ],
            }
            for s in ranked
        ]
        export_json.write_text(json.dumps(data, indent=2))
        console.print(f"[dim]Results exported → {export_json}[/dim]")

    if update_config:
        _update_config(ranked, top)


if __name__ == "__main__":
    app()
