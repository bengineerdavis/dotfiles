# Judge panel prompt — embedded here so binned can run judges without pytest
_JUDGE_SYSTEM = """\
You are a senior shell-script reviewer assessing a script generated by binned.
Score on FIVE criteria (each 0–10). Return ONLY valid JSON — no prose, no markdown:
