#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "typer",
#   "questionary",
# ]
# ///
# ---------------------------------------------------------------------------------------
# Script Name:        binned
# Description:        Turns a shell command into a tested, documented ~/bin script.
#                     Uses the `llm` CLI for generation. On first run, interactively
#                     sets up its own generation model and saves it to config.
#                     Deps declared via PEP 723; uv creates an isolated venv on first run.
#
# License:            MIT
# Author:             Ben Davis <ben.davis@sentry.io>
# Created:            2026-04-24
# Last Modified:      2026-04-24
#
# Usage:              binned [COMMAND] [OPTIONS]
#                     echo "cmd" | binned
#                     binned pending
#                     binned resume NAME
#                     binned config             Show / edit current config
#
# Dependencies:       uv (https://docs.astral.sh/uv/), llm (pip install llm)
# Optional:           fzf, bat/batcat, bats (test runner)
#
# Notes:
#   - uv auto-installs typer into an isolated per-script venv on first run
#   - binned's own generation model is configured at ~/.binned/config.json
#   - Run `binned config` to update settings interactively
#   - Deferred scripts live at ~/.binned/pending/
#   - Reminders via `at` (if available) or ~/.binned/reminders.txt fallback
# ---------------------------------------------------------------------------------------

from __future__ import annotations

import json
import os
import re
import tomllib
import shutil
import subprocess
import sys
import tempfile
import threading
import time
from datetime import datetime
from pathlib import Path
from typing import Optional

import typer       # provided by PEP 723 / uv  # type: ignore[import-untyped]
import questionary  # provided by PEP 723 / uv  # type: ignore[import-untyped]

# ──────────────────────────────────────────────────────────────────────────────
# Constants
# ──────────────────────────────────────────────────────────────────────────────

VERSION = "0.1.0"
DEFAULT_BIN_DIR = Path.home() / "bin"
# BINNED_HOME lets tests (and --reset flows) redirect all state to a temp dir
BINNED_DIR         = Path(os.environ.get("BINNED_HOME", str(Path.home() / ".binned")))
PENDING_DIR        = BINNED_DIR / "pending"
CONFIG_FILE        = BINNED_DIR / "config.toml"
CONFIG_FILE_LEGACY = BINNED_DIR / "config.json"   # migrated on first read, then deleted
STATE_FILE         = BINNED_DIR / "state.json"     # runtime disqualifications, separate from user config

_LLM_CMD_RE = re.compile(r"\bllm\b", re.IGNORECASE)
_LLM_MODEL_FLAG_RE = re.compile(r"(?:-m|--model)\s+(\S+)")

# ──────────────────────────────────────────────────────────────────────────────
# ANSI Colors — auto-disabled when not a tty
# ──────────────────────────────────────────────────────────────────────────────

_COLOR = sys.stdout.isatty()
_AUTO: bool = False  # set True by --auto/-y; all prompt_* functions return their default

# Session-level judge failure tracking — reset on each binned invocation
_SESSION_FAILURE_COUNTS: dict[str, int] = {}   # alias → number of fallback failures this session
_SESSION_SKIP: set[str] = set()                # aliases excluded for the remainder of this session


def _c(code: str) -> str:
    return f"\033[{code}m" if _COLOR else ""


RST = _c("0")
BOLD = _c("1")
DIM = _c("2")
RED = _c("31")
GRN = _c("32")
YLW = _c("33")
BLU = _c("34")
CYN = _c("36")


def err(msg: str):
    typer.echo(f"{RED}✗{RST} {msg}", err=True)


def ok(msg: str):
    typer.echo(f"{GRN}✓{RST} {msg}")


def info(msg: str):
    typer.echo(f"{BLU}→{RST} {msg}")


def warn(msg: str):
    typer.echo(f"{YLW}⚠{RST}  {msg}")


def header(msg: str):
    width = min(shutil.get_terminal_size((72, 24)).columns, 72)
    bar = "─" * width
    typer.echo(f"\n{BOLD}{CYN}{bar}{RST}")
    typer.echo(f"{BOLD}{CYN}  {msg}{RST}")
    typer.echo(f"{BOLD}{CYN}{bar}{RST}\n")


# ──────────────────────────────────────────────────────────────────────────────
# Spinner
# ──────────────────────────────────────────────────────────────────────────────

class Spinner:
    _FRAMES = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"

    def __init__(self, msg: str):
        self.msg = msg
        self._stop = threading.Event()
        self._thread: threading.Thread | None = None

    def _spin(self):
        i = 0
        while not self._stop.is_set():
            frame = self._FRAMES[i % len(self._FRAMES)]
            print(f"\r{CYN}{frame}{RST} {self.msg}", end="", flush=True)
            i += 1
            time.sleep(0.08)
        print(f"\r{' ' * (len(self.msg) + 4)}\r", end="", flush=True)

    def __enter__(self):
        if _COLOR:
            self._thread = threading.Thread(target=self._spin, daemon=True)
            self._thread.start()
        else:
            typer.echo(f"→ {self.msg}…")
        return self

    def __exit__(self, *_):
        self._stop.set()
        if self._thread:
            self._thread.join()


# ──────────────────────────────────────────────────────────────────────────────
# Config
# ──────────────────────────────────────────────────────────────────────────────

_CONFIG_DEFAULTS: dict = {
    "generation_model":      None,   # None → use llm's own default
    "bin_dir":               str(DEFAULT_BIN_DIR),
    "defer_minutes":         60,
    "auto_tests":            True,
    "judge_timeout_seconds": 180,    # per-judge timeout; larger for slow local models
    "judge_recheck_hours":   24,     # hours before re-testing a disqualified SaaS model
    # run_judges, judge_models, local_judge_pool, saas_judge_fallbacks are
    # intentionally absent — their absence signals "first-run judge setup not done yet"
}

_CONFIG_DESCRIPTIONS: dict[str, str] = {
    "generation_model":       "LLM model/alias binned uses for its OWN generation",
    "bin_dir":                "Directory where scripts are saved",
    "defer_minutes":          "Default reminder delay (minutes) when deferring",
    "auto_tests":             "Automatically generate bats tests (true/false)",
    "judge_timeout_seconds":  "Per-judge timeout in seconds (increase for large local models)",
    "judge_recheck_hours":    "Hours before retesting a disqualified SaaS model (default 24)",
    "run_judges":             "Run a judge panel to score generated scripts (true/false)",
    "judge_models":           "Comma-separated aliases for the primary judge panel",
    "local_judge_pool":       "Ordered local model pool (up to 8); round-robins when a judge fails",
    "saas_judge_fallbacks":   "Ordered SaaS fallback models when a judge fails (comma-separated, up to 3)",
}


def _toml_str(data: dict) -> str:
    """
    Minimal TOML serializer for flat scalar dicts — avoids adding a write
    dependency (tomllib is read-only, stdlib in Python 3.11+).
    Handles: str, bool, int, float, None (skipped).
    """
    lines: list[str] = []
    for k, v in data.items():
        if v is None:
            continue
        if isinstance(v, bool):
            lines.append(f"{k} = {'true' if v else 'false'}")
        elif isinstance(v, int):
            lines.append(f"{k} = {v}")
        elif isinstance(v, float):
            lines.append(f"{k} = {v}")
        elif isinstance(v, str):
            escaped = v.replace("\\", "\\\\").replace('"', '\\"')
            lines.append(f'{k} = "{escaped}"')
        else:
            escaped = str(v).replace("\\", "\\\\").replace('"', '\\"')
            lines.append(f'{k} = "{escaped}"')
    return "\n".join(lines) + "\n"


def load_config() -> dict:
    # Migrate legacy JSON config → TOML on first read, then remove it
    if not CONFIG_FILE.exists() and CONFIG_FILE_LEGACY.exists():
        try:
            legacy_data = json.loads(CONFIG_FILE_LEGACY.read_text())
            BINNED_DIR.mkdir(parents=True, exist_ok=True)
            CONFIG_FILE.write_text(_toml_str(legacy_data))
            CONFIG_FILE_LEGACY.unlink()
        except Exception:
            pass  # migration failure is non-fatal; TOML file just won't exist yet

    if CONFIG_FILE.exists():
        try:
            data = tomllib.loads(CONFIG_FILE.read_text())
            return {**_CONFIG_DEFAULTS, **data}
        except (tomllib.TOMLDecodeError, OSError):
            return dict(_CONFIG_DEFAULTS)
    return dict(_CONFIG_DEFAULTS)


def save_config(cfg: dict) -> None:
    BINNED_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text(_toml_str(cfg))


def ensure_config() -> dict:
    """
    On first run (no config file) walk the user through initial setup so
    binned's own generation model is always explicit, not a surprise.
    """
    if CONFIG_FILE.exists():
        return load_config()

    header("Welcome to binned — first-run setup")
    typer.echo(
        "binned uses the `llm` CLI to generate scripts. Let's configure\n"
        "which model IT should use for that work (separate from any model\n"
        "that ends up inside the scripts it builds).\n"
    )

    cfg = dict(_CONFIG_DEFAULTS)

    # Generation model — show recommendations then use the interactive menu
    installed = get_installed_model_ids()
    show_model_recommendations(installed)
    typer.echo("Choose a model from your aliases, or enter one manually below.\n")
    selected = select_model_interactively("binned's generation model")
    gen_model = selected or prompt_text(
        "Or type a model/alias directly (Enter to use llm default)",
        default="",
    )
    if gen_model:
        with Spinner(f"Validating '{gen_model}'"):
            ok_ = validate_llm_model(gen_model)
        if ok_:
            ok(f"'{gen_model}' is working.")
            cfg["generation_model"] = gen_model
        else:
            warn(f"'{gen_model}' did not respond — saving anyway. Fix later: binned config")
            cfg["generation_model"] = gen_model
    else:
        info("Using llm's default model.")

    # bin_dir
    raw_bin = prompt_text("Where to save scripts", default=str(DEFAULT_BIN_DIR))
    cfg["bin_dir"] = raw_bin or str(DEFAULT_BIN_DIR)

    # defer_minutes
    raw_mins = prompt_text("Default defer reminder (minutes)", default="60")
    try:
        cfg["defer_minutes"] = int(raw_mins)
    except ValueError:
        cfg["defer_minutes"] = 60

    save_config(cfg)
    ok(f"Config saved → {CONFIG_FILE}")
    typer.echo(f"  Update anytime with: {BOLD}binned config{RST}\n")
    return cfg


# ──────────────────────────────────────────────────────────────────────────────
# Interactive UI helpers
# ──────────────────────────────────────────────────────────────────────────────

def prompt_text(msg: str, default: str = "") -> str:
    if _AUTO:
        return default
    hint = f" [{DIM}{default}{RST}]" if default else ""
    try:
        val = input(f"{BOLD}{msg}{RST}{hint}: ").strip()
        return val if val else default
    except (EOFError, KeyboardInterrupt):
        typer.echo("")
        raise typer.Exit(0)


def prompt_confirm(msg: str, default: bool = True) -> bool:
    if _AUTO:
        return default
    hint = f"{GRN}Y{RST}/n" if default else f"y/{RED}N{RST}"
    try:
        val = input(f"{BOLD}{msg}{RST} [{hint}]: ").strip().lower()
        if not val:
            return default
        return val in ("y", "yes")
    except (EOFError, KeyboardInterrupt):
        typer.echo("")
        raise typer.Exit(0)


def prompt_choice(msg: str, options: list[str], default: int = 0) -> int:
    """Arrow-key menu via questionary; falls back to numbered list if not a tty."""
    if _AUTO:
        return default
    if not _COLOR:
        # Non-interactive fallback (pipe/CI)
        typer.echo(f"\n{BOLD}{msg}{RST}")
        for i, opt in enumerate(options):
            typer.echo(f"  {DIM}{i + 1}.{RST} {opt}")
        try:
            val = input(f"\nChoice [1–{len(options)}, default={default + 1}]: ").strip()
            if not val:
                return default
            idx = int(val) - 1
            return idx if 0 <= idx < len(options) else default
        except (ValueError, EOFError, KeyboardInterrupt):
            return default

    choices = [
        questionary.Choice(title=opt, value=i) for i, opt in enumerate(options)
    ]
    result = questionary.select(
        msg,
        choices=choices,
        default=choices[default],
        style=questionary.Style([
            ("selected",        "fg:#00ff87 bold"),
            ("pointer",         "fg:#00ff87 bold"),
            ("highlighted",     "fg:#00ff87 bold"),
            ("question",        "bold"),
            ("answer",          "fg:#00ff87 bold"),
        ]),
    ).ask()
    return result if result is not None else default


# ──────────────────────────────────────────────────────────────────────────────
# LLM CLI integration
# ──────────────────────────────────────────────────────────────────────────────

def require_llm():
    if not shutil.which("llm"):
        err("'llm' CLI not found.  Install: pip install llm")
        raise typer.Exit(1)


def _model_label(model: str | None) -> str:
    """Human-readable label for transparency messages."""
    if model:
        return f"{BOLD}{model}{RST}"
    return f"{DIM}llm default{RST}"


def llm_call(
    prompt: str,
    system: str | None = None,
    model: str | None = None,
    stream: bool = False,
    label: str = "",
) -> str:
    """
    Invoke `llm` via stdin.  Prints a transparency line so the user always
    knows which model binned is using for its own work.
    """
    if label:
        info(f"[binned model: {_model_label(model)}] {label}")

    cmd = ["llm"]
    if model:
        cmd += ["-m", model]
    if system:
        cmd += ["-s", system]

    if stream and _COLOR:
        proc = subprocess.Popen(
            cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, text=True,
        )
        assert proc.stdin
        proc.stdin.write(prompt)
        proc.stdin.close()
        chunks: list[str] = []
        assert proc.stdout
        for chunk in proc.stdout:
            print(chunk, end="", flush=True)
            chunks.append(chunk)
        proc.wait()
        if proc.returncode != 0:
            assert proc.stderr
            raise RuntimeError(proc.stderr.read().strip())
        print()
        return "".join(chunks)
    else:
        result = subprocess.run(cmd, input=prompt, capture_output=True, text=True)
        if result.returncode != 0:
            raise RuntimeError(result.stderr.strip())
        return result.stdout


def get_last_llm_conversation_id() -> str | None:
    """Return the conversation_id from the most recent llm log entry."""
    try:
        result = subprocess.run(
            ["llm", "logs", "-n", "1", "--json"],
            capture_output=True, text=True, timeout=10,
        )
        if result.returncode != 0 or not result.stdout.strip():
            return None
        data = json.loads(result.stdout.strip())
        if isinstance(data, list) and data:
            return data[0].get("conversation_id")
        if isinstance(data, dict):
            return data.get("conversation_id")
        return None
    except Exception:
        return None


def llm_continue_call(
    prompt: str,
    conv_id: str | None = None,
    model: str | None = None,
    stream: bool = False,
    label: str = "",
) -> str:
    """
    Continue an existing llm conversation (-C CONV_ID) or the most recent one
    (--continue).  This lets judge feedback land in the same context window as
    the original generation so the model improves from its own prior output.
    """
    if label:
        info(f"[binned model: {_model_label(model)}] {label}")

    cmd = ["llm"]
    if model:
        cmd += ["-m", model]
    if conv_id:
        cmd += ["-C", conv_id]
    else:
        cmd += ["--continue"]

    if stream and _COLOR:
        proc = subprocess.Popen(
            cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, text=True,
        )
        assert proc.stdin
        proc.stdin.write(prompt)
        proc.stdin.close()
        chunks: list[str] = []
        assert proc.stdout
        for chunk in proc.stdout:
            print(chunk, end="", flush=True)
            chunks.append(chunk)
        proc.wait()
        if proc.returncode != 0:
            assert proc.stderr
            raise RuntimeError(proc.stderr.read().strip())
        print()
        return "".join(chunks)
    else:
        result = subprocess.run(cmd, input=prompt, capture_output=True, text=True)
        if result.returncode != 0:
            raise RuntimeError(result.stderr.strip())
        return result.stdout


def get_llm_aliases() -> dict[str, str]:
    try:
        out = subprocess.run(["llm", "aliases"], capture_output=True, text=True, timeout=10)
        aliases: dict[str, str] = {}
        for line in out.stdout.splitlines():
            # llm aliases pads the alias column then uses " : " as separator.
            # Split on the first run of 2+ whitespace chars followed by ": " so
            # that alias names containing colons (e.g. qwen3.5:35b) are preserved.
            m = re.match(r"^(.+?)\s{2,}:\s+(.+)$", line)
            if m:
                aliases[m.group(1).strip()] = m.group(2).strip()
        return aliases
    except Exception:
        return {}


def get_installed_model_ids() -> set[str]:
    """
    Parse `llm models list` and return every model ID and alias that is installed.
    Used to annotate recommendations as available or not.
    """
    try:
        out = subprocess.run(["llm", "models", "list"], capture_output=True, text=True, timeout=10)
        found: set[str] = set()
        for line in out.stdout.splitlines():
            # "Provider: model-id (aliases: a, b, c)"
            m = re.match(r"^[^:]+:\s+(\S+)(?:\s+\(aliases:\s+([^)]+)\))?", line.strip())
            if m:
                found.add(m.group(1))
                if m.group(2):
                    for alias in m.group(2).split(","):
                        found.add(alias.strip())
        return found
    except Exception:
        return set()


# ──────────────────────────────────────────────────────────────────────────────
# System resource detection
# ──────────────────────────────────────────────────────────────────────────────

def _detect_total_ram_gb() -> float | None:
    """Total system RAM (GB). On Apple Silicon this is unified memory."""
    try:
        if sys.platform == "darwin":
            r = subprocess.run(
                ["sysctl", "-n", "hw.memsize"], capture_output=True, text=True, timeout=5
            )
            return int(r.stdout.strip()) / (1024 ** 3)
        elif sys.platform.startswith("linux"):
            with open("/proc/meminfo") as f:
                for line in f:
                    if line.startswith("MemTotal:"):
                        return int(line.split()[1]) / (1024 ** 2)
    except Exception:
        pass
    return None


def _detect_available_ram_gb() -> float | None:
    """
    Currently available RAM (GB) — memory the OS can give to a new process
    without evicting active mappings.  On macOS this is free + inactive pages;
    on Linux it is MemAvailable from /proc/meminfo.
    """
    try:
        if sys.platform == "darwin":
            vm = subprocess.run(
                ["vm_stat"], capture_output=True, text=True, timeout=5
            )
            page_size = 4096  # 4KiB pages on all macOS hardware
            avail_pages = 0
            for line in vm.stdout.splitlines():
                for key in ("Pages free", "Pages inactive", "Pages speculative"):
                    if line.startswith(key + ":"):
                        val = re.sub(r"[^\d]", "", line.split(":")[1])
                        if val:
                            avail_pages += int(val)
                        break
            return (avail_pages * page_size) / (1024 ** 3)
        elif sys.platform.startswith("linux"):
            with open("/proc/meminfo") as f:
                for line in f:
                    if line.startswith("MemAvailable:"):
                        return int(line.split()[1]) / (1024 ** 2)
    except Exception:
        pass
    return None


def _model_fits_in_ram(ram_needed_gb: float | None, available_gb: float, total_gb: float) -> bool:
    """
    True if this machine can physically run the model without hard OOM.

    Greedy bias: check against TOTAL RAM minus a fixed 4 GB OS reserve, not
    against currently-free pages.  macOS/Linux will reclaim inactive pages as
    needed; blocking on free-pages would reject models that run fine in practice.
    Only skip a model that genuinely cannot fit on this hardware.
    """
    if ram_needed_gb is None:
        return True  # SaaS — no local memory consumed
    return ram_needed_gb <= (total_gb - 4.0)


def _model_ram_pressure(ram_needed_gb: float | None, available_gb: float) -> bool:
    """True when the model needs more than what's currently free — expect paging."""
    if ram_needed_gb is None or available_gb is None:
        return False
    return ram_needed_gb > available_gb


def _filter_models_by_ram(
    models: list[str],
    ram_lookup: dict[str, float | None],
) -> tuple[list[str], dict[str, str]]:
    """
    Return (feasible_models, {skipped_model: reason}).
    SaaS models always pass through.  Local models are skipped only when
    ram_needed > total - 4 GB (would hard-OOM the machine).
    """
    available = _detect_available_ram_gb()
    total     = _detect_total_ram_gb()

    if total is None:
        # Can't detect RAM — pass everything through (greedy default)
        return models, {}

    feasible: list[str] = []
    skipped: dict[str, str] = {}

    for m in models:
        if _judge_model_category(m) == "saas":
            feasible.append(m)
            continue
        ram_needed = ram_lookup.get(m)
        if ram_needed is None:
            feasible.append(m)  # unknown model — greedy: assume it fits
            continue
        if _model_fits_in_ram(ram_needed, available or 0.0, total):
            feasible.append(m)
            if available and _model_ram_pressure(ram_needed, available):
                warn(
                    f"Judge {m!r} needs ~{ram_needed:.0f} GB; "
                    f"only {available:.1f} GB currently free — memory pressure expected."
                )
        else:
            skipped[m] = (
                f"needs ~{ram_needed:.0f} GB but machine only has {total:.0f} GB total "
                f"(would hard-OOM)"
            )

    return feasible, skipped


# Curated list: (model_id, stars_1_to_3, category, note, ram_gb)
# Stars reflect code/script generation quality, not general capability.
# ram_gb: RAM (or unified memory on Apple Silicon) needed to run without swapping,
#         at Q4_K_M quantization.  None = SaaS (no local RAM consumed).
# Rule of thumb used: (params_B * 0.56) + 1.5 GB KV-cache overhead, rounded up.
_RECOMMENDED_MODELS: list[tuple[str, int, str, str, float | None]] = [
    # ── SaaS ─────────────────────────────────────────────────────────────────
    # Graded on zero-shot performance for binned's three hardest tasks:
    # (1) skeleton template fill-in with strict bash-only output,
    # (2) bats test generation with setup/stubs in one shot,
    # (3) structured key:value format compliance (_SYS_ASSESS).

    ("claude-opus-4.7",      3, "saas", "Top reasoning; best zero-shot template compliance",       None),
    ("claude-sonnet-4.6",    3, "saas", "Built & tested with this model; highest prompt alignment", None),
    ("gemini-2.5-pro",       3, "saas", "Large context; strong structured output compliance",       None),
    ("gpt-4.1",              3, "saas", "Precise; handles strict format constraints reliably",      None),
    ("gpt-4o",               3, "saas", "Reliable all-rounder; well-tested for bash gen",           None),
    ("gemini-2.5-flash",     2, "saas", "Fast; good for moderately complex commands",               None),
    ("claude-haiku-4.5",     2, "saas", "Cheapest Anthropic; most scripts work first-try",          None),
    ("gpt-4.1-mini",         2, "saas", "Affordable; skips boilerplate on complex commands",        None),
    ("gpt-4.1-nano",         1, "saas", "Trivial scripts only; poor structured-format compliance",  None),

    # ── Local (Ollama + llm-ollama plugin) ────────────────────────────────────
    # ram_gb = RAM needed at Q4_K_M quant.  On Apple Silicon this is unified memory;
    # on Linux with a GPU it is VRAM.  Used to skip models that would cause swapping.

    # devstral-small-2:24b — (24 * 0.56) + 1.5 ≈ 15GB
    ("devstral-small-2",     3, "local", "Code-agent fine-tune; best local zero-shot for scripts",  15.0),

    # qwen3.5:35b — (35 * 0.56) + 1.5 ≈ 21GB
    ("qwen3.5:35b",          3, "local", "Largest Qwen3.5; strong format compliance",               21.0),

    # qwen3.5:27b — (27 * 0.56) + 1.5 ≈ 17GB
    ("qwen3.5:27b",          3, "local", "High quality; reliable skeleton fill-in",                 17.0),

    # deepseek-r1:32b — (32 * 0.56) + 1.5 ≈ 20GB (thinking tokens add KV overhead)
    ("deepseek-r1:32b",      2, "local", "Strong reasoning; thinking tokens may leak into output",  20.0),

    # qwen3.5:9b — (9 * 0.56) + 1.5 ≈ 7GB
    ("qwen3.5:9b",           2, "local", "Good quality/size balance",                               7.0),

    # mistral-small3.1:24b — same param count as devstral ≈ 15GB
    ("mistral-small3.1:24b", 2, "local", "Solid structured output; good general bash knowledge",    15.0),

    # gemma4:31b — (31 * 0.56) + 1.5 ≈ 19GB
    ("gemma4:31b",           2, "local", "Strong instruction following; clean output format",        19.0),

    # phi4:14b — (14 * 0.56) + 1.5 ≈ 10GB
    ("phi4:14b",             2, "local", "Punches above its weight; good for most scripts",          10.0),

    # gemma4:e4b — (4 * 0.56) + 1.5 ≈ 4GB
    ("gemma4:e4b",           1, "local", "Edge efficiency variant; single-step scripts only",        4.0),
]

_STARS = {3: f"{YLW}★★★{RST}", 2: f"{YLW}★★{RST}{DIM}☆{RST}", 1: f"{DIM}★☆☆{RST}"}

# Grading is based on zero-shot performance for the three tasks binned runs:
#   (1) skeleton fill-in: follow a bash template, output the script only
#   (2) bats tests: write setup/teardown/stubs correctly in one shot
#   (3) format compliance: output strict key:value text for language assess
_STAR_LEGEND = (
    f"  {_STARS[3]}  Zero-shot: correct structure + error handling on first try;\n"
    f"        infers edge-cases; never leaks prose into script output\n"
    f"  {_STARS[2]}  Zero-shot: works for most commands; may need one feedback\n"
    f"        round on complex pipelines or occasionally skip boilerplate\n"
    f"  {_STARS[1]}  Simple single-step scripts only; unreliable on structured\n"
    f"        output format and bats generation"
)


def show_model_recommendations(installed: set[str]) -> None:
    """Print a recommendations panel above the model picker."""
    width = min(shutil.get_terminal_size((80, 24)).columns, 80)
    bar = "─" * width

    typer.echo(f"\n{DIM}{bar}{RST}")
    typer.echo(f"{BOLD}  Recommended models for script generation{RST}")
    typer.echo(f"{DIM}{bar}{RST}")
    typer.echo(f"\n{BOLD}  Rating key{RST}  (scores reflect bash script generation quality)")
    typer.echo(_STAR_LEGEND)

    for category, label in [("saas", "SaaS  (API key required)"),
                             ("local", "Local  (Ollama + llm-ollama plugin)")]:
        typer.echo(f"\n  {BOLD}{label}{RST}")
        available_gb = _detect_available_ram_gb()
        total_gb     = _detect_total_ram_gb()
        for mid, stars, cat, note, ram_gb in _RECOMMENDED_MODELS:
            if cat != category:
                continue
            is_installed = any(mid in i or i in mid for i in installed)
            status = f"{GRN}✓ installed{RST}" if is_installed else f"{DIM}not found{RST}"
            star_str = _STARS[stars]

            # RAM annotation: fits = can run without hard-OOM; pressure = expects paging
            ram_note = ""
            if cat == "local" and ram_gb is not None:
                if total_gb is not None:
                    fits = _model_fits_in_ram(ram_gb, available_gb or 0.0, total_gb)
                    pressure = available_gb is not None and _model_ram_pressure(ram_gb, available_gb)
                    if fits and pressure:
                        ram_note = f"  {YLW}~{ram_gb:.0f}GB (pressure){RST}"
                    elif fits:
                        ram_note = f"  {GRN}~{ram_gb:.0f}GB fits{RST}"
                    else:
                        ram_note = f"  {RED}~{ram_gb:.0f}GB — too large{RST}"
                else:
                    ram_note = f"  {DIM}~{ram_gb:.0f}GB{RST}"

            typer.echo(
                f"  {star_str}  {BOLD}{mid:<30}{RST}  {status:<22}{ram_note:<20}  {DIM}{note}{RST}"
            )

    typer.echo(f"\n{DIM}{bar}{RST}\n")


def validate_llm_model(model: str, timeout: int = 30) -> bool:
    try:
        result = subprocess.run(
            ["llm", "-m", model],
            input="Respond with exactly the single word: ok",
            capture_output=True, text=True, timeout=timeout,
        )
        return result.returncode == 0 and bool(result.stdout.strip())
    except Exception:
        return False


def add_llm_alias(alias: str, model: str) -> bool:
    try:
        r = subprocess.run(
            ["llm", "aliases", "set", alias, model],
            capture_output=True, text=True, timeout=10,
        )
        return r.returncode == 0
    except Exception:
        return False


_MENU_STYLE = questionary.Style([
    ("selected",    "fg:#00ff87 bold"),
    ("pointer",     "fg:#00ff87 bold"),
    ("highlighted", "fg:#00ff87 bold"),
    ("question",    "bold"),
    ("answer",      "fg:#00ff87 bold"),
    ("separator",   "fg:#6c6c6c"),
])

_ADD_NEW  = "__add_new__"
_SKIP_SEL = "__skip__"


def _prompt_add_alias(installed: set[str]) -> str | None:
    """Register a new llm alias, picking the model ID from a questionary menu."""
    typer.echo("")
    alias = prompt_text("New alias name (e.g. 'fast', 'local')")
    if not alias:
        return None

    # Build model choices: recommended first, then everything else installed
    rec_ids = [mid for mid, *_ in _RECOMMENDED_MODELS]
    rec_installed = [mid for mid in rec_ids if any(mid in i or i in mid for i in installed)]
    other_installed = sorted(installed - set(rec_installed))

    choices: list[questionary.Choice | questionary.Separator] = []
    if rec_installed:
        choices.append(questionary.Separator("── Recommended (installed) ──"))
        for mid in rec_installed:
            note = next((n for m, _, _, n in _RECOMMENDED_MODELS if m == mid), "")
            choices.append(questionary.Choice(
                title=f"{mid}  {DIM}{note}{RST}", value=mid,
            ))
    if other_installed:
        choices.append(questionary.Separator("── Other installed ──"))
        for mid in other_installed:
            choices.append(questionary.Choice(title=mid, value=mid))
    choices.append(questionary.Separator("──"))
    choices.append(questionary.Choice(title="Enter model ID manually…", value="__manual__"))

    if _COLOR and choices:
        result = questionary.select(
            "Select model ID for this alias:", choices=choices, style=_MENU_STYLE,
        ).ask()
    else:
        result = "__manual__"

    if result == "__manual__" or result is None:
        model = prompt_text("Model ID (e.g. gpt-4o, qwen2.5-coder:7b)")
    else:
        model = result

    if not model:
        return None

    with Spinner(f"Validating '{model}'"):
        works = validate_llm_model(model)

    if works:
        ok(f"'{model}' is working.")
    else:
        warn(f"'{model}' didn't respond within timeout.")
        if not prompt_confirm("Save alias anyway?", default=False):
            return None

    if add_llm_alias(alias, model):
        ok(f"Alias '{alias}' → '{model}' saved.")
    else:
        warn(f"Couldn't save automatically. Run: llm aliases set {alias} {model}")
    return alias


def select_model_interactively(heading: str = "Select model alias") -> str | None:
    """
    Arrow-key alias selector (questionary) prefixed by a recommendations panel.
    Falls back to a numbered list when not running in an interactive tty.
    """
    aliases  = get_llm_aliases()
    installed = get_installed_model_ids()

    # Show recommendations panel before the menu
    show_model_recommendations(installed)

    alias_keys = list(aliases.keys())

    if _COLOR:
        # Build questionary choices: aliases grouped by whether they're recommended
        rec_ids = {mid for mid, *_ in _RECOMMENDED_MODELS}
        rec_aliases   = [(k, aliases[k]) for k in alias_keys
                         if any(aliases[k] in r or r in aliases[k] for r in rec_ids)]
        other_aliases = [(k, aliases[k]) for k in alias_keys
                         if (k, aliases[k]) not in rec_aliases]

        choices: list[questionary.Choice | questionary.Separator] = []
        if rec_aliases:
            choices.append(questionary.Separator("── Your aliases (recommended models) ──"))
            for k, v in rec_aliases:
                choices.append(questionary.Choice(title=f"{k}  →  {v}", value=k))
        if other_aliases:
            choices.append(questionary.Separator("── Your other aliases ──"))
            for k, v in other_aliases:
                choices.append(questionary.Choice(title=f"{k}  →  {v}", value=k))

        choices.append(questionary.Separator("──"))
        choices.append(questionary.Choice(title="Add new alias…",   value=_ADD_NEW))
        choices.append(questionary.Choice(title="Skip (keep as-is)", value=_SKIP_SEL))

        selected = questionary.select(
            heading, choices=choices, style=_MENU_STYLE,
        ).ask()
    else:
        # Non-tty numbered fallback
        all_items = alias_keys + [_ADD_NEW, _SKIP_SEL]
        labels = (
            [f"{k}  →  {aliases[k]}" for k in alias_keys]
            + ["Add new alias…", "Skip (keep as-is)"]
        )
        typer.echo(f"\n{BOLD}{heading}{RST}")
        for i, label in enumerate(labels, 1):
            typer.echo(f"  {DIM}{i:3}.{RST} {label}")
        try:
            raw = input(f"\nChoice [1–{len(all_items)}] or Enter to cancel: ").strip()
            idx = int(raw) - 1
            selected = all_items[idx] if 0 <= idx < len(all_items) else _SKIP_SEL
        except (ValueError, EOFError, KeyboardInterrupt):
            selected = _SKIP_SEL

    if selected is None or selected == _SKIP_SEL:
        return None
    if selected == _ADD_NEW:
        return _prompt_add_alias(installed)

    with Spinner(f"Validating '{selected}'"):
        works = validate_llm_model(selected)
    if works:
        ok(f"'{selected}' is working.")
    else:
        warn(f"'{selected}' didn't respond — it may fail at runtime.")
    return selected


def detect_llm_in_command(cmd: str) -> str | None:
    if not _LLM_CMD_RE.search(cmd):
        return None
    m = _LLM_MODEL_FLAG_RE.search(cmd)
    return m.group(1) if m else "default"


