#!/usr/bin/env bash

# set -euo pipefail

# debugging
# set -x

# .functions
# This file contains custom functions for my shell environment.
# It is sourced by my .bashrc or .zshrc file.
# This file is not intended to be run directly.
# my personal functions

# export custom local functions
export PATH="$HOME/bin:$PATH"

# move into a new directory and list its contents
lcd () {
    cd "$1" && ls --color="always" $1
}

# create a new directory and cd into it
mcd () {
    mkdir -vp "${1}" && \
    cd "${1}" && \
    ls --color="always" .
}

# Function that helps the user call all their most important dotfiles
# a given user may want to view and/or edit by their editor of choice
edit_dotfiles () {
    # define each dotfile subcollection
    local CUSTOM_FUNC_PATHS
    local APP_DOT_FILES
    local TERM_DOT_FILES

    CUSTOM_FUNC_PATHS=(
        ~/.functions
        ~/.local/bin
    )

    TERM_DOT_FILES=(
        ~/.config/ghostty/config
    )

    APP_DOT_FILES=(
        ~/.config/mise/config.toml
    )

    # Collect shared dotfile subcollections for each shell env
    local SHARED_DOT_FILES
    SHARED_DOT_FILES=(
        "${CUSTOM_FUNC_PATHS[@]}"
        "${TERM_DOT_FILES[@]}"
        "${APP_DOT_FILES[@]}"
    )


    # define each shell env dotfile collection
    local BASH_DOT_FILES
    BASH_DOT_FILES=(
        ~/.bash_aliases
        ~/.bashrc
    )

    local ZSH_DOT_FILES
    ZSH_DOT_FILES=(
        ~/.zshrc
        ~/.zprofile
    )

    # Assemble dotfile collections
    local DOT_PATHS
    DOT_PATHS=(
        "${SHARED_DOT_FILES[@]}"
    )

    if [[ -n "${ZSH_VERSION}" ]]; then
        DOT_PATHS+=("${ZSH_DOT_FILES[@]}")
    else
        DOT_PATHS+=("${BASH_DOT_FILES[@]}")
    fi

    # Main function
    main () {
        code --wait --new-window "${DOT_PATHS[@]}" && zshup
    }

    main
}

# Refuse to run a tool that owns a user-scoped tree under root. Root gets a
# second install tree under /root and stale locks in the temp dir; the Debian
# package steps elevate per task instead. Everything else passes through to the
# real sudo, and `command sudo ...` still bypasses this on purpose.
sudo() {
    local word="" expect_arg=0 arg
    for arg in "$@"; do
        if [ "${expect_arg}" -eq 1 ]; then
            expect_arg=0
            continue
        fi
        case "${arg}" in
            --) ;;
            -u|-g|-p|-C|-h|-r|-t|-T|-U|-D|-R) expect_arg=1 ;;
            -*) ;;
            *) word="${arg}"; break ;;
        esac
    done
    case "${word##*/}" in
        mise|ansible|ansible-playbook|ansible-galaxy|ansible-doc|ansible-vault)
            printf "sudo: refusing to run '%s' as root.\n" "${word}" >&2
            printf "      It installs under \$HOME; run it as your user.\n" >&2
            return 1
            ;;
    esac
    command sudo "$@"
}
