{
  // Deployed by chezmoi from dot_config/opencode/opencode.jsonc.
  // Machine-local state (auth.json, opencode.db) lives beside it and is
  // deliberately not managed. When both opencode.json and opencode.jsonc
  // exist, this file wins (measured 2026-09-12).
  "$schema": "https://opencode.ai/config.json",

  // Never auto-publish session shares.
  "share": "disabled",
  "autoupdate": "notify",

  // Models, providers and agents come from .chezmoidata/opencode.yaml:
  // common, then os.<os>, then hosts.<hostname>, deep-merged. Edit that file,
  // not this block. The default runs hosted; the small model (titles,
  // summaries, compaction) stays local so trivial calls never leave the box.
  // The `deep` agent opens on Opus 5 at max reasoning effort.
{{- $oc := .opencode }}
{{- $cfg := deepCopy $oc.common }}
{{- $cfg = mergeOverwrite $cfg (deepCopy (get $oc.os .chezmoi.os | default dict)) }}
{{- $cfg = mergeOverwrite $cfg (deepCopy (get $oc.hosts .chezmoi.hostname | default dict)) }}
{{- range $key := keys $cfg | sortAlpha }}
  {{ toJson $key }}: {{ get $cfg $key | toPrettyJson | trim | replace "\n" "\n  " }},
{{- end }}

  // Baseline safety: reads are free, git is allowed, everything else asks.
  // Tokens live in auth.json, never here.
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "allow",
    // Read-only inspection and text transforms are free. The catch-all comes
    // FIRST because opencode evaluates the LAST matching rule: a trailing
    // `"*": "ask"` shadows every allow above it. That is exactly what this
    // block did until 2026-09-16, so `git`, `find`, `wc`, `echo` and the rest
    // were declared but never in force. The find carve-outs sit after
    // `find *` for the same reason. Deliberately NOT allowed
    // (docs/PERMISSIONS.md tiers): xargs (executes piped input that the
    // external_directory scan cannot see) and gita's mutating subcommands
    // (mass pull/push/checkout across every repo is the ask tier's job).
    "bash": {
      // Catch-all FIRST. opencode takes the last matching rule, so a catch-all
      // placed last shadows every allow and deny in front of it (measured: the
      // external_directory block below is deny-first/allow-last and works;
      // this map was the reverse and never got a clean restart to show it).
      "*": "ask",
      "git *": "allow",
      // `mise *` reaches arbitrary execution through `mise exec`/`mise run`,
      // so this is a wide allow. Kept because mise is the machine's tool
      // front-end; the repo config keeps `mise install`/`mise run setup` at
      // ask, and edit that pairing together if this widens further.
      "mise *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "wc *": "allow",
      "sort *": "allow",
      "comm *": "allow",
      "uniq *": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "grep *": "allow",
      "gita ls*": "allow",
      "gita status*": "allow",
      "find *": "allow",
      "find *-delete*": "deny",
      "find *-exec*": "deny",
      "find *-execdir*": "deny",
      "*": "ask"
    },
    "webfetch": "ask",
    "websearch": "ask",
    // external_directory evaluates the LAST matching rule, so the deny is
    // FIRST and the specific allows LAST — broad-first, narrow-last. The
    // original order (allows then deny) defeated ~/code/** and was caught
    // live on 2026-09-12 when a write to ai-prompt-library was refused.
    //
    // The home directory is templated, not written out. These were literal
    // /home/bdavis paths until 2026-09-14, which meant both allows silently
    // never matched on any machine whose home was elsewhere — macOS included,
    // where the deny was therefore the only rule in force. A path rule that
    // cannot match fails open into "deny everything" and reports nothing, so
    // the wrong value looks exactly like a working config.
    "external_directory": {
      "*": "deny",
      "{{ .chezmoi.homeDir }}/.local/share/chezmoi/**": "allow",
      "{{ .chezmoi.homeDir }}/code/**": "allow"
    }
  }
}
