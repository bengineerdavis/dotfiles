# ~/.config/herdr/config.toml — captured minimally by the herdr topic
# (dotfiles/apps/herdr). Only settings with an opinion are here; everything
# else stays default. `herdr --default-config` prints the full commented set
# (208 keys at 0.9.1) when another opinion forms.

# The stable channel. (Homebrew, mise and nix installs ignore the preview
# channel regardless — this pins the intent for direct-install fallbacks too.)
update.channel = "stable"

[session]
# Resume supported agent panes into their native sessions when a herdr
# session restores — the whole point of the integrations this topic wires.
resume_agents_on_restore = true
